# ==============================================================================
# InstaFlow Multi-Project Production Environment Variables
# ==============================================================================
# Configure these variables in your Vercel Dashboard (Project Settings -> Environment Variables).
# Variables are organized by project name to avoid any collisions during deployment.
# ==============================================================================

# ==============================================================================
# 1. InstaFlow (Core Admin & Instagram Automation)
# ==============================================================================
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.c-6.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[endpoint].c-6.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH="production"
NEON_AUTH_BASE_URL="https://[endpoint].neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://[endpoint].neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Object Storage (Neon / S3)
AWS_ACCESS_KEY_ID="nak_live_your_access_key"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_key"
AWS_ENDPOINT_URL_S3="https://[bucket-endpoint].storage.c-6.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"

# Security & Admin Access
ADMIN_AUTH_SECRET="your_strong_admin_auth_secret_here"
ADMIN_PASSWORD="your_admin_password_here"
ALLOWED_ADMIN_EMAIL="lifeunderzero777@gmail.com"
ASTRO_TELEMETRY_DISABLED=1

# Meta Instagram Graph API
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"
META_REDIRECT_URI="https://instaflow-weld.vercel.app/api/auth/instagram/callback"
META_API_VERSION="v19.0"
INSTAGRAM_ENCRYPTION_KEY="your_32_byte_hex_encryption_key"

# ==============================================================================
# 2. SendVirtualGift (sendvirtualgift.com Production)
# ==============================================================================
SENDVIRTUALGIFT_DATABASE_URL="postgresql://neondb_owner:[password]@[endpoint]-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
SENDVIRTUALGIFT_NEON_DATABASE_URL="postgresql://neondb_owner:[password]@[endpoint]-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_DATABASE_URL="postgresql://neondb_owner:[password]@[endpoint]-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# InsForge BaaS Client
PUBLIC_SENDVIRTUALGIFT_INSFORGE_URL="https://[subdomain].us-east.insforge.app"
PUBLIC_SENDVIRTUALGIFT_INSFORGE_ANON_KEY="anon_[your_insforge_anon_key]"
PUBLIC_INSFORGE_URL="https://[subdomain].us-east.insforge.app"
PUBLIC_INSFORGE_ANON_KEY="anon_[your_insforge_anon_key]"

# Clerk Authentication (SendVirtualGift Instance)
SENDVIRTUALGIFT_CLERK_PUBLISHABLE_KEY="pk_live_your_sendvirtualgift_publishable_key"
SENDVIRTUALGIFT_CLERK_SECRET_KEY="sk_live_your_sendvirtualgift_secret_key"
PUBLIC_SENDVIRTUALGIFT_CLERK_PUBLISHABLE_KEY="pk_live_your_sendvirtualgift_publishable_key"
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_sendvirtualgift_publishable_key"
CLERK_SECRET_KEY="sk_live_your_sendvirtualgift_secret_key"

# Payment Gateways (Razorpay)
SENDVIRTUALGIFT_RAZORPAY_KEY_ID="rzp_live_your_key_id"
SENDVIRTUALGIFT_RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
SENDVIRTUALGIFT_RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
PUBLIC_SENDVIRTUALGIFT_RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_ID="rzp_live_your_key_id"
PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Media Storage (Cloudinary)
SENDVIRTUALGIFT_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
SENDVIRTUALGIFT_CLOUDINARY_API_KEY="your_cloudinary_api_key"
SENDVIRTUALGIFT_CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Domain & Security
PUBLIC_SENDVIRTUALGIFT_SITE_URL="https://sendvirtualgift.com"
PUBLIC_SITE_URL="https://sendvirtualgift.com"
PUBLIC_SENDVIRTUALGIFT_SUPPORT_EMAIL="support@sendvirtualgift.com"
SENDVIRTUALGIFT_ADMIN_EMAILS="lifeunderzero777@gmail.com,admin@sendvirtualgift.com"

# Bot Protection & Rate Limits
PUBLIC_SENDVIRTUALGIFT_TURNSTILE_SITE_KEY="0x4AAAAAA..."
SENDVIRTUALGIFT_TURNSTILE_SECRET_KEY="0x4AAAAAA..."
PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."
MAX_CARDS_PER_USER=5
MAX_IMAGES_PER_USER=5
ENABLE_RATE_LIMITING=true
ENABLE_SECURITY_LOGGING=true
PUBLIC_CARD_ROUTE_PREFIX="/s"

# ==============================================================================
# 3. ClickForNothing (clickfornothing.com Production)
# ==============================================================================
CLICKFORNOTHING_DATABASE_URL="postgresql://neondb_owner:[password]@[endpoint]-pooler.c-6.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
CLICKFORNOTHING_DATABASE_URL_UNPOOLED="postgresql://neondb_owner:[password]@[endpoint].c-6.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
CLICKFORNOTHING_BRANCH="main"

# Clerk Authentication (ClickForNothing Instance)
CLICKFORNOTHING_CLERK_PUBLISHABLE_KEY="pk_live_your_clickfornothing_clerk_publishable_key"
CLICKFORNOTHING_CLERK_SECRET_KEY="sk_live_your_clickfornothing_clerk_secret_key"
PUBLIC_CLICKFORNOTHING_CLERK_PUBLISHABLE_KEY="pk_live_your_clickfornothing_clerk_publishable_key"

# Media Storage (Cloudinary)
CLICKFORNOTHING_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLICKFORNOTHING_CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLICKFORNOTHING_CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Production Domain & Admin
PUBLIC_CLICKFORNOTHING_SITE_URL="https://clickfornothing.com"
CLICKFORNOTHING_ADMIN_EMAIL="lifeunderzero777@gmail.com"
CLICKFORNOTHING_ADMIN_EMAILS="lifeunderzero777@gmail.com"
CLICKFORNOTHING_RATE_LIMIT=100
CLICKFORNOTHING_RATE_WINDOW_SECONDS=60
ENABLE_CLICKFORNOTHING_REALTIME_SYNC=true
