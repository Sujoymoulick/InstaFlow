# ==============================================================================
# InstaFlow Environment Variables Configuration
# ==============================================================================
# Configure these variables in your local .env file for development and in
# the Vercel Dashboard (Project Settings -> Environment Variables) for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Direct or pooled connection string from Neon Console (https://console.neon.tech)
# Vercel Configuration: Set in Production, Preview, and Development.
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-project.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Meta for Developers & Instagram Graph API
# ------------------------------------------------------------------------------
# Obtain from https://developers.facebook.com -> Your App -> App Settings -> Basic
# App Type must be "Business".
# Vercel Configuration: Set in Production and Preview environments.
META_APP_ID="your_meta_app_id_here"
META_APP_SECRET="your_meta_app_secret_here"
# If your Instagram Login setup uses a separate Instagram app ID/secret, set these instead.
# META_IG_APP_ID="your_instagram_app_id_here"
# META_IG_APP_SECRET="your_instagram_app_secret_here"

# Webhook verification token that you define.
# Must match the token entered in Meta App Dashboard -> Webhooks -> Instagram -> Verify Token.
META_WEBHOOK_VERIFY_TOKEN="your_custom_random_verification_token_here"

# Protects the Vercel cron that drains the durable webhook queue.
CRON_SECRET="replace_with_at_least_32_random_characters"

# Full OAuth callback URL.
# In local dev: http://localhost:2121/api/auth/instagram/callback
# In Vercel production: https://instaflow-weld.vercel.app/api/auth/instagram/callback
# (Also add this exact URL to Meta App Dashboard -> Facebook Login for Business -> Valid OAuth Redirect URIs)
META_REDIRECT_URI="https://instaflow-weld.vercel.app/api/auth/instagram/callback"

# Meta Graph API Version (defaults to v26.0 if omitted)
META_API_VERSION="v26.0"

# ------------------------------------------------------------------------------
# 3. Security & Cryptography
# ------------------------------------------------------------------------------
# 32-byte secret key used to symmetrically encrypt Instagram access tokens at rest via AES-256-GCM.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel Configuration: Set in Production and Preview. KEEP STRICTLY PRIVATE.
INSTAGRAM_ENCRYPTION_KEY="replace_with_a_secure_random_32_byte_hex_string"

# Admin secret protecting dashboard management actions and sensitive API endpoints.
# In production, set a strong secret string.
ADMIN_AUTH_SECRET="replace_with_strong_admin_secret"

# Authorized Admin Email: Only this email is permitted to sign in to the InstaFlow portal.
ALLOWED_ADMIN_EMAIL="lifeunderzero777@gmail.com"

# Optional explicit admin password (if not set, ADMIN_AUTH_SECRET is checked)
ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# 4. Optional Astro Configuration
# ------------------------------------------------------------------------------
ASTRO_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# 5. Clerk Production Authentication Monitoring (Production Mode)
# ------------------------------------------------------------------------------
# In Clerk Dashboard (https://dashboard.clerk.com), select your project and switch
# the toggle from "Development" to "Production" in the top bar.
# Navigate to: Configure -> API Keys and copy the live publishable and secret keys.
# Vercel Configuration: Set in Production and Preview environments.
CLERK_PROJECT_NAME="SEND VIRTUAL GIFT (Production)"
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_production_publishable_key_here"
CLERK_SECRET_KEY="sk_live_your_production_secret_key_here"
CLERK_INSTANCE_URL="https://clerk.yourdomain.com"

