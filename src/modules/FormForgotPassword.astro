---
import { asset, url } from '../lib/data.js';
import { ALLOWED_ADMIN_EMAIL } from '../lib/auth.js';

interface Props {
	errorMessage?: string;
	successMessage?: string;
	emailValue?: string;
}

const { errorMessage = '', successMessage = '', emailValue = '' } = Astro.props;
const displayEmail = emailValue || ALLOWED_ADMIN_EMAIL;
---

<div
	class="w-full flex flex-col items-center justify-center px-6 pt-8 mx-auto pt:mt-0 dark:bg-gray-900"
>
	<a
		href="/"
		class="flex items-center justify-center mb-6 text-2xl font-semibold lg:mb-8 dark:text-white"
	>
		<img src="/logo.png" alt="InstaFlow Logo" class="h-10 w-10 mr-3 object-contain" />
		<span class="self-center text-2xl font-bold whitespace-nowrap dark:text-white">InstaFlow</span>
	</a>
	<!-- Card -->
	<div
		class="w-full bg-white rounded-xl shadow-lg border border-gray-100 dark:border-gray-700 md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800"
	>
		<div class="w-full p-6 sm:p-8">
			<h2 class="mb-3 text-2xl font-bold text-gray-900 dark:text-white">
				Forgot your password?
			</h2>
			<p class="text-base font-normal text-gray-500 dark:text-gray-400">
				Enter your registered admin email address below to receive password recovery instructions.
			</p>

			{errorMessage && (
				<div
					class="mt-4 flex items-start p-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-700/60 dark:text-red-400 border border-red-200 dark:border-red-800"
					role="alert"
				>
					<svg
						class="flex-shrink-0 inline w-5 h-5 mr-3 mt-0.5"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
						fill="currentColor"
						viewBox="0 0 20 20"
					>
						<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
					</svg>
					<div>
						<span class="font-semibold block">Access Denied</span>
						<span>{errorMessage}</span>
					</div>
				</div>
			)}

			{successMessage && (
				<div
					class="mt-4 flex items-center p-4 text-sm text-green-800 rounded-lg bg-green-50 dark:bg-gray-700/60 dark:text-green-400 border border-green-200 dark:border-green-800"
					role="alert"
				>
					<svg
						class="flex-shrink-0 inline w-5 h-5 mr-3"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
						fill="currentColor"
						viewBox="0 0 20 20"
					>
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
					</svg>
					<div>
						<span>{successMessage}</span>
					</div>
				</div>
			)}

			<form class="mt-6 space-y-6" method="POST" action="/authentication/forgot-password">
				<div>
					<label
						for="email"
						class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
						>Your email</label
					>
					<input
						type="email"
						name="email"
						id="email"
						value={displayEmail}
						class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
						placeholder={ALLOWED_ADMIN_EMAIL}
						required
					/>
					<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
						Restricted to: <strong class="text-primary-600 dark:text-primary-400">{ALLOWED_ADMIN_EMAIL}</strong>
					</p>
				</div>
				<button
					type="submit"
					class="w-full px-5 py-3 text-base font-medium text-center text-white rounded-lg bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800 transition-colors"
					>Send Reset Link</button
				>
				<div class="text-sm font-medium text-gray-500 dark:text-gray-400 text-center">
					Remember your password? <a
						href="/authentication/sign-in"
						class="text-primary-700 hover:underline dark:text-primary-500"
						>Sign in here</a
					>
				</div>
			</form>
		</div>
	</div>
</div>
