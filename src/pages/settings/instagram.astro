---
import LayoutSidebar from '../../app/LayoutSidebar.astro';
import { getActiveInstagramAccount, INSTAGRAM_OAUTH_SCOPES } from '../../services/instagram.js';
import { url } from '../../lib/data.js';

export const prerender = false;

const account = await getActiveInstagramAccount();
const metaAppId = process.env.META_APP_ID;
const metaAppSecret = process.env.META_APP_SECRET;
const isMetaConfigured = Boolean(metaAppId && metaAppSecret);

const statusParam = Astro.url.searchParams.get('status');
const messageParam = Astro.url.searchParams.get('message');

let daysUntilExpiry: number | null = null;
if (account && account.tokenExpiresAt) {
	const diff = new Date(account.tokenExpiresAt).getTime() - Date.now();
	daysUntilExpiry = Math.max(0, Math.floor(diff / (1000 * 60 * 60 * 24)));
}

const webhookUrl = `${Astro.url.origin}/api/webhooks/instagram`;
const verifyToken = process.env.META_WEBHOOK_VERIFY_TOKEN || 'instaflow_verify_token_change_in_production';
---

<LayoutSidebar>
	<div class="px-4 pt-6">
		<!-- Breadcrumbs -->
		<nav class="flex mb-4" aria-label="Breadcrumb">
			<ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
				<li class="inline-flex items-center">
					<a
						href={url()}
						class="inline-flex items-center text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-white"
					>
						<svg
							class="w-5 h-5 mr-2.5"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
							></path></svg
						>
						Home
					</a>
				</li>
				<li>
					<div class="flex items-center">
						<svg
							class="w-6 h-6 text-gray-400"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
								clip-rule="evenodd"></path></svg
						>
						<a
							href={url('settings')}
							class="ml-1 text-gray-700 hover:text-primary-600 md:ml-2 dark:text-gray-300 dark:hover:text-white"
							>Settings</a
						>
					</div>
				</li>
				<li>
					<div class="flex items-center">
						<svg
							class="w-6 h-6 text-gray-400"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
								clip-rule="evenodd"></path></svg
						>
						<span class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500" aria-current="page"
							>Instagram Connection</span
						>
					</div>
				</li>
			</ol>
		</nav>

		<div class="mb-6">
			<h1 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
				Instagram Account Integration
			</h1>
			<p class="text-sm font-normal text-gray-500 dark:text-gray-400">
				Connect your official Instagram Professional / Creator account via Meta OAuth.
			</p>
		</div>

		<!-- Callback Feedback Alerts -->
		{
			statusParam === 'success' && (
				<div
					class="p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400 border border-green-200 dark:border-green-800"
					role="alert"
				>
					<span class="font-medium">Success:</span> {messageParam || 'Instagram account connected successfully!'}
				</div>
			)
		}
		{
			statusParam === 'error' && (
				<div
					class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400 border border-red-200 dark:border-red-800"
					role="alert"
				>
					<span class="font-medium">Connection Error:</span> {messageParam || 'Failed to authenticate with Meta.'}
				</div>
			)
		}

		<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
			<!-- Connection Status Card (2/3) -->
			<div class="xl:col-span-2 space-y-6">
				<div
					class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6"
				>
					<div class="flex items-center justify-between border-b pb-4 mb-4 dark:border-gray-700">
						<div>
							<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
								Meta Account Status
							</h3>
							<p class="text-xs text-gray-500 dark:text-gray-400">
								Current OAuth link and Instagram Messaging API authorization.
							</p>
						</div>
						<div>
							{
								account ? (
									<span class="bg-green-100 text-green-800 text-xs font-medium px-3 py-1 rounded-full dark:bg-green-900 dark:text-green-300 inline-flex items-center">
										<span class="w-2 h-2 mr-1.5 bg-green-500 rounded-full animate-pulse"></span>
										Connected
									</span>
								) : (
									<span class="bg-gray-100 text-gray-800 text-xs font-medium px-3 py-1 rounded-full dark:bg-gray-700 dark:text-gray-300 inline-flex items-center">
										<span class="w-2 h-2 mr-1.5 bg-gray-400 rounded-full"></span>
										Not Connected
									</span>
								)
							}
						</div>
					</div>

					{
						account ? (
							<div class="space-y-4">
								<div class="flex items-center space-x-4 p-4 rounded-lg bg-gray-50 dark:bg-gray-700/50">
									<div class="w-16 h-16 rounded-full bg-gradient-to-tr from-yellow-400 via-pink-500 to-purple-600 p-0.5 flex-shrink-0">
										<div class="w-full h-full rounded-full bg-white dark:bg-gray-800 flex items-center justify-center font-bold text-gray-800 dark:text-white overflow-hidden">
											{account.profilePictureUrl ? (
												<img
													src={account.profilePictureUrl}
													alt={account.username}
													class="w-full h-full object-cover"
												/>
											) : (
												account.username.substring(0, 2).toUpperCase()
											)}
										</div>
									</div>
									<div class="flex-1">
										<h4 class="text-lg font-bold text-gray-900 dark:text-white">
											@{account.username}
										</h4>
										<p class="text-xs text-gray-500 dark:text-gray-400">
											Instagram Account ID: <code class="font-mono">{account.instagramUserId}</code>
										</p>
										{daysUntilExpiry !== null && (
											<p class="text-xs text-green-600 dark:text-green-400 mt-1">
												Access Token valid for ~{daysUntilExpiry} days (auto-refreshed via 60-day Meta token)
											</p>
										)}
									</div>
								</div>

								<!-- Permissions Granted -->
								<div>
									<h5 class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400 mb-2">
										Authorized Permissions
									</h5>
									<div class="flex flex-wrap gap-2">
										{INSTAGRAM_OAUTH_SCOPES.split(',').map((scope) => (
											<span class="bg-blue-50 text-primary-700 text-xs font-mono px-2.5 py-1 rounded dark:bg-blue-900/40 dark:text-primary-300">
												✓ {scope}
											</span>
										))}
									</div>
								</div>

								<!-- Security Notice -->
								<div class="p-3 bg-gray-50 dark:bg-gray-700/40 rounded-lg text-xs text-gray-600 dark:text-gray-300">
									<span class="font-semibold text-gray-900 dark:text-white">Encryption at rest:</span>
									Your Meta Page access tokens are symmetrically encrypted at rest using AES-256-GCM.
									Plaintext credentials are never saved to the database.
								</div>

								<!-- Action Buttons -->
								<div class="flex flex-wrap items-center gap-3 pt-2">
									<a
										href="/api/auth/instagram?provider=instagram"
										class="text-white bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 focus:ring-4 focus:ring-pink-300 font-medium rounded-lg text-xs px-4 py-2.5 dark:focus:ring-pink-900 shadow-sm inline-flex items-center"
									>
										<svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
											<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
										</svg>
										Reconnect via Instagram
									</a>
									<a
										href="/api/auth/instagram?provider=facebook"
										class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-xs px-4 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 shadow-sm inline-flex items-center"
									>
										<svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
											<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
										</svg>
										Reconnect via Facebook Page
									</a>
									<button
										type="button"
										id="disconnect-btn"
										data-account-id={account.id}
										class="text-red-600 hover:text-white border border-red-600 hover:bg-red-700 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-xs px-4 py-2.5 dark:border-red-500 dark:text-red-500 dark:hover:bg-red-600 dark:hover:text-white"
									>
										Disconnect Account
									</button>
								</div>
							</div>
						) : (
							<div class="space-y-4">
								<p class="text-sm text-gray-600 dark:text-gray-300">
									Connect your Instagram Business or Creator account to start receiving webhook events,
									listening to comment keywords, and dispatching automated replies.
								</p>

								{
									!isMetaConfigured ? (
										<div class="p-4 border-l-4 border-yellow-400 bg-yellow-50 dark:bg-gray-700 dark:border-yellow-500 text-xs text-yellow-800 dark:text-yellow-200">
											<p class="font-bold mb-1">Meta App Credentials Missing</p>
											Please add <code>META_APP_ID</code> and <code>META_APP_SECRET</code> to your
											environment variables (e.g. in <code>.env</code> locally or in Vercel project settings)
											before starting the OAuth flow.
										</div>
									) : (
										<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
											<a
												href="/api/auth/instagram?provider=instagram"
												class="inline-flex items-center justify-center text-white bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 focus:ring-4 focus:ring-pink-300 font-medium rounded-lg text-sm px-5 py-3 dark:focus:ring-pink-900 shadow-sm"
											>
												<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
													<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
												</svg>
												Connect with Instagram Direct
											</a>
											<a
												href="/api/auth/instagram?provider=facebook"
												class="inline-flex items-center justify-center text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-3 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 shadow-sm"
											>
												<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
													<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
												</svg>
												Connect via Facebook Page
											</a>
										</div>
									)
								}
							</div>
						)
					}
				</div>

				<!-- Meta Webhook Configuration Details -->
				<div
					class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6"
				>
					<h3 class="text-base font-semibold text-gray-900 dark:text-white mb-2">
						Meta Developer Webhook Setup
					</h3>
					<p class="text-xs text-gray-500 dark:text-gray-400 mb-4">
						Configure this in the Meta Developers App Dashboard under <strong>Webhooks &rarr; Instagram</strong>.
					</p>

					<div class="space-y-3 text-xs">
						<div>
							<label class="block font-medium text-gray-700 dark:text-gray-300 mb-1">
								Callback URL:
							</label>
							<div class="flex items-center space-x-2">
								<input
									type="text"
									readonly
									value={webhookUrl}
									class="bg-gray-50 border border-gray-300 text-gray-900 text-xs rounded-lg block w-full p-2.5 font-mono dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200"
								/>
							</div>
						</div>

						<div>
							<label class="block font-medium text-gray-700 dark:text-gray-300 mb-1">
								Verify Token (configured in META_WEBHOOK_VERIFY_TOKEN):
							</label>
							<input
								type="text"
								readonly
								value={verifyToken}
								class="bg-gray-50 border border-gray-300 text-gray-900 text-xs rounded-lg block w-full p-2.5 font-mono dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200"
							/>
						</div>

						<div>
							<label class="block font-medium text-gray-700 dark:text-gray-300 mb-1">
								Required Webhook Subscribed Fields:
							</label>
							<div class="flex flex-wrap gap-2 mt-1">
								<span class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded font-mono">comments</span>
								<span class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded font-mono">messages</span>
								<span class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded font-mono">messaging_postbacks</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Meta Setup Checklist Column (1/3) -->
			<div class="xl:col-span-1 space-y-4">
				<div
					class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800"
				>
					<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">
						Setup Checklist
					</h3>
					<ol class="space-y-3 text-xs text-gray-600 dark:text-gray-400 list-decimal list-inside">
						<li class="leading-relaxed">
							Switch your Instagram account to <strong>Professional (Creator or Business)</strong> in the Instagram app.
						</li>
						<li class="leading-relaxed">
							Link your Instagram account to a <strong>Facebook Page</strong>.
						</li>
						<li class="leading-relaxed">
							Create a <strong>Meta App</strong> (Type: Business) on <a href="https://developers.facebook.com" target="_blank" class="text-primary-600 hover:underline">developers.facebook.com</a>.
						</li>
						<li class="leading-relaxed">
							Add <strong>Instagram Graph API</strong> and <strong>Webhooks</strong> products.
						</li>
						<li class="leading-relaxed">
							Enable <em>Allow access to Messages</em> in Instagram Account Settings &rarr; Messages and Story Replies.
						</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
</LayoutSidebar>

<script>
	// Handle client-side hash fragment redirects if any OAuth provider returns params in URL hash
	if (window.location.hash && (window.location.hash.includes('code=') || window.location.hash.includes('error='))) {
		const hashParams = window.location.hash.substring(1).replace(/^_/, '');
		if (hashParams) {
			window.location.href = `/api/auth/instagram/callback?${hashParams}`;
		}
	}

	const disconnectBtn = document.getElementById('disconnect-btn');
	if (disconnectBtn) {
		disconnectBtn.addEventListener('click', async () => {
			const accountId = disconnectBtn.getAttribute('data-account-id');
			if (!confirm('Are you sure you want to disconnect this Instagram account? Auto-DMs will pause.')) {
				return;
			}

			try {
				const res = await fetch('/api/auth/instagram/disconnect', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ accountId }),
				});

				if (res.ok) {
					window.location.reload();
				} else {
					const data = await res.json();
					alert(data.error || 'Failed to disconnect account');
				}
			} catch (e: any) {
				alert(e.message || 'Network error');
			}
		});
	}
</script>
