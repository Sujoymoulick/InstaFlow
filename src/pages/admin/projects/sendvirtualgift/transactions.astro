---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { listSvgTransactions } from '../../../../projects/sendvirtualgift/services/transactions.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const search = Astro.url.searchParams.get('q') || '';
const page = Number(Astro.url.searchParams.get('page')) || 1;

const result = await listSvgTransactions({
	page,
	limit: 20,
	search,
});
---

<LayoutSidebar title="SendVirtualGift Transactions | InstaFlow Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			activeTab="transactions"
			title="Transaction Ledger & Entitlements"
			subtitle="Full audit trail of purchase records, entitlement grants, and webhook events stored in Neon PostgreSQL."
		/>

		<!-- Quick Overview -->
		<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-3">
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Total Transaction Records</span>
				<h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1">
					{result.total}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Neon rose_orders entries</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Entitlement Model</span>
				<h3 class="text-2xl font-bold text-indigo-600 dark:text-indigo-400 mt-1">
					Lifetime Template Unlock
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Linked to buyer Clerk User ID / Token</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Verification Integrity</span>
				<h3 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">
					100% HMAC-SHA256
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Cryptographic Razorpay signature</p>
			</div>
		</div>

		<!-- Transactions Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden dark:bg-gray-800 dark:border-gray-700">
			<div class="overflow-x-auto">
				<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
					<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
						<tr>
							<th class="px-5 py-3.5">Transaction ID</th>
							<th class="px-4 py-3.5">Product</th>
							<th class="px-4 py-3.5">User Reference</th>
							<th class="px-4 py-3.5">Amount</th>
							<th class="px-4 py-3.5">Entitlement</th>
							<th class="px-4 py-3.5">Delivery Status</th>
							<th class="px-4 py-3.5">Timestamp</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							result.transactions.length === 0 ? (
								<tr>
									<td colspan="7" class="px-6 py-12 text-center text-gray-500">
										No transactions recorded in the database.
									</td>
								</tr>
							) : (
								result.transactions.map((tx) => (
									<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
										<td class="px-5 py-4 font-mono text-xs font-semibold text-gray-900 dark:text-white">
											{tx.order.id}
										</td>
										<td class="px-4 py-4 text-xs font-medium text-gray-800 dark:text-gray-200">
											{tx.order.product_slug}
										</td>
										<td class="px-4 py-4 font-mono text-xs text-gray-500">
											{tx.order.user_id}
										</td>
										<td class="px-4 py-4 font-bold text-gray-900 dark:text-white">
											₹{(tx.order.amount / 100).toFixed(2)}
										</td>
										<td class="px-4 py-4">
											<span
												class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${
													tx.entitlement?.entitlement_status === 'active'
														? 'bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300'
														: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300'
												}`}
											>
												{tx.entitlement ? tx.entitlement.entitlement_status : 'Pending / None'}
											</span>
										</td>
										<td class="px-4 py-4">
											<span
												class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold ${
													tx.deliveryStatus === 'Delivered'
														? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300'
														: 'bg-yellow-50 text-yellow-700 dark:bg-yellow-950 dark:text-yellow-300'
												}`}
											>
												{tx.deliveryStatus}
											</span>
										</td>
										<td class="px-4 py-4 text-xs text-gray-400">
											{new Date(tx.order.created_at).toLocaleDateString()} {new Date(tx.order.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
										</td>
									</tr>
								))
							)
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</LayoutSidebar>
