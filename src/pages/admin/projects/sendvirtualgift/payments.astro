---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { listSvgPayments } from '../../../../projects/sendvirtualgift/services/payments.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const search = Astro.url.searchParams.get('q') || '';
const page = Number(Astro.url.searchParams.get('page')) || 1;

const paymentData = await listSvgPayments({
	page,
	limit: 20,
	search,
});
---

<LayoutSidebar title="SendVirtualGift Payments | InstaFlow Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			activeTab="payments"
			title="Payment Processing & Razorpay Gateway"
			subtitle="Authoritative transaction records from Neon PostgreSQL and live Razorpay payment settlements."
		/>

		<!-- 4 Payment KPI Cards -->
		<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-2 lg:grid-cols-4">
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Total Settled Revenue</span>
				<h3 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">
					₹{paymentData.stats.totalRevenueRupees}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">From captured Neon orders</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Captured Payments</span>
				<h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1">
					{paymentData.stats.capturedCount}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Successfully fulfilled</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Pending Checkout</span>
				<h3 class="text-2xl font-bold text-yellow-600 dark:text-yellow-400 mt-1">
					{paymentData.stats.pendingCount}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Initiated / awaiting buyer approval</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Gateway Provider</span>
				<h3 class="text-2xl font-bold text-blue-600 dark:text-blue-400 mt-1">
					Razorpay
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Direct server cryptographic verification</p>
			</div>
		</div>

		<!-- Search -->
		<div class="p-4 mb-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
			<form method="GET" class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="relative w-full sm:w-80">
					<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
						<svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<input
						type="text"
						name="q"
						value={search}
						placeholder="Search by order ID, receipt #, payment ID..."
						class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full pl-9 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
					/>
				</div>

				<div class="flex items-center space-x-3">
					<button
						type="submit"
						class="px-4 py-2.5 text-sm font-medium text-white bg-primary-700 rounded-lg hover:bg-primary-800"
					>
						Search Payments
					</button>

					{
						search && (
							<a
								href={url('admin/projects/sendvirtualgift/payments')}
								class="px-3 py-2.5 text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300"
							>
								Clear
							</a>
						)
					}
				</div>
			</form>
		</div>

		<!-- Payments Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden dark:bg-gray-800 dark:border-gray-700">
			<div class="overflow-x-auto">
				<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
					<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
						<tr>
							<th class="px-5 py-3.5">Order / Receipt #</th>
							<th class="px-4 py-3.5">Payment ID</th>
							<th class="px-4 py-3.5">Template</th>
							<th class="px-4 py-3.5">Amount</th>
							<th class="px-4 py-3.5">Order Status</th>
							<th class="px-4 py-3.5">Payment Status</th>
							<th class="px-4 py-3.5">Created At</th>
							<th class="px-4 py-3.5 text-right">Invoice</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							paymentData.orders.length === 0 ? (
								<tr>
									<td colspan="8" class="px-6 py-12 text-center text-gray-500">
										No payments found matching your query.
									</td>
								</tr>
							) : (
								paymentData.orders.map((ord) => {
									const isPaid = ord.order_status === 'paid' || ord.payment_status === 'captured';
									return (
										<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
											<td class="px-5 py-4">
												<div class="font-mono text-xs font-semibold text-gray-900 dark:text-white">
													{ord.receipt_number || ord.id}
												</div>
												<div class="font-mono text-[10px] text-gray-400">
													{ord.gateway_order_id || ord.id}
												</div>
											</td>
											<td class="px-4 py-4 font-mono text-xs text-gray-600 dark:text-gray-300">
												{ord.gateway_payment_id || '—'}
											</td>
											<td class="px-4 py-4 text-xs font-medium text-gray-800 dark:text-gray-200">
												3D Forever Rose 🌹
											</td>
											<td class="px-4 py-4 font-bold text-gray-900 dark:text-white">
												₹{(ord.amount / 100).toFixed(2)}
											</td>
											<td class="px-4 py-4">
												<span
													class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${
														isPaid
															? 'bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300'
															: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-950 dark:text-yellow-300'
													}`}
												>
													{ord.order_status}
												</span>
											</td>
											<td class="px-4 py-4">
												<span
													class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${
														ord.payment_status === 'captured'
															? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
															: ord.payment_status === 'failed'
															? 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300'
															: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300'
													}`}
												>
													{ord.payment_status}
												</span>
											</td>
											<td class="px-4 py-4 text-xs text-gray-400">
												{new Date(ord.created_at).toLocaleDateString()} {new Date(ord.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
											</td>
											<td class="px-4 py-4 text-right">
												{isPaid ? (
													<a
														href={url(`admin/projects/sendvirtualgift/invoices?q=${ord.receipt_number || ord.id}`)}
														class="text-xs font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 hover:underline"
													>
														View Invoice
													</a>
												) : (
													<span class="text-xs text-gray-400">—</span>
												)}
											</td>
										</tr>
									);
								})
							)
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</LayoutSidebar>
