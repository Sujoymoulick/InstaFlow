---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { getSvgSettings } from '../../../../projects/sendvirtualgift/services/settings.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const settings = getSvgSettings();
---

<LayoutSidebar title="SendVirtualGift Settings | InstaFlow Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			activeTab="settings"
			title="Project Configuration & Feature Flags"
			subtitle="Configure application metadata, domain endpoints, emergency maintenance mode, and feature toggle switches."
		/>

		<!-- Settings Grid -->
		<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
			<!-- General Project Information -->
			<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<h3 class="text-base font-bold text-gray-900 dark:text-white mb-4">
					Project Deployment Metadata
				</h3>
				<div class="space-y-4 text-xs">
					<div>
						<label class="block font-semibold text-gray-700 dark:text-gray-300 mb-1">Project Identifier</label>
						<input
							type="text"
							readonly
							value={settings.projectId}
							class="bg-gray-100 border border-gray-300 text-gray-900 text-xs rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-300 cursor-not-allowed font-mono"
						/>
					</div>

					<div>
						<label class="block font-semibold text-gray-700 dark:text-gray-300 mb-1">Production Domain</label>
						<input
							type="text"
							readonly
							value={settings.productionDomain}
							class="bg-gray-100 border border-gray-300 text-gray-900 text-xs rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-300 cursor-not-allowed"
						/>
					</div>

					<div>
						<label class="block font-semibold text-gray-700 dark:text-gray-300 mb-1">Project Tier</label>
						<input
							type="text"
							readonly
							value={settings.tier}
							class="bg-gray-100 border border-gray-300 text-gray-900 text-xs rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-300 cursor-not-allowed"
						/>
					</div>

					<div>
						<label class="block font-semibold text-gray-700 dark:text-gray-300 mb-1">Support Email</label>
						<input
							type="email"
							value={settings.supportEmail}
							class="bg-gray-50 border border-gray-300 text-gray-900 text-xs rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
						/>
					</div>
				</div>
			</div>

			<!-- Feature Flags & Controls -->
			<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<h3 class="text-base font-bold text-gray-900 dark:text-white mb-4">
					Feature Flags & Capability Toggles
				</h3>
				<div class="space-y-4">
					<div class="flex items-center justify-between p-3 rounded-lg bg-gray-50 dark:bg-gray-700/50">
						<div>
							<div class="text-xs font-semibold text-gray-900 dark:text-white">Paid 3D Forever Rose Template (₹99)</div>
							<div class="text-[11px] text-gray-500 dark:text-gray-400">Enables Razorpay checkout for paid rose templates</div>
						</div>
						<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300">
							ENABLED
						</span>
					</div>

					<div class="flex items-center justify-between p-3 rounded-lg bg-gray-50 dark:bg-gray-700/50">
						<div>
							<div class="text-xs font-semibold text-gray-900 dark:text-white">Cloudflare Turnstile Bot Check</div>
							<div class="text-[11px] text-gray-500 dark:text-gray-400">Protects card creation endpoints from automated spam</div>
						</div>
						<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300">
							ENABLED
						</span>
					</div>

					<div class="flex items-center justify-between p-3 rounded-lg bg-gray-50 dark:bg-gray-700/50">
						<div>
							<div class="text-xs font-semibold text-gray-900 dark:text-white">Cloudinary Image Uploads</div>
							<div class="text-[11px] text-gray-500 dark:text-gray-400">Allows users to upload custom photos into 3D templates</div>
						</div>
						<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300">
							ENABLED
						</span>
					</div>

					<div class="flex items-center justify-between p-3 rounded-lg bg-gray-50 dark:bg-gray-700/50">
						<div>
							<div class="text-xs font-semibold text-gray-900 dark:text-white">Anonymous No-Signup Card Creation</div>
							<div class="text-[11px] text-gray-500 dark:text-gray-400">Permits guest users to generate free gift cards</div>
						</div>
						<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300">
							ENABLED
						</span>
					</div>

					<div class="flex items-center justify-between p-3 rounded-lg bg-gray-50 dark:bg-gray-700/50">
						<div>
							<div class="text-xs font-semibold text-gray-900 dark:text-white">Realtime Interaction Stream</div>
							<div class="text-[11px] text-gray-500 dark:text-gray-400">Live card view notifications & like clicks sync</div>
						</div>
						<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300">
							ENABLED
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</LayoutSidebar>
