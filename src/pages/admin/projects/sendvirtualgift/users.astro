---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { listSvgAdminUsers } from '../../../../projects/sendvirtualgift/services/users.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const search = Astro.url.searchParams.get('q') || '';
const status = Astro.url.searchParams.get('status') || 'all';
const page = Number(Astro.url.searchParams.get('page')) || 1;

const usersData = await listSvgAdminUsers({
	page,
	limit: 20,
	search,
	status,
});

const maxDailyCount = Math.max(
	1,
	...usersData.dailyActivity.map((d) => Math.max(d.signups, d.signIns))
);
---

<LayoutSidebar title="SendVirtualGift Users | InstaFlow Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			activeTab="users"
			title="User Management & Identity Hub"
			subtitle="Clerk authoritative user accounts mapped with InsForge activity metrics and Neon order history."
		/>

		<!-- Quick Metric Cards -->
		<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-2 lg:grid-cols-4">
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Total Registered Users</span>
				<h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1">
					{usersData.summary.totalClerkUsers}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Authoritative Clerk identity records</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Active Accounts</span>
				<h3 class="text-2xl font-bold text-green-600 dark:text-green-400 mt-1">
					{usersData.summary.activeUsers}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Standard active authentication state</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Sign-Ups (Last 7 Days)</span>
				<h3 class="text-2xl font-bold text-primary-600 dark:text-primary-400 mt-1">
					{usersData.summary.signupsThisWeek}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">New accounts created this week</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">InsForge User Profiles</span>
				<h3 class="text-2xl font-bold text-blue-600 dark:text-blue-400 mt-1">
					{usersData.summary.totalInsforgeProfiles}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Synced relational database rows</p>
			</div>
		</div>

		<!-- Daily Sign-Ups & Sign-Ins Activity Graph -->
		<div class="p-6 mb-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 mb-4 border-b border-gray-100 dark:border-gray-700">
				<div>
					<h3 class="text-base font-bold text-gray-900 dark:text-white">Daily Sign-Ups & Sign-Ins Timeline</h3>
					<p class="text-xs text-gray-500 dark:text-gray-400">Real-time daily user registration count and sign-in volume over the last 14 days.</p>
				</div>
				<div class="flex items-center space-x-4 mt-2 sm:mt-0 text-xs">
					<div class="flex items-center space-x-1.5">
						<span class="w-3 h-3 rounded-sm bg-primary-600"></span>
						<span class="text-gray-600 dark:text-gray-300 font-medium">New Sign-Ups</span>
					</div>
					<div class="flex items-center space-x-1.5">
						<span class="w-3 h-3 rounded-sm bg-emerald-500"></span>
						<span class="text-gray-600 dark:text-gray-300 font-medium">Daily Sign-Ins</span>
					</div>
				</div>
			</div>

			<!-- Daily Activity Chart Bars -->
			<div class="h-44 w-full flex items-end justify-between space-x-2 pt-4 px-2">
				{
					usersData.dailyActivity.map((day) => {
						const signupHeightPct = Math.round((day.signups / maxDailyCount) * 100);
						const signinHeightPct = Math.round((day.signIns / maxDailyCount) * 100);

						return (
							<div class="flex-1 flex flex-col items-center justify-end h-full group relative">
								<!-- Tooltip on hover -->
								<div class="absolute -top-12 z-20 hidden group-hover:flex flex-col items-center bg-gray-900 text-white text-[10px] py-1 px-2.5 rounded shadow-lg whitespace-nowrap">
									<span class="font-bold">{day.date}</span>
									<span>Sign-ups: {day.signups} | Sign-ins: {day.signIns}</span>
									<div class="w-2 h-2 bg-gray-900 rotate-45 -mb-1"></div>
								</div>

								<!-- Dual Bars Container -->
								<div class="w-full flex items-end justify-center space-x-1 h-32">
									<!-- Signups Bar -->
									<div
										style={`height: ${Math.max(6, signupHeightPct)}%`}
										class={`w-2.5 sm:w-3.5 rounded-t transition-all ${
											day.signups > 0
												? 'bg-primary-600 hover:bg-primary-500'
												: 'bg-gray-100 dark:bg-gray-700/60'
										}`}
									></div>

									<!-- SignIns Bar -->
									<div
										style={`height: ${Math.max(6, signinHeightPct)}%`}
										class={`w-2.5 sm:w-3.5 rounded-t transition-all ${
											day.signIns > 0
												? 'bg-emerald-500 hover:bg-emerald-400'
												: 'bg-gray-100 dark:bg-gray-700/60'
										}`}
									></div>
								</div>

								<!-- Date Label -->
								<span class="text-[10px] text-gray-500 dark:text-gray-400 mt-2 rotate-[-45deg] sm:rotate-0 truncate max-w-full text-center">
									{day.displayDate}
								</span>
							</div>
						);
					})
				}
			</div>
		</div>

		<!-- Filter & Search Toolbar -->
		<div class="p-4 mb-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
			<form method="GET" class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<!-- Search -->
				<div class="relative w-full sm:w-80">
					<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
						<svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<input
						type="text"
						name="q"
						value={search}
						placeholder="Search by name, email, or user ID..."
						class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full pl-9 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
					/>
				</div>

				<!-- Status Filter -->
				<div class="flex items-center space-x-3">
					<select
						name="status"
						class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
					>
						<option value="all" selected={status === 'all'}>All Statuses</option>
						<option value="active" selected={status === 'active'}>Active</option>
						<option value="banned" selected={status === 'banned'}>Banned</option>
						<option value="locked" selected={status === 'locked'}>Locked</option>
					</select>

					<button
						type="submit"
						class="px-4 py-2.5 text-sm font-medium text-white bg-primary-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700"
					>
						Filter
					</button>

					{
						(search || status !== 'all') && (
							<a
								href={url('admin/projects/sendvirtualgift/users')}
								class="px-3 py-2.5 text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300"
							>
								Clear
							</a>
						)
					}
				</div>
			</form>
		</div>

		<!-- Users Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden dark:bg-gray-800 dark:border-gray-700">
			<div class="overflow-x-auto">
				<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
					<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
						<tr>
							<th class="px-5 py-3.5">User</th>
							<th class="px-4 py-3.5">User ID</th>
							<th class="px-4 py-3.5">Status</th>
							<th class="px-4 py-3.5">Paid Orders</th>
							<th class="px-4 py-3.5">Spent</th>
							<th class="px-4 py-3.5">Registered Date</th>
							<th class="px-4 py-3.5 text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							usersData.users.length === 0 ? (
								<tr>
									<td colspan="7" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
										<svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
										</svg>
										<div class="font-semibold text-gray-700 dark:text-gray-200">No users found</div>
										<p class="text-xs text-gray-400 mt-1">Try adjusting your search query or filters.</p>
									</td>
								</tr>
							) : (
								usersData.users.map((u) => {
									const createdDateStr = new Date(u.createdAt).toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									});
									const createdTimeStr = new Date(u.createdAt).toLocaleTimeString('en-US', {
										hour: '2-digit',
										minute: '2-digit',
									});
									const lastSignInStr = u.lastSignInAt
										? new Date(u.lastSignInAt).toLocaleDateString('en-US', {
												month: 'short',
												day: 'numeric',
										  })
										: 'Never';

									return (
										<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
											<!-- User Name & Email -->
											<td class="px-5 py-4">
												<div class="flex items-center space-x-3">
													{u.imageUrl ? (
														<img src={u.imageUrl} alt={u.name} class="w-9 h-9 rounded-full object-cover border border-gray-200 dark:border-gray-600" />
													) : (
														<div class="w-9 h-9 rounded-full bg-primary-100 text-primary-700 dark:bg-primary-900/60 dark:text-primary-300 flex items-center justify-center font-bold text-xs uppercase">
															{u.name.charAt(0)}
														</div>
													)}
													<div>
														<div class="font-semibold text-gray-900 dark:text-white flex items-center space-x-1.5">
															<span>{u.name}</span>
															{u.twoFactorEnabled && (
																<span class="inline-flex items-center px-1.5 py-0.2 text-[9px] font-bold bg-purple-100 text-purple-800 dark:bg-purple-900/60 dark:text-purple-300 rounded">
																	2FA
																</span>
															)}
														</div>
														<div class="text-xs text-gray-500 dark:text-gray-400">
															{u.email || (u.emailAddresses && u.emailAddresses[0]) || 'No email provided'}
														</div>
													</div>
												</div>
											</td>

											<!-- User ID -->
											<td class="px-4 py-4 font-mono text-xs text-gray-500 dark:text-gray-400">
												<span class="truncate max-w-[140px] inline-block" title={u.id}>
													{u.id}
												</span>
											</td>

											<!-- Status -->
											<td class="px-4 py-4">
												<span
													class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${
														u.status === 'Active'
															? 'bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300'
															: 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300'
													}`}
												>
													<span class={`w-1.5 h-1.5 rounded-full mr-1.5 ${u.status === 'Active' ? 'bg-green-500' : 'bg-red-500'}`}></span>
													{u.status}
												</span>
											</td>

											<!-- Paid Orders -->
											<td class="px-4 py-4 font-semibold text-gray-900 dark:text-white">
												{u.stats.paidOrdersCount}
											</td>

											<!-- Total Spent -->
											<td class="px-4 py-4 font-semibold text-emerald-600 dark:text-emerald-400">
												₹{u.stats.totalSpentRupees}
											</td>

											<!-- Registered Date & Time -->
											<td class="px-4 py-4 text-xs text-gray-700 dark:text-gray-300">
												<div class="font-medium text-gray-900 dark:text-white">{createdDateStr}</div>
												<div class="text-[11px] text-gray-400">{createdTimeStr} · Last sign-in: {lastSignInStr}</div>
											</td>

											<!-- Action -->
											<td class="px-4 py-4 text-right">
												<button
													type="button"
													class="px-3 py-1 text-xs font-semibold text-primary-600 bg-primary-50 rounded-lg hover:bg-primary-100 dark:bg-primary-900/30 dark:text-primary-400 dark:hover:bg-primary-900/50 transition-colors"
													onclick={`alert('User Profile Breakdown:\\n\\nName: ${u.name}\\nEmail: ${u.email || 'N/A'}\\nID: ${u.id}\\nStatus: ${u.status}\\nRegistered: ${new Date(u.createdAt).toLocaleString()}\\nLast Sign-In: ${u.lastSignInAt ? new Date(u.lastSignInAt).toLocaleString() : 'Never'}\\nPaid Purchases: ${u.stats.paidOrdersCount} (₹${u.stats.totalSpentRupees})')`}
												>
													Inspect
												</button>
											</td>
										</tr>
									);
								})
							)
						}
					</tbody>
				</table>
			</div>

			<!-- Pagination Footer -->
			<div class="px-5 py-4 bg-white border-t border-gray-200 dark:bg-gray-800 dark:border-gray-700 flex items-center justify-between text-xs text-gray-500">
				<div>
					Showing Page <span class="font-bold text-gray-900 dark:text-white">{usersData.page}</span> of{' '}
					<span class="font-bold text-gray-900 dark:text-white">{usersData.totalPages}</span> ({usersData.total} users)
				</div>
			</div>
		</div>
	</div>
</LayoutSidebar>
