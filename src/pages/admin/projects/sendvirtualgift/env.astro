---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { auditSvgEnvironment } from '../../../../projects/sendvirtualgift/services/environment.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const report = auditSvgEnvironment();
---

<LayoutSidebar title="SendVirtualGift Environment Status | InstaFlow Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			activeTab="env"
			title="Environment Status & Secrets Audit"
			subtitle="Inspect configured environment variables, secrets masking, client-side exposure boundaries, and deployment alignment."
		/>

		<!-- Important Notice -->
		<div class="p-4 mb-6 text-sm text-yellow-800 rounded-xl bg-yellow-50 dark:bg-gray-800 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-800 flex items-start">
			<svg class="w-5 h-5 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
			</svg>
			<div>
				<span class="font-bold">Production Configuration Notice:</span>
				{report.deploymentNotice} All secret keys below are masked for security and are never sent to client bundles.
			</div>
		</div>

		<!-- 4 Summary Cards -->
		<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-2 lg:grid-cols-4">
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Total Variables</span>
				<h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1">
					{report.summary.total}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Evaluated across all categories</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Configured & Active</span>
				<h3 class="text-2xl font-bold text-green-600 dark:text-green-400 mt-1">
					{report.summary.configuredCount}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Active in runtime environment</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Missing Required</span>
				<h3 class="text-2xl font-bold text-red-600 dark:text-red-400 mt-1">
					{report.summary.missingRequiredCount}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Production blockers</p>
			</div>
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
				<span class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">Optional Fallbacks</span>
				<h3 class="text-2xl font-bold text-indigo-600 dark:text-indigo-400 mt-1">
					{report.summary.optionalCount}
				</h3>
				<p class="text-[11px] text-gray-400 mt-1">Using built-in defaults</p>
			</div>
		</div>

		<!-- Environment Variables Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden dark:bg-gray-800 dark:border-gray-700">
			<div class="overflow-x-auto">
				<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
					<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
						<tr>
							<th class="px-5 py-3.5">Variable Name</th>
							<th class="px-4 py-3.5">Category</th>
							<th class="px-4 py-3.5">Scope</th>
							<th class="px-4 py-3.5">Status</th>
							<th class="px-4 py-3.5">Masked Preview</th>
							<th class="px-4 py-3.5">Description</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							report.items.map((item) => (
								<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
									<td class="px-5 py-4 font-mono text-xs font-bold text-gray-900 dark:text-white">
										{item.key}
									</td>
									<td class="px-4 py-4 text-xs font-medium text-gray-700 dark:text-gray-300">
										{item.category}
									</td>
									<td class="px-4 py-4 text-xs">
										<span
											class={`px-2 py-0.5 rounded text-[11px] font-semibold ${
												item.scope === 'Server-Only'
													? 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300'
													: 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300'
											}`}
										>
											{item.scope}
										</span>
									</td>
									<td class="px-4 py-4">
										<span
											class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${
												item.status === 'configured'
													? 'bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300'
													: item.status === 'missing'
													? 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300'
													: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300'
											}`}
										>
											<span class={`w-1.5 h-1.5 rounded-full mr-1.5 ${item.status === 'configured' ? 'bg-green-500' : item.status === 'missing' ? 'bg-red-500' : 'bg-gray-400'}`}></span>
											{item.status.replace('_', ' ').toUpperCase()}
										</span>
									</td>
									<td class="px-4 py-4 font-mono text-xs text-gray-700 dark:text-gray-300">
										{item.maskedValue}
									</td>
									<td class="px-4 py-4 text-xs text-gray-500 dark:text-gray-400">
										{item.description}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</LayoutSidebar>
