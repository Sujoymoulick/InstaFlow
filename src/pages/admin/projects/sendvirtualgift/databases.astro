---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { getSvgDatabasesHealth } from '../../../../projects/sendvirtualgift/services/databases.js';
import { fetchNoSignupCounters } from '../../../../projects/sendvirtualgift/services/clients.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const [report, counters] = await Promise.all([
	getSvgDatabasesHealth(),
	fetchNoSignupCounters(),
]);
---

<LayoutSidebar title="SendVirtualGift Databases | InstaFlow Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			activeTab="databases"
			title="Databases & Multi-Cloud Infrastructure"
			subtitle="Unified diagnostic monitor for InsForge Application BaaS and Neon Transactional PostgreSQL."
		/>

		<!-- InsForge Counting Table Status Banner -->
		<div class="p-5 mb-6 bg-white dark:bg-gray-800 rounded-xl border border-indigo-200 dark:border-indigo-900/50 shadow-sm">
			<div class="flex items-center justify-between mb-3">
				<div class="flex items-center space-x-2.5">
					<span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
					<h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider">
						InsForge Counting Table (<code class="text-primary-600 dark:text-primary-400 font-mono">no_signup_counters</code>)
					</h3>
				</div>
				<span class="text-xs px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 font-medium">
					Atomic Increments Active
				</span>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
				<div class="p-3.5 bg-gray-50 dark:bg-gray-700/40 rounded-lg flex items-center justify-between">
					<div>
						<div class="font-semibold text-gray-900 dark:text-white flex items-center">
							<span class="mr-1.5 text-base">🎁</span>
							<span>no_signup_cards</span>
						</div>
						<div class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
							Initial offset: <strong>3,158</strong> • Atomic increment on every no-signup card creation
						</div>
					</div>
					<div class="text-right">
						<div class="text-lg font-bold text-rose-600 dark:text-rose-400 font-mono">
							{counters.no_signup_cards.toLocaleString()}
						</div>
						<div class="text-[10px] text-gray-400">Current DB Count</div>
					</div>
				</div>

				<div class="p-3.5 bg-gray-50 dark:bg-gray-700/40 rounded-lg flex items-center justify-between">
					<div>
						<div class="font-semibold text-gray-900 dark:text-white flex items-center">
							<span class="mr-1.5 text-base">👁️</span>
							<span>gift_views</span>
						</div>
						<div class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
							Initial offset: <strong>3,254</strong> • Incremented on every gift/prank card recipient view
						</div>
					</div>
					<div class="text-right">
						<div class="text-lg font-bold text-cyan-600 dark:text-cyan-400 font-mono">
							{counters.gift_views.toLocaleString()}
						</div>
						<div class="text-[10px] text-gray-400">Current DB Count</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Security Notice -->
		<div class="p-4 mb-6 text-xs text-gray-700 rounded-xl bg-gray-100 dark:bg-gray-800 dark:text-gray-300 border border-gray-200 dark:border-gray-700 flex items-center">
			<svg class="w-4 h-4 mr-2.5 text-primary-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
			</svg>
			<span>
				<strong class="font-semibold">Zero-Credential Exposure Policy:</strong>
				Database passwords and master connection strings are masked. Health checks run via isolated server-side endpoints.
			</span>
		</div>

		<!-- 2 Major Database Cards Grid -->
		<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 mb-6">
			<!-- 1. InsForge PostgreSQL BaaS -->
			<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700 flex flex-col justify-between">
				<div>
					<div class="flex items-center justify-between mb-4">
						<div class="flex items-center space-x-3">
							<div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-gray-700 text-blue-600 flex items-center justify-center font-bold text-lg">
								⚡
							</div>
							<div>
								<h3 class="text-lg font-bold text-gray-900 dark:text-white">
									{report.insforge.name}
								</h3>
								<div class="text-xs text-gray-500 dark:text-gray-400">
									{report.insforge.provider}
								</div>
							</div>
						</div>
						<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300 border border-green-200 dark:border-green-800">
							<span class="w-2 h-2 mr-1.5 bg-green-500 rounded-full animate-pulse"></span>
							{report.insforge.status.toUpperCase()} ({report.insforge.latencyMs}ms)
						</span>
					</div>

					<p class="text-xs text-gray-500 dark:text-gray-400 mb-4">
						{report.insforge.role}
					</p>

					<!-- Diagnostics Details -->
					<div class="space-y-2.5 bg-gray-50 dark:bg-gray-700/40 p-4 rounded-xl text-xs">
						<div class="flex justify-between">
							<span class="text-gray-500">Endpoint:</span>
							<span class="font-mono text-gray-900 dark:text-white">{report.insforge.maskedEndpoint}</span>
						</div>
						<div class="flex justify-between">
							<span class="text-gray-500">Engine Version:</span>
							<span class="text-gray-900 dark:text-white">{report.insforge.version || 'PostgreSQL 16'}</span>
						</div>
						<div class="flex justify-between">
							<span class="text-gray-500">SSL / TLS:</span>
							<span class="text-emerald-600 font-semibold">Enabled (TLS 1.3)</span>
						</div>
						<div class="flex justify-between">
							<span class="text-gray-500">Last Latency Check:</span>
							<span class="text-gray-900 dark:text-white">{report.insforge.latencyMs} ms</span>
						</div>
					</div>

					<!-- Table Counts -->
					<div class="mt-4">
						<span class="text-xs font-semibold uppercase text-gray-400 tracking-wider block mb-2">Tracked Tables</span>
						<div class="grid grid-cols-2 gap-2 text-xs">
							{
								Object.entries(report.insforge.tables).map(([tableName, count]) => (
									<div class="p-2.5 rounded-lg bg-gray-50 dark:bg-gray-700/50 flex justify-between items-center">
										<span class="font-mono text-gray-700 dark:text-gray-300">{tableName}</span>
										<span class="font-bold text-gray-900 dark:text-white">{count} rows</span>
									</div>
								))
							}
						</div>
					</div>
				</div>

				<div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center">
					<span class="text-xs text-gray-400">Main Application BaaS</span>
					<button
						type="button"
						onclick="window.location.reload()"
						class="px-3 py-1.5 text-xs font-semibold text-primary-700 bg-primary-50 rounded-lg hover:bg-primary-100 dark:bg-gray-700 dark:text-primary-300"
					>
						Ping InsForge 🔄
					</button>
				</div>
			</div>

			<!-- 2. Neon PostgreSQL (Lakebase) -->
			<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700 flex flex-col justify-between">
				<div>
					<div class="flex items-center justify-between mb-4">
						<div class="flex items-center space-x-3">
							<div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-gray-700 text-emerald-600 flex items-center justify-center font-bold text-lg">
								🐘
							</div>
							<div>
								<h3 class="text-lg font-bold text-gray-900 dark:text-white">
									{report.neon.name}
								</h3>
								<div class="text-xs text-gray-500 dark:text-gray-400">
									{report.neon.provider}
								</div>
							</div>
						</div>
						<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300 border border-green-200 dark:border-green-800">
							<span class="w-2 h-2 mr-1.5 bg-green-500 rounded-full animate-pulse"></span>
							{report.neon.status.toUpperCase()} ({report.neon.latencyMs}ms)
						</span>
					</div>

					<p class="text-xs text-gray-500 dark:text-gray-400 mb-4">
						{report.neon.role}
					</p>

					<!-- Diagnostics Details -->
					<div class="space-y-2.5 bg-gray-50 dark:bg-gray-700/40 p-4 rounded-xl text-xs">
						<div class="flex justify-between">
							<span class="text-gray-500">Masked Host:</span>
							<span class="font-mono text-gray-900 dark:text-white">{report.neon.maskedEndpoint}</span>
						</div>
						<div class="flex justify-between">
							<span class="text-gray-500">Active Branch:</span>
							<span class="font-mono text-primary-600 dark:text-primary-400 font-semibold">{report.neon.branch}</span>
						</div>
						<div class="flex justify-between">
							<span class="text-gray-500">Engine Version:</span>
							<span class="text-gray-900 dark:text-white">{report.neon.version || 'PostgreSQL 16 (Neon)'}</span>
						</div>
						<div class="flex justify-between">
							<span class="text-gray-500">Last Latency Check:</span>
							<span class="text-gray-900 dark:text-white">{report.neon.latencyMs} ms</span>
						</div>
					</div>

					<!-- Table Counts -->
					<div class="mt-4">
						<span class="text-xs font-semibold uppercase text-gray-400 tracking-wider block mb-2">Authoritative Tables</span>
						<div class="grid grid-cols-2 gap-2 text-xs">
							{
								Object.entries(report.neon.tables).map(([tableName, count]) => (
									<div class="p-2.5 rounded-lg bg-gray-50 dark:bg-gray-700/50 flex justify-between items-center">
										<span class="font-mono text-gray-700 dark:text-gray-300">{tableName}</span>
										<span class="font-bold text-gray-900 dark:text-white">{count} rows</span>
									</div>
								))
							}
						</div>
					</div>
				</div>

				<div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center">
					<span class="text-xs text-gray-400">Transactional Authority</span>
					<button
						type="button"
						onclick="window.location.reload()"
						class="px-3 py-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 rounded-lg hover:bg-emerald-100 dark:bg-gray-700 dark:text-emerald-300"
					>
						Ping Neon 🔄
					</button>
				</div>
			</div>
		</div>
	</div>
</LayoutSidebar>
