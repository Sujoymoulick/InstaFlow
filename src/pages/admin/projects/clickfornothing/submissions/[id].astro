---
import LayoutSidebar from '../../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../../components/admin/ProjectHeader.astro';
import { getSubmissionById } from '../../../../../projects/clickfornothing/services/submissions.js';
import { listAuditLogs } from '../../../../../projects/clickfornothing/services/audit.js';
import { url } from '../../../../../lib/data.js';

export const prerender = false;

const { id } = Astro.params;
const submission = id ? await getSubmissionById(id) : null;
const allLogs = await listAuditLogs(50);
const submissionLogs = allLogs.filter((l) => l.submissionId === id);

if (!submission) {
	return Astro.redirect(url('admin/projects/clickfornothing/submissions'));
}

let statusBadgeClass = 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
if (submission.status === 'Pending Review') statusBadgeClass = 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 border border-amber-300';
else if (submission.status === 'Approved') statusBadgeClass = 'bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300 border border-sky-300';
else if (submission.status === 'Published') statusBadgeClass = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-300';
else if (submission.status === 'Rejected') statusBadgeClass = 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300 border border-rose-300';
---

<LayoutSidebar title={`${submission.title} | Submission Details`}>
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			projectId="clickfornothing"
			activeTab="submissions"
			title="Submission Inspection & Review"
			subtitle={`Detail analysis and moderation controls for submission #${submission.id}`}
		/>

		<!-- Back link & Status banner -->
		<div class="mb-4 flex items-center justify-between">
			<a
				href={url('admin/projects/clickfornothing/submissions')}
				class="inline-flex items-center text-xs font-semibold text-gray-500 hover:text-indigo-600 dark:text-gray-400"
			>
				← Back to All Submissions
			</a>
			<div class="flex items-center space-x-2">
				<span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold ${statusBadgeClass}`}>
					{submission.status}
				</span>
			</div>
		</div>

		<!-- Main 2-Column Inspection Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
			<!-- Left 2 Cols: Site Preview, Description & Details -->
			<div class="lg:col-span-2 space-y-6">
				<!-- Site Preview Card (Section 11) -->
				<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
					<div class="flex items-center justify-between mb-4">
						<div>
							<span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 block">
								{submission.category}
							</span>
							<h2 class="text-xl font-bold text-gray-900 dark:text-white mt-0.5">
								{submission.title}
							</h2>
						</div>
						<a
							href={submission.url}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition"
						>
							Open Submitted Site ↗
						</a>
					</div>

					<!-- Visual Preview Box -->
					<div class="relative aspect-video w-full rounded-xl bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 overflow-hidden flex items-center justify-center mb-4">
						{submission.previewImageUrl ? (
							<img src={submission.previewImageUrl} alt={submission.title} class="w-full h-full object-cover" />
						) : (
							<div class="text-center p-6">
								<div class="text-4xl mb-2">🖥️</div>
								<div class="font-semibold text-sm text-gray-700 dark:text-gray-200">{submission.title}</div>
								<p class="text-xs text-gray-400 mt-1 max-w-sm">
									No screenshot uploaded. Click "Open Submitted Site" to inspect live endpoint safely.
								</p>
							</div>
						)}
					</div>

					<!-- Sanitized URL info -->
					<div class="p-3 bg-gray-50 dark:bg-gray-700/40 rounded-lg flex items-center justify-between text-xs font-mono">
						<span class="text-gray-500 dark:text-gray-400 truncate mr-2">{submission.url}</span>
						<span class="text-emerald-600 dark:text-emerald-400 font-semibold flex-shrink-0">✓ Protocol Verified</span>
					</div>
				</div>

				<!-- Content & Description Card -->
				<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
					<h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-3">
						Submitted Content & Description
					</h3>
					<p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed bg-gray-50 dark:bg-gray-900/40 p-4 rounded-xl border border-gray-100 dark:border-gray-700">
						{submission.description || 'No description provided by submitter.'}
					</p>

					<!-- Tags -->
					{submission.tags && submission.tags.length > 0 && (
						<div class="mt-4">
							<span class="text-xs font-bold text-gray-400 uppercase tracking-wider block mb-2">Tagged Keywords</span>
							<div class="flex flex-wrap gap-1.5">
								{submission.tags.map((t) => (
									<span class="px-2.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300">
										#{t}
									</span>
								))}
							</div>
						</div>
					)}
				</div>

				<!-- Rejection Reason (if rejected) -->
				{submission.status === 'Rejected' && (
					<div class="p-5 bg-rose-50 border border-rose-200 rounded-xl dark:bg-rose-950/40 dark:border-rose-900">
						<h4 class="text-xs font-bold uppercase text-rose-800 dark:text-rose-300 mb-1">
							Rejection Reason Saved in Database
						</h4>
						<p class="text-sm text-rose-700 dark:text-rose-200">
							{submission.rejectionReason || 'No detailed reason was recorded.'}
						</p>
					</div>
				)}

				<!-- Audit Log Trail for this item -->
				<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
					<h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-3">
						Moderation Audit Trail
					</h3>
					{submissionLogs.length === 0 ? (
						<div class="text-xs text-gray-400 py-3 text-center">
							No previous administrative changes recorded for this submission yet.
						</div>
					) : (
						<div class="space-y-2">
							{submissionLogs.map((log) => (
								<div class="p-3 rounded-lg bg-gray-50 dark:bg-gray-700/40 border border-gray-100 dark:border-gray-700 flex items-center justify-between text-xs">
									<div>
										<span class="font-bold text-gray-900 dark:text-white">{log.action}</span>
										<span class="text-gray-500 dark:text-gray-400 ml-2">by {log.adminEmail}</span>
										{log.details && <p class="text-[11px] text-gray-400 mt-0.5">{log.details}</p>}
									</div>
									<span class="text-[10px] text-gray-400 whitespace-nowrap ml-4">
										{new Date(log.createdAt).toLocaleString()}
									</span>
								</div>
							))}
						</div>
					)}
				</div>
			</div>

			<!-- Right 1 Col: Submitter Info & Action Controls -->
			<div class="space-y-6">
				<!-- Action Controls Card -->
				<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
					<h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-4">
						Admin Moderation Actions
					</h3>
					<div class="space-y-2.5">
						<button
							type="button"
							id="btn-action-approve"
							class="w-full py-2.5 px-4 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm transition flex items-center justify-center"
						>
							<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
							</svg>
							Approve Submission
						</button>

						<button
							type="button"
							id="btn-action-publish"
							class="w-full py-2.5 px-4 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-lg shadow-sm transition flex items-center justify-center"
						>
							<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
							</svg>
							Publish Live to Directory
						</button>

						<button
							type="button"
							id="btn-action-reject"
							class="w-full py-2.5 px-4 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-sm transition flex items-center justify-center"
						>
							<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
							Reject Submission
						</button>
					</div>

					<div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 text-xs text-gray-400 space-y-1">
						<p>• Approving marks site ready for publication.</p>
						<p>• Rejecting records feedback reason for the creator.</p>
					</div>
				</div>

				<!-- Authenticated Submitter Card (Section 6) -->
				<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
					<h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-4">
						Authoritative Submitter
					</h3>
					<div class="flex items-center space-x-3 mb-4">
						{submission.userAvatarUrl ? (
							<img src={submission.userAvatarUrl} alt="" class="w-10 h-10 rounded-full object-cover" />
						) : (
							<div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 dark:bg-gray-700 dark:text-indigo-300 flex items-center justify-center font-bold text-base">
								{(submission.userName || 'U')[0].toUpperCase()}
							</div>
						)}
						<div>
							<div class="font-bold text-sm text-gray-900 dark:text-white">
								{submission.userName || 'Anonymous Submitter'}
							</div>
							<div class="text-xs text-gray-500 dark:text-gray-400">
								{submission.userEmail || 'No email attached'}
							</div>
						</div>
					</div>

					<div class="space-y-2 text-xs border-t border-gray-100 dark:border-gray-700 pt-3">
						<div>
							<span class="text-gray-400 block text-[10px]">Authoritative Clerk User ID</span>
							<span class="font-mono text-indigo-600 dark:text-indigo-400 font-semibold">{submission.userId}</span>
						</div>
						<div>
							<span class="text-gray-400 block text-[10px]">Submitted Date</span>
							<span class="text-gray-700 dark:text-gray-300">{new Date(submission.createdAt).toLocaleString()}</span>
						</div>
						<div>
							<span class="text-gray-400 block text-[10px]">Last Status Update</span>
							<span class="text-gray-700 dark:text-gray-300">{new Date(submission.updatedAt).toLocaleString()}</span>
						</div>
						{submission.reviewedBy && (
							<div>
								<span class="text-gray-400 block text-[10px]">Reviewed By Admin</span>
								<span class="text-gray-700 dark:text-gray-300">{submission.reviewedBy}</span>
							</div>
						)}
					</div>
				</div>
			</div>
		</div>

		<!-- Rejection Dialog Modal -->
		<div id="reject-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-gray-900/60 backdrop-blur-xs hidden">
			<div class="bg-white dark:bg-gray-800 rounded-xl max-w-md w-full p-5 shadow-2xl border border-gray-200 dark:border-gray-700">
				<div class="flex items-center justify-between mb-3">
					<h3 class="text-base font-bold text-gray-900 dark:text-white flex items-center">
						<span class="mr-2 text-rose-600">✕</span> Reject Submission
					</h3>
					<button type="button" id="reject-modal-close" class="text-gray-400 hover:text-gray-600 dark:hover:text-white">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
					Provide feedback reason for why this submission cannot be approved:
				</p>
				<div class="mb-4">
					<label for="rejection-reason-input" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">
						Rejection reason:
					</label>
					<textarea
						id="rejection-reason-input"
						rows="3"
						class="w-full p-2.5 text-xs text-gray-900 bg-gray-50 border border-gray-300 rounded-lg focus:ring-rose-500 focus:border-rose-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
						placeholder="Explain reason for rejection..."
					></textarea>
				</div>
				<div class="flex items-center justify-end space-x-2">
					<button
						type="button"
						id="reject-modal-cancel"
						class="px-3.5 py-2 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600"
					>
						Cancel
					</button>
					<button
						type="button"
						id="reject-modal-confirm"
						class="px-4 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-sm transition"
					>
						Reject Submission
					</button>
				</div>
			</div>
		</div>

		<!-- Toast Container -->
		<div id="toast" class="fixed bottom-5 right-5 z-50 transform transition-all duration-300 opacity-0 translate-y-2 pointer-events-none">
			<div class="px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-gray-900 text-white" id="toast-inner">
				<span id="toast-icon">✓</span>
				<span id="toast-msg">Action completed</span>
			</div>
		</div>
	</div>
</LayoutSidebar>

<script define:vars={{ subId: submission.id }}>
	function showToast(msg, isError = false) {
		const toast = document.getElementById('toast');
		const toastInner = document.getElementById('toast-inner');
		const toastMsg = document.getElementById('toast-msg');
		const toastIcon = document.getElementById('toast-icon');
		if (!toast || !toastInner || !toastMsg || !toastIcon) return;

		toastMsg.innerText = msg;
		toastIcon.innerText = isError ? '✕' : '✓';
		toastInner.className = isError
			? 'px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-rose-600 text-white'
			: 'px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-gray-900 text-white';

		toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
		setTimeout(() => {
			toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
		}, 3000);
	}

	// Approve
	document.getElementById('btn-action-approve')?.addEventListener('click', async () => {
		try {
			const res = await fetch(`/api/admin/submissions/${subId}/approve`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
			});
			const data = await res.json();
			if (res.ok && data.success) {
				showToast('Submission approved!');
				setTimeout(() => window.location.reload(), 800);
			} else {
				showToast(data.error || 'Failed to approve', true);
			}
		} catch (err) {
			showToast(err.message, true);
		}
	});

	// Publish
	document.getElementById('btn-action-publish')?.addEventListener('click', async () => {
		try {
			const res = await fetch(`/api/admin/submissions/${subId}/publish`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
			});
			const data = await res.json();
			if (res.ok && data.success) {
				showToast('Submission published live!');
				setTimeout(() => window.location.reload(), 800);
			} else {
				showToast(data.error || 'Failed to publish', true);
			}
		} catch (err) {
			showToast(err.message, true);
		}
	});

	// Reject Modal
	const rejectModal = document.getElementById('reject-modal');
	const rejectModalClose = document.getElementById('reject-modal-close');
	const rejectModalCancel = document.getElementById('reject-modal-cancel');
	const rejectModalConfirm = document.getElementById('reject-modal-confirm');
	const rejectionInput = document.getElementById('rejection-reason-input');

	document.getElementById('btn-action-reject')?.addEventListener('click', () => {
		if (rejectionInput) rejectionInput.value = '';
		rejectModal?.classList.remove('hidden');
	});

	rejectModalClose?.addEventListener('click', () => rejectModal?.classList.add('hidden'));
	rejectModalCancel?.addEventListener('click', () => rejectModal?.classList.add('hidden'));

	rejectModalConfirm?.addEventListener('click', async () => {
		const reason = rejectionInput?.value?.trim() || 'Submission does not meet quality requirements.';
		try {
			const res = await fetch(`/api/admin/submissions/${subId}/reject`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ reason }),
			});
			const data = await res.json();
			if (res.ok && data.success) {
				showToast('Submission rejected.');
				rejectModal?.classList.add('hidden');
				setTimeout(() => window.location.reload(), 800);
			} else {
				showToast(data.error || 'Failed to reject', true);
			}
		} catch (err) {
			showToast(err.message, true);
		}
	});
</script>
