---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { listClickForNothingUsers } from '../../../../projects/clickfornothing/services/users.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const users = await listClickForNothingUsers();
---

<LayoutSidebar title="Users & Submitters | ClickForNothing Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			projectId="clickfornothing"
			activeTab="users"
			title="Submitters & Registered Users"
			subtitle="Inspect authenticated Clerk users and their portfolio submission records."
		/>

		<!-- Users Metric Banner -->
		<div class="p-4 mb-5 bg-indigo-50 border border-indigo-200 rounded-xl dark:bg-gray-800 dark:border-indigo-900/50 flex items-center justify-between">
			<div class="flex items-center space-x-3">
				<div class="p-2.5 bg-indigo-100 text-indigo-700 rounded-lg dark:bg-indigo-950 dark:text-indigo-300">
					👥
				</div>
				<div>
					<h3 class="text-sm font-bold text-indigo-900 dark:text-indigo-200">
						{users.length} Active Platform Users & Submitters
					</h3>
					<p class="text-xs text-indigo-700 dark:text-indigo-400">
						Clerk authoritative identity records stored and cross-referenced in Neon PostgreSQL.
					</p>
				</div>
			</div>
			<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300">
				<span class="w-1.5 h-1.5 mr-1.5 bg-green-500 rounded-full animate-pulse"></span>
				Clerk Synchronized
			</span>
		</div>

		<!-- Users Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700 overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-xs text-left text-gray-500 dark:text-gray-400">
					<thead class="text-[11px] text-gray-700 uppercase bg-gray-50 dark:bg-gray-700/50 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700">
						<tr>
							<th class="px-4 py-3 font-semibold">User</th>
							<th class="px-4 py-3 font-semibold">Clerk User ID</th>
							<th class="px-4 py-3 font-semibold">Email</th>
							<th class="px-4 py-3 font-semibold text-center">Total Submissions</th>
							<th class="px-4 py-3 font-semibold text-center">Status Breakdown</th>
							<th class="px-4 py-3 font-semibold">Last Submission</th>
							<th class="px-4 py-3 font-semibold text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							users.map((u) => (
								<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40 transition">
									<td class="px-4 py-3">
										<div class="flex items-center space-x-2.5">
											{u.avatarUrl ? (
												<img src={u.avatarUrl} alt="" class="w-7 h-7 rounded-full object-cover flex-shrink-0" />
											) : (
												<div class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 dark:bg-gray-700 dark:text-indigo-300 flex items-center justify-center font-bold text-xs flex-shrink-0">
													{u.name[0].toUpperCase()}
												</div>
											)}
											<div>
												<div class="font-bold text-gray-900 dark:text-white line-clamp-1">{u.name}</div>
												{u.verified && (
													<span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium">
														✓ Verified
													</span>
												)}
											</div>
										</div>
									</td>
									<td class="px-4 py-3 font-mono font-medium text-gray-900 dark:text-white">
										{u.userId}
									</td>
									<td class="px-4 py-3 text-gray-600 dark:text-gray-300">
										{u.email}
									</td>
									<td class="px-4 py-3 text-center">
										<span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-indigo-50 text-indigo-700 dark:bg-gray-700 dark:text-indigo-300 font-bold text-xs">
											{u.totalSubmissions}
										</span>
									</td>
									<td class="px-4 py-3 text-center">
										<div class="inline-flex items-center space-x-1.5 text-[10px]">
											<span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800" title="Pending Review">
												{u.pendingCount} pnd
											</span>
											<span class="px-1.5 py-0.5 rounded bg-sky-100 text-sky-800" title="Approved">
												{u.approvedCount} app
											</span>
											<span class="px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800" title="Published">
												{u.publishedCount} pub
											</span>
											<span class="px-1.5 py-0.5 rounded bg-rose-100 text-rose-800" title="Rejected">
												{u.rejectedCount} rej
											</span>
										</div>
									</td>
									<td class="px-4 py-3 text-gray-400">
										{u.lastSubmittedAt ? new Date(u.lastSubmittedAt).toLocaleDateString() : 'None yet'}
									</td>
									<td class="px-4 py-3 text-right">
										<a
											href={url(`admin/projects/clickfornothing/submissions?search=${encodeURIComponent(u.email || u.userId)}`)}
											class="px-2.5 py-1 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-900/40 dark:text-indigo-300 rounded-lg transition"
										>
											View Submissions →
										</a>
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</LayoutSidebar>
