---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { listSubmissions, getSubmissionStats } from '../../../../projects/clickfornothing/services/submissions.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const requestUrl = new URL(Astro.request.url);
const search = requestUrl.searchParams.get('search') || undefined;
const page = parseInt(requestUrl.searchParams.get('page') || '1', 10);
const limit = 20;

const [submissionsData, stats] = await Promise.all([
	listSubmissions({ search, status: 'Rejected', page, limit, sort: 'newest' }),
	getSubmissionStats(),
]);

const { submissions, total, totalPages } = submissionsData;
---

<LayoutSidebar title="Rejected Submissions | ClickForNothing Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			projectId="clickfornothing"
			activeTab="rejected"
			title="Rejected Submissions"
			subtitle="Sites that did not meet directory guidelines or quality checks."
		/>

		<!-- Rejected Banner -->
		<div class="p-4 mb-5 bg-rose-50 border border-rose-200 rounded-xl dark:bg-gray-800 dark:border-rose-900/50 flex items-center justify-between">
			<div class="flex items-center space-x-3">
				<div class="p-2.5 bg-rose-100 text-rose-700 rounded-lg dark:bg-rose-950 dark:text-rose-300">
					❌
				</div>
				<div>
					<h3 class="text-sm font-bold text-rose-900 dark:text-rose-200">
						{total} Rejected Submissions
					</h3>
					<p class="text-xs text-rose-700 dark:text-rose-400">
						Examine recorded rejection reasons and reconsider if creators fixed flagged issues.
					</p>
				</div>
			</div>
			<a
				href={url('admin/projects/clickfornothing/submissions')}
				class="text-xs font-semibold text-rose-800 hover:underline dark:text-rose-300"
			>
				All Submissions →
			</a>
		</div>

		<!-- Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700 overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-xs text-left text-gray-500 dark:text-gray-400">
					<thead class="text-[11px] text-gray-700 uppercase bg-gray-50 dark:bg-gray-700/50 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700">
						<tr>
							<th class="px-4 py-3 font-semibold">Title / URL</th>
							<th class="px-4 py-3 font-semibold">Submitter</th>
							<th class="px-4 py-3 font-semibold">Rejection Reason</th>
							<th class="px-4 py-3 font-semibold">Reviewed By</th>
							<th class="px-4 py-3 font-semibold">Rejected Date</th>
							<th class="px-4 py-3 font-semibold text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							submissions.length === 0 ? (
								<tr>
									<td colspan="6" class="p-8 text-center text-gray-500 dark:text-gray-400">
										<div class="text-3xl mb-2">✨</div>
										<div class="font-medium text-sm text-gray-900 dark:text-white">No rejected submissions found.</div>
										<p class="text-xs text-gray-400 mt-1">There are no records in the rejection bin.</p>
									</td>
								</tr>
							) : (
								submissions.map((sub) => (
									<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40 transition">
										<td class="px-4 py-3">
											<div class="font-bold text-gray-900 dark:text-white line-clamp-1">{sub.title}</div>
											<span class="text-[11px] text-gray-400 font-mono truncate block max-w-xs">{sub.url}</span>
										</td>
										<td class="px-4 py-3">
											<div class="font-medium text-gray-900 dark:text-white">{sub.userName || 'Anonymous'}</div>
											<div class="text-[11px] text-gray-400">{sub.userEmail || sub.userId}</div>
										</td>
										<td class="px-4 py-3 max-w-xs">
											<div class="text-rose-700 dark:text-rose-300 bg-rose-50 dark:bg-rose-950/40 p-2 rounded border border-rose-100 dark:border-rose-900/40 line-clamp-2">
												{sub.rejectionReason || 'No specific reason entered.'}
											</div>
										</td>
										<td class="px-4 py-3 text-gray-500">
											{sub.reviewedBy || 'System Admin'}
										</td>
										<td class="px-4 py-3 text-gray-400">
											{new Date(sub.updatedAt).toLocaleDateString()}
										</td>
										<td class="px-4 py-3 text-right">
											<div class="inline-flex items-center space-x-1.5">
												<a
													href={url(`admin/projects/clickfornothing/submissions/${sub.id}`)}
													class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600"
												>
													Details
												</a>
												<button
													type="button"
													class="btn-reapprove px-2.5 py-1 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm transition"
													data-id={sub.id}
												>
													Re-Approve
												</button>
												<button
													type="button"
													class="btn-delete px-2.5 py-1 text-xs font-semibold text-white bg-red-700 hover:bg-red-800 rounded-lg shadow-sm transition"
													data-id={sub.id}
													data-title={sub.title}
													title="Delete permanently"
												>
													🗑
												</button>
											</div>
										</td>
									</tr>
								))
							)
						}
					</tbody>
				</table>
			</div>
		</div>

		<!-- Toast Container -->
		<div id="toast" class="fixed bottom-5 right-5 z-50 transform transition-all duration-300 opacity-0 translate-y-2 pointer-events-none">
			<div class="px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-gray-900 text-white" id="toast-inner">
				<span id="toast-icon">✓</span>
				<span id="toast-msg">Action completed</span>
			</div>
		</div>
	</div>
</LayoutSidebar>

<script>
	function showToast(msg: string, isError = false) {
		const toast = document.getElementById('toast');
		const toastInner = document.getElementById('toast-inner');
		const toastMsg = document.getElementById('toast-msg');
		const toastIcon = document.getElementById('toast-icon');
		if (!toast || !toastInner || !toastMsg || !toastIcon) return;

		toastMsg.innerText = msg;
		toastIcon.innerText = isError ? '✕' : '✓';
		toastInner.className = isError
			? 'px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-rose-600 text-white'
			: 'px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-gray-900 text-white';

		toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
		setTimeout(() => {
			toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
		}, 3000);
	}

	document.querySelectorAll('.btn-reapprove').forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
			if (!id) return;
			if (!confirm('Re-approve this submission?')) return;
			try {
				const res = await fetch(`/api/admin/submissions/${id}/approve`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
				});
				const data = await res.json();
				if (res.ok && data.success) {
					showToast('Submission re-approved!');
					setTimeout(() => window.location.reload(), 700);
				} else {
					showToast(data.error || 'Failed to re-approve', true);
				}
			} catch (err: any) {
				showToast(err.message, true);
			}
		});
	});

	document.querySelectorAll('.btn-delete').forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			const target = e.currentTarget as HTMLElement;
			const id = target.getAttribute('data-id');
			const title = target.getAttribute('data-title') || 'this rejected submission';
			if (!id) return;

			if (!confirm(`Are you sure you want to permanently delete "${title}" from Neon DB?`)) return;

			try {
				const res = await fetch(`/api/admin/submissions/${id}`, {
					method: 'DELETE',
					headers: { 'Content-Type': 'application/json' },
				});
				const data = await res.json();
				if (res.ok && data.success) {
					showToast('Submission deleted successfully!');
					setTimeout(() => window.location.reload(), 700);
				} else {
					showToast(data.error || 'Failed to delete submission', true);
				}
			} catch (err: any) {
				showToast(err.message, true);
			}
		});
	});
</script>

