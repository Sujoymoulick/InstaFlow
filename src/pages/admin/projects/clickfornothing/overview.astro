	</div>

	<script is:inline>
		async function refreshRealtimeData() {
			const spinner = document.getElementById('sync-spinner');
			const syncText = document.getElementById('realtime-last-sync');
			if (spinner) spinner.classList.add('animate-spin');

			try {
				const res = await fetch('/api/admin/projects/clickfornothing/realtime');
				if (res.ok) {
					const data = await res.json();
					if (data.success && data.stats) {
						const elUsers = document.getElementById('stat-total-users');
						const elSub = document.getElementById('stat-total-submissions');
						const elPending = document.getElementById('stat-pending-review');
						const elApproved = document.getElementById('stat-approved');
						const elPublished = document.getElementById('stat-published');
						const elRejected = document.getElementById('stat-rejected');

						if (elUsers) elUsers.textContent = data.stats.totalUsers;
						if (elSub) elSub.textContent = data.stats.totalSubmissions;
						if (elPending) elPending.textContent = data.stats.pendingReview;
						if (elApproved) elApproved.textContent = data.stats.approved;
						if (elPublished) elPublished.textContent = data.stats.published;
						if (elRejected) elRejected.textContent = data.stats.rejected;

						if (syncText) syncText.textContent = `Synced: ${new Date().toLocaleTimeString()}`;
					}
				}
			} catch (err) {
				console.error('Realtime sync error:', err);
			} finally {
				if (spinner) spinner.classList.remove('animate-spin');
			}
		}

		// Auto background sync every 15 seconds
		setInterval(refreshRealtimeData, 15000);
	</script>
</LayoutSidebar>
