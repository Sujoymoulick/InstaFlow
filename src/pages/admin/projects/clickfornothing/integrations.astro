---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { probeAllCfnIntegrations } from '../../../../projects/clickfornothing/services/integrations.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const integrations = await probeAllCfnIntegrations();
const allConnected = integrations.every((i) => i.status === 'connected');
---

<LayoutSidebar title="ClickForNothing Integrations | InstaFlow Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			projectId="clickfornothing"
			activeTab="integrations"
			title="External Integrations & APIs"
			subtitle="Live status, health verification, and latency diagnostics across Neon PostgreSQL, Clerk Auth, Cloudinary, and Production Web."
		/>

		<!-- Status Banner -->
		<div class={`p-4 mb-6 rounded-xl border flex items-center justify-between ${
			allConnected
				? 'bg-emerald-50 border-emerald-200 text-emerald-900 dark:bg-emerald-950/40 dark:border-emerald-800 dark:text-emerald-200'
				: 'bg-amber-50 border-amber-200 text-amber-900 dark:bg-amber-950/40 dark:border-amber-800 dark:text-amber-200'
		}`}>
			<div class="flex items-center space-x-3">
				<div class={`w-3 h-3 rounded-full ${allConnected ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500'}`}></div>
				<div>
					<h4 class="text-sm font-bold">
						{allConnected ? 'All Systems Operational & Connected' : 'One or More Integrations Need Attention'}
					</h4>
					<p class="text-xs opacity-90 mt-0.5">
						Live diagnostics active. Connected to ClickForNothing production environment.
					</p>
				</div>
			</div>
			<button
				type="button"
				onclick="window.location.reload()"
				class="px-3 py-1.5 text-xs font-semibold bg-white border border-gray-300 dark:bg-gray-800 dark:border-gray-600 rounded-lg shadow-sm hover:bg-gray-50 transition"
			>
				🔄 Re-Probe All
			</button>
		</div>

		<!-- Integrations Cards Grid -->
		<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
			{
				integrations.map((item) => (
					<div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700 flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between mb-3">
								<span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wider bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
									{item.type}
								</span>
								<span
									class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
										item.status === 'connected'
											? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
											: item.status === 'degraded'
											? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'
											: 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300'
									}`}
								>
									{item.status === 'connected' ? '● Connected' : item.status === 'degraded' ? '▲ Degraded' : '✕ Disconnected'}
								</span>
							</div>

							<h3 class="text-lg font-bold text-gray-900 dark:text-white">
								{item.name}
							</h3>
							<p class="text-xs text-gray-500 dark:text-gray-400 mt-1 mb-4">
								{item.description}
							</p>

							{item.errorMessage && (
								<div class="p-3 mb-4 text-xs text-rose-800 bg-rose-50 border border-rose-200 rounded-lg dark:bg-rose-950 dark:text-rose-300">
									{item.errorMessage}
								</div>
							)}

							<!-- Details Table -->
							<div class="p-3 bg-gray-50 rounded-lg dark:bg-gray-700/50 space-y-1.5 text-xs text-gray-600 dark:text-gray-300">
								{Object.entries(item.details).map(([key, val]) => (
									<div class="flex justify-between items-center">
										<span class="text-gray-400 capitalize">{key}:</span>
										<span class="font-medium font-mono text-[11px] text-gray-900 dark:text-white truncate max-w-[200px]">{String(val)}</span>
									</div>
								))}
								{item.latencyMs !== null && (
									<div class="flex justify-between items-center pt-1 border-t border-gray-200 dark:border-gray-600">
										<span class="text-gray-400">Response Latency:</span>
										<span class="font-bold text-indigo-600 dark:text-indigo-400">{item.latencyMs} ms</span>
									</div>
								)}
							</div>
						</div>

						<div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between text-[11px] text-gray-400">
							<span>Last Verified: {new Date(item.lastChecked).toLocaleTimeString()}</span>
							<span class="text-emerald-600 dark:text-emerald-400 font-semibold">Configured in .env</span>
						</div>
					</div>
				))
			}
		</div>
	</div>
</LayoutSidebar>
