---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { listSubmissions, getSubmissionStats } from '../../../../projects/clickfornothing/services/submissions.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const requestUrl = new URL(Astro.request.url);
const search = requestUrl.searchParams.get('search') || undefined;
const page = parseInt(requestUrl.searchParams.get('page') || '1', 10);
const limit = 20;

const [submissionsData, stats] = await Promise.all([
	listSubmissions({ search, status: 'Pending Review', page, limit, sort: 'newest' }),
	getSubmissionStats(),
]);

const { submissions, total, totalPages } = submissionsData;
---

<LayoutSidebar title="Pending Review Queue | ClickForNothing Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			projectId="clickfornothing"
			activeTab="pending-review"
			title="Pending Review Moderation Queue"
			subtitle="Review newly submitted sites awaiting moderation before approval or rejection."
		/>

		<!-- Queue Banner -->
		<div class="p-4 mb-5 bg-amber-50 border border-amber-200 rounded-xl dark:bg-gray-800 dark:border-amber-900/50 flex items-center justify-between">
			<div class="flex items-center space-x-3">
				<div class="p-2.5 bg-amber-100 text-amber-700 rounded-lg dark:bg-amber-950 dark:text-amber-300">
					⏳
				</div>
				<div>
					<h3 class="text-sm font-bold text-amber-900 dark:text-amber-200">
						{total} Submissions Awaiting Moderation
					</h3>
					<p class="text-xs text-amber-700 dark:text-amber-400">
						Inspect each site for functionality, compliance, and quality before approving for publication.
					</p>
				</div>
			</div>
			<a
				href={url('admin/projects/clickfornothing/submissions')}
				class="text-xs font-semibold text-amber-800 hover:underline dark:text-amber-300"
			>
				View All Submissions →
			</a>
		</div>

		<!-- Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700 overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-xs text-left text-gray-500 dark:text-gray-400">
					<thead class="text-[11px] text-gray-700 uppercase bg-gray-50 dark:bg-gray-700/50 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700">
						<tr>
							<th class="px-4 py-3 font-semibold">Title / Website</th>
							<th class="px-4 py-3 font-semibold">Submitter</th>
							<th class="px-4 py-3 font-semibold">Category</th>
							<th class="px-4 py-3 font-semibold">Submitted Date</th>
							<th class="px-4 py-3 font-semibold text-right">Moderation Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							submissions.length === 0 ? (
								<tr>
									<td colspan="5" class="p-8 text-center text-gray-500 dark:text-gray-400">
										<div class="text-3xl mb-2">🎉</div>
										<div class="font-medium text-sm text-gray-900 dark:text-white">Review queue is empty!</div>
										<p class="text-xs text-gray-400 mt-1">All user submissions have been reviewed.</p>
									</td>
								</tr>
							) : (
								submissions.map((sub) => (
									<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40 transition">
										<td class="px-4 py-3">
											<div class="font-bold text-gray-900 dark:text-white line-clamp-1">{sub.title}</div>
											<a
												href={sub.url}
												target="_blank"
												rel="noopener noreferrer"
												class="text-[11px] text-indigo-600 hover:underline dark:text-indigo-400 inline-flex items-center"
											>
												{sub.url}
												<svg class="w-2.5 h-2.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
												</svg>
											</a>
										</td>
										<td class="px-4 py-3">
											<div class="font-medium text-gray-900 dark:text-white">{sub.userName || 'Anonymous'}</div>
											<div class="text-[11px] text-gray-400">{sub.userEmail || sub.userId}</div>
										</td>
										<td class="px-4 py-3">
											<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
												{sub.category}
											</span>
										</td>
										<td class="px-4 py-3 text-gray-400">
											{new Date(sub.createdAt).toLocaleDateString()}
										</td>
										<td class="px-4 py-3 text-right">
											<div class="inline-flex items-center space-x-1.5">
												<a
													href={url(`admin/projects/clickfornothing/submissions/${sub.id}`)}
													class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600"
												>
													Inspect
												</a>
												<button
													type="button"
													class="btn-approve px-2.5 py-1 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm transition"
													data-id={sub.id}
												>
													✓ Approve
												</button>
												<button
													type="button"
													class="btn-reject px-2.5 py-1 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-sm transition"
													data-id={sub.id}
													data-title={sub.title}
												>
													✕ Reject
												</button>
											</div>
										</td>
									</tr>
								))
							)
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</LayoutSidebar>

<script>
	document.querySelectorAll('.btn-approve').forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
			if (!id) return;
			try {
				const res = await fetch(`/api/admin/submissions/${id}/approve`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
				});
				if (res.ok) {
					window.location.reload();
				}
			} catch {}
		});
	});

	document.querySelectorAll('.btn-reject').forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			const target = e.currentTarget as HTMLElement;
			const id = target.getAttribute('data-id');
			const title = target.getAttribute('data-title') || 'site';
			if (!id) return;

			const reason = prompt(`Reason for rejecting "${title}":`, 'Submission does not meet quality requirements.');
			if (reason === null) return;

			try {
				const res = await fetch(`/api/admin/submissions/${id}/reject`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ reason }),
				});
				if (res.ok) {
					window.location.reload();
				}
			} catch {}
		});
	});
</script>
