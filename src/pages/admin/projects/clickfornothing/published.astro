---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { listSubmissions, getSubmissionStats } from '../../../../projects/clickfornothing/services/submissions.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const requestUrl = new URL(Astro.request.url);
const search = requestUrl.searchParams.get('search') || undefined;
const page = parseInt(requestUrl.searchParams.get('page') || '1', 10);
const limit = 20;

const [submissionsData, stats] = await Promise.all([
	listSubmissions({ search, status: 'Published', page, limit, sort: 'newest' }),
	getSubmissionStats(),
]);

const { submissions, total, totalPages } = submissionsData;
---

<LayoutSidebar title="Published Websites | ClickForNothing Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			projectId="clickfornothing"
			activeTab="published"
			title="Published Live Submissions"
			subtitle="Websites currently live and publicly featured in the ClickForNothing directory."
		/>

		<!-- Published Banner -->
		<div class="p-4 mb-5 bg-emerald-50 border border-emerald-200 rounded-xl dark:bg-gray-800 dark:border-emerald-900/50 flex items-center justify-between">
			<div class="flex items-center space-x-3">
				<div class="p-2.5 bg-emerald-100 text-emerald-700 rounded-lg dark:bg-emerald-950 dark:text-emerald-300">
					🚀
				</div>
				<div>
					<h3 class="text-sm font-bold text-emerald-900 dark:text-emerald-200">
						{total} Live Directory Sites
					</h3>
					<p class="text-xs text-emerald-700 dark:text-emerald-400">
						All approved and live websites displayed on ClickForNothing.
					</p>
				</div>
			</div>
			<a
				href="https://clickfornothing.com"
				target="_blank"
				rel="noopener noreferrer"
				class="text-xs font-semibold text-emerald-800 hover:underline dark:text-emerald-300 inline-flex items-center"
			>
				Open Public Directory ↗
			</a>
		</div>

		<!-- Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700 overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-xs text-left text-gray-500 dark:text-gray-400">
					<thead class="text-[11px] text-gray-700 uppercase bg-gray-50 dark:bg-gray-700/50 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700">
						<tr>
							<th class="px-4 py-3 font-semibold">Live Site</th>
							<th class="px-4 py-3 font-semibold">Creator</th>
							<th class="px-4 py-3 font-semibold">Category</th>
							<th class="px-4 py-3 font-semibold">Published Date</th>
							<th class="px-4 py-3 font-semibold">Reviewed By</th>
							<th class="px-4 py-3 font-semibold text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							submissions.length === 0 ? (
								<tr>
									<td colspan="6" class="p-8 text-center text-gray-500 dark:text-gray-400">
										<div class="text-3xl mb-2">🌐</div>
										<div class="font-medium text-sm text-gray-900 dark:text-white">No published sites found.</div>
										<p class="text-xs text-gray-400 mt-1">Approve pending submissions to publish them to the directory.</p>
									</td>
								</tr>
							) : (
								submissions.map((sub) => (
									<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40 transition">
										<td class="px-4 py-3">
											<div class="font-bold text-gray-900 dark:text-white line-clamp-1">{sub.title}</div>
											<a
												href={sub.url}
												target="_blank"
												rel="noopener noreferrer"
												class="text-[11px] text-indigo-600 hover:underline dark:text-indigo-400 inline-flex items-center"
											>
												{sub.url}
												<svg class="w-2.5 h-2.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
												</svg>
											</a>
										</td>
										<td class="px-4 py-3">
											<div class="font-medium text-gray-900 dark:text-white">{sub.userName || 'Anonymous'}</div>
											<div class="text-[11px] text-gray-400">{sub.userEmail || sub.userId}</div>
										</td>
										<td class="px-4 py-3">
											<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
												{sub.category}
											</span>
										</td>
										<td class="px-4 py-3 text-emerald-600 font-medium">
											{sub.publishedAt ? new Date(sub.publishedAt).toLocaleDateString() : new Date(sub.updatedAt).toLocaleDateString()}
										</td>
										<td class="px-4 py-3 text-gray-500">
											{sub.reviewedBy || 'System Admin'}
										</td>
										<td class="px-4 py-3 text-right">
											<div class="inline-flex items-center space-x-1.5">
												<a
													href={sub.url}
													target="_blank"
													rel="noopener noreferrer"
													class="px-2.5 py-1 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition"
												>
													Visit Site ↗
												</a>
												<a
													href={url(`admin/projects/clickfornothing/submissions/${sub.id}`)}
													class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600"
												>
													Details
												</a>
												<button
													type="button"
													class="btn-reject px-2.5 py-1 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-sm transition"
													data-id={sub.id}
													data-title={sub.title}
													title="Unpublish and reject site"
												>
													Reject
												</button>
												<button
													type="button"
													class="btn-delete px-2.5 py-1 text-xs font-semibold text-white bg-red-700 hover:bg-red-800 rounded-lg shadow-sm transition"
													data-id={sub.id}
													data-title={sub.title}
													title="Delete permanently"
												>
													🗑
												</button>
											</div>
										</td>
									</tr>
								))
							)
						}
					</tbody>
				</table>
			</div>
		</div>

		<!-- Toast Container -->
		<div id="toast" class="fixed bottom-5 right-5 z-50 transform transition-all duration-300 opacity-0 translate-y-2 pointer-events-none">
			<div class="px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-gray-900 text-white" id="toast-inner">
				<span id="toast-icon">✓</span>
				<span id="toast-msg">Action completed</span>
			</div>
		</div>
	</div>
</LayoutSidebar>

<script>
	function showToast(msg: string, isError = false) {
		const toast = document.getElementById('toast');
		const toastInner = document.getElementById('toast-inner');
		const toastMsg = document.getElementById('toast-msg');
		const toastIcon = document.getElementById('toast-icon');
		if (!toast || !toastInner || !toastMsg || !toastIcon) return;

		toastMsg.innerText = msg;
		toastIcon.innerText = isError ? '✕' : '✓';
		toastInner.className = isError
			? 'px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-rose-600 text-white'
			: 'px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-gray-900 text-white';

		toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
		setTimeout(() => {
			toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
		}, 3000);
	}

	// Safe response parser
	async function parseJsonSafely(res: Response) {
		const contentType = res.headers.get('content-type') || '';
		if (!contentType.includes('application/json')) {
			if (res.status === 401 || res.redirected || res.url.includes('sign-in')) {
				return { success: false, error: 'Admin session required. Please sign in.' };
			}
			return { success: false, error: `Server returned status ${res.status}` };
		}
		try {
			return await res.json();
		} catch (e: any) {
			return { success: false, error: e?.message || 'Invalid server response.' };
		}
	}

	document.querySelectorAll('.btn-reject').forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			const target = e.currentTarget as HTMLElement;
			const id = target.getAttribute('data-id');
			const title = target.getAttribute('data-title') || 'site';
			if (!id) return;

			const reason = prompt(`Reason for unpublishing/rejecting "${title}":`, 'Removed from directory.');
			if (reason === null) return;

			try {
				const res = await fetch(`/api/admin/submissions/${id}/reject`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ reason }),
				});
				const data = await parseJsonSafely(res);
				if (res.ok && data.success) {
					showToast('Submission unpublished & rejected.');
					setTimeout(() => window.location.reload(), 700);
				} else {
					showToast(data.error || 'Failed to reject', true);
				}
			} catch (err: any) {
				showToast(err.message, true);
			}
		});
	});

	document.querySelectorAll('.btn-delete').forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			const target = e.currentTarget as HTMLElement;
			const id = target.getAttribute('data-id');
			const title = target.getAttribute('data-title') || 'this website';
			if (!id) return;

			if (!confirm(`Are you sure you want to permanently delete "${title}" from Neon DB?`)) return;

			try {
				const res = await fetch(`/api/admin/submissions/${id}`, {
					method: 'DELETE',
					headers: { 'Content-Type': 'application/json' },
				});
				const data = await parseJsonSafely(res);
				if (res.ok && data.success) {
					showToast('Submission deleted successfully!');
					setTimeout(() => window.location.reload(), 700);
				} else {
					showToast(data.error || 'Failed to delete submission', true);
				}
			} catch (err: any) {
				showToast(err.message, true);
			}
		});
	});
</script>


