---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { listSubmissions, getSubmissionStats } from '../../../../projects/clickfornothing/services/submissions.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

const requestUrl = new URL(Astro.request.url);
const search = requestUrl.searchParams.get('search') || undefined;
const page = parseInt(requestUrl.searchParams.get('page') || '1', 10);
const limit = 20;

const [submissionsData, stats] = await Promise.all([
	listSubmissions({ search, status: 'Published', page, limit, sort: 'newest' }),
	getSubmissionStats(),
]);

const { submissions, total, totalPages } = submissionsData;
---

<LayoutSidebar title="Published Websites | ClickForNothing Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			projectId="clickfornothing"
			activeTab="published"
			title="Published Live Submissions"
			subtitle="Websites currently live and publicly featured in the ClickForNothing directory."
		/>

		<!-- Published Banner -->
		<div class="p-4 mb-5 bg-emerald-50 border border-emerald-200 rounded-xl dark:bg-gray-800 dark:border-emerald-900/50 flex items-center justify-between">
			<div class="flex items-center space-x-3">
				<div class="p-2.5 bg-emerald-100 text-emerald-700 rounded-lg dark:bg-emerald-950 dark:text-emerald-300">
					🚀
				</div>
				<div>
					<h3 class="text-sm font-bold text-emerald-900 dark:text-emerald-200">
						{total} Live Directory Sites
					</h3>
					<p class="text-xs text-emerald-700 dark:text-emerald-400">
						All approved and live websites displayed on ClickForNothing.
					</p>
				</div>
			</div>
			<a
				href="https://clickfornothing.com"
				target="_blank"
				rel="noopener noreferrer"
				class="text-xs font-semibold text-emerald-800 hover:underline dark:text-emerald-300 inline-flex items-center"
			>
				Open Public Directory ↗
			</a>
		</div>

		<!-- Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700 overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-xs text-left text-gray-500 dark:text-gray-400">
					<thead class="text-[11px] text-gray-700 uppercase bg-gray-50 dark:bg-gray-700/50 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700">
						<tr>
							<th class="px-4 py-3 font-semibold">Live Site</th>
							<th class="px-4 py-3 font-semibold">Creator</th>
							<th class="px-4 py-3 font-semibold">Category</th>
							<th class="px-4 py-3 font-semibold">Published Date</th>
							<th class="px-4 py-3 font-semibold">Reviewed By</th>
							<th class="px-4 py-3 font-semibold text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							submissions.length === 0 ? (
								<tr>
									<td colspan="6" class="p-8 text-center text-gray-500 dark:text-gray-400">
										<div class="text-3xl mb-2">🌐</div>
										<div class="font-medium text-sm text-gray-900 dark:text-white">No published sites found.</div>
										<p class="text-xs text-gray-400 mt-1">Approve pending submissions to publish them to the directory.</p>
									</td>
								</tr>
							) : (
								submissions.map((sub) => (
									<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40 transition">
										<td class="px-4 py-3">
											<div class="font-bold text-gray-900 dark:text-white line-clamp-1">{sub.title}</div>
											<a
												href={sub.url}
												target="_blank"
												rel="noopener noreferrer"
												class="text-[11px] text-indigo-600 hover:underline dark:text-indigo-400 inline-flex items-center"
											>
												{sub.url}
												<svg class="w-2.5 h-2.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
												</svg>
											</a>
										</td>
										<td class="px-4 py-3">
											<div class="font-medium text-gray-900 dark:text-white">{sub.userName || 'Anonymous'}</div>
											<div class="text-[11px] text-gray-400">{sub.userEmail || sub.userId}</div>
										</td>
										<td class="px-4 py-3">
											<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
												{sub.category}
											</span>
										</td>
										<td class="px-4 py-3 text-emerald-600 font-medium">
											{sub.publishedAt ? new Date(sub.publishedAt).toLocaleDateString() : new Date(sub.updatedAt).toLocaleDateString()}
										</td>
										<td class="px-4 py-3 text-gray-500">
											{sub.reviewedBy || 'System Admin'}
										</td>
										<td class="px-4 py-3 text-right">
											<div class="inline-flex items-center space-x-1.5">
												<a
													href={sub.url}
													target="_blank"
													rel="noopener noreferrer"
													class="px-2.5 py-1 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition"
												>
													Visit Site ↗
												</a>
												<a
													href={url(`admin/projects/clickfornothing/submissions/${sub.id}`)}
													class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600"
												>
													Details
												</a>
											</div>
										</td>
									</tr>
								))
							)
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</LayoutSidebar>
