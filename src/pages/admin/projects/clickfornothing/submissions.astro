		<!-- ========================================================================= -->
		<!-- REJECTION REASON MODAL DIALOG (Requested in Section 4) -->
		<!-- ========================================================================= -->
		<div id="reject-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-gray-900/60 backdrop-blur-xs hidden">
			<div class="bg-white dark:bg-gray-800 rounded-xl max-w-md w-full p-5 shadow-2xl border border-gray-200 dark:border-gray-700">
				<div class="flex items-center justify-between mb-3">
					<h3 class="text-base font-bold text-gray-900 dark:text-white flex items-center">
						<span class="mr-2 text-rose-600">✕</span> Reject Submission
					</h3>
					<button type="button" id="reject-modal-close" class="text-gray-400 hover:text-gray-600 dark:hover:text-white">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<p class="text-xs text-gray-500 dark:text-gray-400 mb-3" id="reject-modal-sub-title">
					Please specify why this submission is being rejected. This explanation will be saved in the database for the submitter.
				</p>
				<div class="mb-4">
					<label for="rejection-reason-input" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">
						Rejection reason:
					</label>
					<textarea
						id="rejection-reason-input"
						rows="3"
						class="w-full p-2.5 text-xs text-gray-900 bg-gray-50 border border-gray-300 rounded-lg focus:ring-rose-500 focus:border-rose-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
						placeholder="e.g. Website URL returns 404, does not meet content guidelines, or contains broken features..."
					></textarea>
				</div>
				<div class="flex items-center justify-end space-x-2">
					<button
						type="button"
						id="reject-modal-cancel"
						class="px-3.5 py-2 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600"
					>
						Cancel
					</button>
					<button
						type="button"
						id="reject-modal-confirm"
						class="px-4 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-sm transition"
					>
						Reject Submission
					</button>
				</div>
			</div>
		</div>

		<!-- Toast Container -->
		<div id="toast" class="fixed bottom-5 right-5 z-50 transform transition-all duration-300 opacity-0 translate-y-2 pointer-events-none">
			<div class="px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-gray-900 text-white" id="toast-inner">
				<span id="toast-icon">✓</span>
				<span id="toast-msg">Action completed</span>
			</div>
		</div>
	</div>
</LayoutSidebar>

<script>
	let activeSubmissionId: string | null = null;
	const selectedIds = new Set<string>();

	// Toast helper
	function showToast(msg: string, isError = false) {
		const toast = document.getElementById('toast');
		const toastInner = document.getElementById('toast-inner');
		const toastMsg = document.getElementById('toast-msg');
		const toastIcon = document.getElementById('toast-icon');
		if (!toast || !toastInner || !toastMsg || !toastIcon) return;

		toastMsg.innerText = msg;
		toastIcon.innerText = isError ? '✕' : '✓';
		toastInner.className = isError
			? 'px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-rose-600 text-white'
			: 'px-4 py-3 rounded-lg shadow-lg text-xs font-semibold flex items-center space-x-2 bg-gray-900 text-white';

		toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
		setTimeout(() => {
			toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
		}, 3000);
	}

	// Drawer elements
	const drawer = document.getElementById('detail-drawer');
	const drawerBackdrop = document.getElementById('drawer-backdrop');
	const drawerCloseBtn = document.getElementById('drawer-close-btn');

	function openDrawer(sub: any) {
		activeSubmissionId = sub.id;
		(document.getElementById('drawer-title') as HTMLElement).innerText = sub.title;
		(document.getElementById('drawer-status-badge') as HTMLElement).innerText = sub.status;
		(document.getElementById('drawer-category') as HTMLElement).innerText = sub.category || 'General';
		(document.getElementById('drawer-description') as HTMLElement).innerText = sub.description || 'No description provided.';
		(document.getElementById('drawer-user-name') as HTMLElement).innerText = sub.userName || 'Anonymous';
		(document.getElementById('drawer-user-email') as HTMLElement).innerText = sub.userEmail || 'No email';
		(document.getElementById('drawer-user-id') as HTMLElement).innerText = sub.userId;
		(document.getElementById('drawer-created-date') as HTMLElement).innerText = new Date(sub.createdAt).toLocaleString();
		(document.getElementById('drawer-updated-date') as HTMLElement).innerText = new Date(sub.updatedAt).toLocaleString();

		// URL & Site preview
		const urlDisplay = document.getElementById('drawer-url-display') as HTMLElement;
		urlDisplay.innerText = sub.url;
		const openBtn = document.getElementById('drawer-open-site-btn') as HTMLAnchorElement;
		openBtn.href = sub.url;

		const permalink = document.getElementById('drawer-permalink-btn') as HTMLAnchorElement;
		permalink.href = `/admin/projects/clickfornothing/submissions/${sub.id}`;

		const previewImg = document.getElementById('drawer-preview-img') as HTMLImageElement;
		const previewPlaceholder = document.getElementById('drawer-preview-placeholder') as HTMLElement;
		const sitename = document.getElementById('drawer-preview-sitename') as HTMLElement;
		sitename.innerText = sub.title;

		if (sub.previewImageUrl) {
			previewImg.src = sub.previewImageUrl;
			previewImg.classList.remove('hidden');
			previewPlaceholder.classList.add('hidden');
		} else {
			previewImg.classList.add('hidden');
			previewPlaceholder.classList.remove('hidden');
		}

		// Rejection banner
		const rejBanner = document.getElementById('drawer-rejection-banner') as HTMLElement;
		const rejText = document.getElementById('drawer-rejection-text') as HTMLElement;
		if (sub.status === 'Rejected' && sub.rejectionReason) {
			rejText.innerText = sub.rejectionReason;
			rejBanner.classList.remove('hidden');
		} else {
			rejBanner.classList.add('hidden');
		}

		drawer?.classList.remove('hidden');
	}

	function closeDrawer() {
		drawer?.classList.add('hidden');
	}

	drawerCloseBtn?.addEventListener('click', closeDrawer);
	drawerBackdrop?.addEventListener('click', closeDrawer);

	// Attach click listeners to Inspect buttons
	document.querySelectorAll('.btn-inspect').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLElement;
			const data = JSON.parse(target.getAttribute('data-submission') || '{}');
			openDrawer(data);
		});
	});

	// Safe response parser that prevents Safari / WebKit pattern syntax errors on HTML/redirects
	async function parseJsonSafely(res: Response) {
		const contentType = res.headers.get('content-type') || '';
		if (!contentType.includes('application/json')) {
			if (res.status === 401 || res.redirected || res.url.includes('sign-in')) {
				return { success: false, error: 'Admin session required. Please sign in.' };
			}
			return { success: false, error: `Server returned status ${res.status}` };
		}
		try {
			return await res.json();
		} catch (e: any) {
			return { success: false, error: e?.message || 'Invalid server response.' };
		}
	}

	// Multi-route fallback dispatcher (tries universal action route, flat action route, dynamic subroute, and index route)
	async function sendSubmissionAction(id: string, action: 'approve' | 'publish' | 'reject' | 'delete', reason?: string) {
		try {
			// Primary 1: Universal flat action endpoint
			let res = await fetch('/api/admin/submissions/action', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ id, action, reason }),
			});

			// Primary 2: Flat action endpoint
			if (res.status === 404) {
				res = await fetch(`/api/admin/submissions/${action}`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, reason }),
				});
			}

			// Fallback 1: Dynamic subroute /api/admin/submissions/${id}/${action}
			if (res.status === 404) {
				if (action === 'delete') {
					res = await fetch(`/api/admin/submissions/${id}`, {
						method: 'DELETE',
						headers: { 'Content-Type': 'application/json' },
					});
				} else {
					res = await fetch(`/api/admin/submissions/${id}/${action}`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ reason }),
					});
				}
			}

			// Fallback 2: Index route /api/admin/submissions/${id}
			if (res.status === 404) {
				res = await fetch(`/api/admin/submissions/${id}`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ action, reason }),
				});
			}

			return await parseJsonSafely(res);
		} catch (err: any) {
			return { success: false, error: err?.message || 'Network request failed.' };
		}
	}

	// Actions: Approve
	async function approveSubmission(id: string) {
		const data = await sendSubmissionAction(id, 'approve');
		if (data && data.success) {
			showToast('Submission approved successfully!');
			setTimeout(() => window.location.reload(), 800);
		} else {
			showToast(data.error || 'Failed to approve', true);
		}
	}

	// Actions: Publish
	async function publishSubmission(id: string) {
		const data = await sendSubmissionAction(id, 'publish');
		if (data && data.success) {
			showToast('Submission published live!');
			setTimeout(() => window.location.reload(), 800);
		} else {
			showToast(data.error || 'Failed to publish', true);
		}
	}

	// Actions: Delete
	async function deleteSubmission(id: string) {
		if (!confirm('Are you sure you want to permanently delete this submission from Neon DB?')) return;
		const data = await sendSubmissionAction(id, 'delete');
		if (data && data.success) {
			showToast('Submission deleted successfully!');
			closeDrawer();
			const row = document.getElementById(`row-${id}`);
			if (row) row.remove();
			setTimeout(() => window.location.reload(), 800);
		} else {
			showToast(data.error || 'Failed to delete submission', true);
		}
	}

	// Actions: Reject Modal
	const rejectModal = document.getElementById('reject-modal');
	const rejectModalClose = document.getElementById('reject-modal-close');
	const rejectModalCancel = document.getElementById('reject-modal-cancel');
	const rejectModalConfirm = document.getElementById('reject-modal-confirm');
	const rejectionInput = document.getElementById('rejection-reason-input') as HTMLTextAreaElement;
	let rejectingTargetId: string | null = null;

	function openRejectModal(id: string, title?: string) {
		rejectingTargetId = id;
		const subTitleEl = document.getElementById('reject-modal-sub-title');
		if (subTitleEl && title) {
			subTitleEl.innerText = `Rejecting: "${title}". State reason below:`;
		}
		if (rejectionInput) rejectionInput.value = '';
		rejectModal?.classList.remove('hidden');
	}

	function closeRejectModal() {
		rejectModal?.classList.add('hidden');
		rejectingTargetId = null;
	}

	rejectModalClose?.addEventListener('click', closeRejectModal);
	rejectModalCancel?.addEventListener('click', closeRejectModal);

	rejectModalConfirm?.addEventListener('click', async () => {
		if (!rejectingTargetId) return;
		const reason = rejectionInput?.value?.trim() || 'Submission does not meet directory quality standards.';
		const data = await sendSubmissionAction(rejectingTargetId, 'reject', reason);
		if (data && data.success) {
			showToast('Submission rejected.');
			closeRejectModal();
			setTimeout(() => window.location.reload(), 800);
		} else {
			showToast(data.error || 'Failed to reject', true);
		}
	});


	// Quick button bindings
	document.querySelectorAll('.btn-quick-approve').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
			if (id) approveSubmission(id);
		});
	});

	document.querySelectorAll('.btn-quick-reject').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLElement;
			const id = target.getAttribute('data-id');
			const title = target.getAttribute('data-title') || undefined;
			if (id) openRejectModal(id, title);
		});
	});

	document.querySelectorAll('.btn-quick-publish').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
			if (id) publishSubmission(id);
		});
	});

	document.querySelectorAll('.btn-quick-delete').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
			if (id) deleteSubmission(id);
		});
	});

	// Drawer action bindings
	document.getElementById('drawer-approve-btn')?.addEventListener('click', () => {
		if (activeSubmissionId) approveSubmission(activeSubmissionId);
	});
	document.getElementById('drawer-publish-btn')?.addEventListener('click', () => {
		if (activeSubmissionId) publishSubmission(activeSubmissionId);
	});
	document.getElementById('drawer-delete-btn')?.addEventListener('click', () => {
		if (activeSubmissionId) deleteSubmission(activeSubmissionId);
	});
	document.getElementById('drawer-reject-btn')?.addEventListener('click', () => {
		if (activeSubmissionId) {
			closeDrawer();
			openRejectModal(activeSubmissionId);
		}
	});

	// Bulk Selection
	const selectAll = document.getElementById('select-all-checkbox') as HTMLInputElement;
	const bulkBar = document.getElementById('bulk-bar');
	const bulkCount = document.getElementById('bulk-selected-count');

	function updateBulkState() {
		const count = selectedIds.size;
		if (bulkCount) bulkCount.innerText = count.toString();
		if (count > 0) {
			bulkBar?.classList.remove('hidden');
		} else {
			bulkBar?.classList.add('hidden');
		}
	}

	document.querySelectorAll('.submission-checkbox').forEach((cb) => {
		cb.addEventListener('change', (e) => {
			const box = e.target as HTMLInputElement;
			if (box.checked) {
				selectedIds.add(box.value);
			} else {
				selectedIds.delete(box.value);
			}
			updateBulkState();
		});
	});

	selectAll?.addEventListener('change', () => {
		document.querySelectorAll('.submission-checkbox').forEach((cb) => {
			const box = cb as HTMLInputElement;
			box.checked = selectAll.checked;
			if (selectAll.checked) {
				selectedIds.add(box.value);
			} else {
				selectedIds.delete(box.value);
			}
		});
		updateBulkState();
	});

	document.getElementById('btn-bulk-clear')?.addEventListener('click', () => {
		selectedIds.clear();
		if (selectAll) selectAll.checked = false;
		document.querySelectorAll('.submission-checkbox').forEach((cb) => {
			(cb as HTMLInputElement).checked = false;
		});
		updateBulkState();
	});

	document.getElementById('btn-bulk-approve')?.addEventListener('click', async () => {
		if (selectedIds.size === 0) return;
		if (!confirm(`Are you sure you want to approve ${selectedIds.size} selected submissions?`)) return;

		try {
			const res = await fetch('/api/admin/submissions/bulk', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ action: 'approve', ids: Array.from(selectedIds) }),
			});
			const data = await parseJsonSafely(res);
			if (res.ok && data.success) {
				showToast(`Bulk approved ${data.affectedCount} submissions!`);
				setTimeout(() => window.location.reload(), 900);
			} else {
				showToast(data.error || 'Bulk approve failed', true);
			}
		} catch (err: any) {
			showToast(err.message, true);
		}
	});

	document.getElementById('btn-bulk-publish')?.addEventListener('click', async () => {
		if (selectedIds.size === 0) return;
		if (!confirm(`Are you sure you want to publish ${selectedIds.size} selected submissions live?`)) return;

		try {
			const res = await fetch('/api/admin/submissions/bulk', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ action: 'publish', ids: Array.from(selectedIds) }),
			});
			const data = await parseJsonSafely(res);
			if (res.ok && data.success) {
				showToast(`Bulk published ${data.affectedCount} submissions!`);
				setTimeout(() => window.location.reload(), 900);
			} else {
				showToast(data.error || 'Bulk publish failed', true);
			}
		} catch (err: any) {
			showToast(err.message, true);
		}
	});

	document.getElementById('btn-bulk-reject')?.addEventListener('click', async () => {
		if (selectedIds.size === 0) return;
		const reason = prompt(`Enter rejection reason for ${selectedIds.size} selected submissions:`, 'Does not meet directory quality guidelines.');
		if (reason === null) return;

		try {
			const res = await fetch('/api/admin/submissions/bulk', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ action: 'reject', ids: Array.from(selectedIds), reason }),
			});
			const data = await parseJsonSafely(res);
			if (res.ok && data.success) {
				showToast(`Bulk rejected ${data.affectedCount} submissions!`);
				setTimeout(() => window.location.reload(), 900);
			} else {
				showToast(data.error || 'Bulk reject failed', true);
			}
		} catch (err: any) {
			showToast(err.message, true);
		}
	});

	document.getElementById('btn-bulk-delete')?.addEventListener('click', async () => {
		if (selectedIds.size === 0) return;
		if (!confirm(`Are you sure you want to permanently delete ${selectedIds.size} selected submissions from Neon DB? This cannot be undone.`)) return;

		try {
			const res = await fetch('/api/admin/submissions/bulk', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ action: 'delete', ids: Array.from(selectedIds) }),
			});
			const data = await parseJsonSafely(res);
			if (res.ok && data.success) {
				showToast(`Bulk deleted ${data.affectedCount} submissions!`);
				setTimeout(() => window.location.reload(), 900);
			} else {
				showToast(data.error || 'Bulk delete failed', true);
			}
		} catch (err: any) {
			showToast(err.message, true);
		}
	});

</script>

