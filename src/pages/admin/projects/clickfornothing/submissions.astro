							>
								✓ Approve
							</button>
							<button
								type="button"
								id="drawer-publish-btn"
								class="px-3.5 py-2 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-lg shadow-sm transition"
