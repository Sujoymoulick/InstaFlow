---
import LayoutSidebar from '../../../../app/LayoutSidebar.astro';
import ProjectHeader from '../../../../components/admin/ProjectHeader.astro';
import { listSubmissions, getSubmissionStats } from '../../../../projects/clickfornothing/services/submissions.js';
import { url } from '../../../../lib/data.js';

export const prerender = false;

// Query params for server-side initial rendering
const requestUrl = new URL(Astro.request.url);
const search = requestUrl.searchParams.get('search') || undefined;
const status = requestUrl.searchParams.get('status') || undefined;
const category = requestUrl.searchParams.get('category') || undefined;
const dateRange = (requestUrl.searchParams.get('dateRange') as any) || 'all';
const sort = (requestUrl.searchParams.get('sort') as any) || 'newest';
const page = parseInt(requestUrl.searchParams.get('page') || '1', 10);
const limit = 15;

const [submissionsData, stats] = await Promise.all([
	listSubmissions({ search, status, category, dateRange, sort, page, limit }),
	getSubmissionStats(),
]);

const { submissions, total, totalPages } = submissionsData;
---

<LayoutSidebar title="Submissions Management | ClickForNothing Admin">
	<div class="px-4 pt-6 pb-12">
		<ProjectHeader
			projectId="clickfornothing"
			activeTab="submissions"
			title="Submissions Management"
			subtitle="Inspect, preview, approve, reject, and publish user-submitted websites."
		/>

		<!-- Quick Metric Badges Bar -->
		<div class="flex flex-wrap items-center gap-2 mb-4">
			<a
				href={url('admin/projects/clickfornothing/submissions')}
				class={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center transition ${
					!status || status === 'all'
						? 'bg-indigo-600 text-white shadow-sm'
						: 'bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700'
				}`}
			>
				All Submissions <span class="ml-1.5 px-1.5 py-0.2 bg-white/20 rounded-full text-[10px]">{stats.totalSubmissions}</span>
			</a>
			<a
				href={url('admin/projects/clickfornothing/submissions?status=Pending+Review')}
				class={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center transition ${
					status === 'Pending Review'
						? 'bg-amber-500 text-white shadow-sm'
						: 'bg-white text-amber-700 hover:bg-amber-50 border border-amber-200 dark:bg-gray-800 dark:text-amber-400 dark:border-gray-700'
				}`}
			>
				Pending Review <span class="ml-1.5 px-1.5 py-0.2 bg-amber-100 text-amber-900 rounded-full text-[10px]">{stats.pendingReview}</span>
			</a>
			<a
				href={url('admin/projects/clickfornothing/submissions?status=Approved')}
				class={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center transition ${
					status === 'Approved'
						? 'bg-sky-600 text-white shadow-sm'
						: 'bg-white text-sky-700 hover:bg-sky-50 border border-sky-200 dark:bg-gray-800 dark:text-sky-400 dark:border-gray-700'
				}`}
			>
				Approved <span class="ml-1.5 px-1.5 py-0.2 bg-sky-100 text-sky-900 rounded-full text-[10px]">{stats.approved}</span>
			</a>
			<a
				href={url('admin/projects/clickfornothing/submissions?status=Published')}
				class={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center transition ${
					status === 'Published'
						? 'bg-emerald-600 text-white shadow-sm'
						: 'bg-white text-emerald-700 hover:bg-emerald-50 border border-emerald-200 dark:bg-gray-800 dark:text-emerald-400 dark:border-gray-700'
				}`}
			>
				Published <span class="ml-1.5 px-1.5 py-0.2 bg-emerald-100 text-emerald-900 rounded-full text-[10px]">{stats.published}</span>
			</a>
			<a
				href={url('admin/projects/clickfornothing/submissions?status=Rejected')}
				class={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center transition ${
					status === 'Rejected'
						? 'bg-rose-600 text-white shadow-sm'
						: 'bg-white text-rose-700 hover:bg-rose-50 border border-rose-200 dark:bg-gray-800 dark:text-rose-400 dark:border-gray-700'
				}`}
			>
				Rejected <span class="ml-1.5 px-1.5 py-0.2 bg-rose-100 text-rose-900 rounded-full text-[10px]">{stats.rejected}</span>
			</a>
		</div>

		<!-- Search, Filters, and Bulk Controls Card -->
		<div class="p-4 mb-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700">
			<form id="filter-form" method="GET" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-12 items-center">
				<!-- Search -->
				<div class="lg:col-span-5 relative">
					<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</div>
					<input
						type="text"
						name="search"
						value={search || ''}
						placeholder="Search by title, URL, description, or submitter email..."
						class="w-full pl-9 pr-3 py-2 text-xs text-gray-900 bg-gray-50 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
					/>
				</div>

				<!-- Status Filter -->
				<div class="lg:col-span-2">
					<select
						name="status"
						class="w-full py-2 px-2.5 text-xs text-gray-900 bg-gray-50 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
					>
						<option value="all" selected={!status || status === 'all'}>All Statuses</option>
						<option value="Pending Review" selected={status === 'Pending Review'}>Pending Review</option>
						<option value="Approved" selected={status === 'Approved'}>Approved</option>
						<option value="Published" selected={status === 'Published'}>Published</option>
						<option value="Rejected" selected={status === 'Rejected'}>Rejected</option>
					</select>
				</div>

				<!-- Date Filter -->
				<div class="lg:col-span-2">
					<select
						name="dateRange"
						class="w-full py-2 px-2.5 text-xs text-gray-900 bg-gray-50 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
					>
						<option value="all" selected={dateRange === 'all'}>All Time</option>
						<option value="today" selected={dateRange === 'today'}>Today</option>
						<option value="7d" selected={dateRange === '7d'}>Past 7 Days</option>
						<option value="30d" selected={dateRange === '30d'}>Past 30 Days</option>
					</select>
				</div>

				<!-- Sort -->
				<div class="lg:col-span-2">
					<select
						name="sort"
						class="w-full py-2 px-2.5 text-xs text-gray-900 bg-gray-50 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
					>
						<option value="newest" selected={sort === 'newest'}>Newest First</option>
						<option value="oldest" selected={sort === 'oldest'}>Oldest First</option>
						<option value="title_asc" selected={sort === 'title_asc'}>Title (A - Z)</option>
						<option value="title_desc" selected={sort === 'title_desc'}>Title (Z - A)</option>
					</select>
				</div>

				<!-- Filter Submit & Reset -->
				<div class="lg:col-span-1 flex items-center space-x-1">
					<button
						type="submit"
						class="w-full py-2 px-3 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition"
					>
						Filter
					</button>
				</div>
			</form>

			<!-- Bulk Actions Bar -->
			<div id="bulk-bar" class="hidden mt-3 pt-3 border-t border-gray-200 dark:border-gray-700 flex flex-wrap items-center justify-between gap-2">
				<div class="text-xs font-medium text-gray-700 dark:text-gray-300 flex items-center">
					<span id="bulk-selected-count" class="font-bold text-indigo-600 dark:text-indigo-400 mr-1.5">0</span> submissions selected
				</div>
				<div class="flex items-center space-x-2">
					<button
						type="button"
						id="btn-bulk-approve"
						class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm transition"
					>
						<svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
						</svg>
						Approve Selected
					</button>
					<button
						type="button"
						id="btn-bulk-publish"
						class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-lg shadow-sm transition"
					>
						<svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
						Publish Selected
					</button>
					<button
						type="button"
						id="btn-bulk-reject"
						class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-sm transition"
					>
						<svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
						Reject Selected
					</button>
					<button
						type="button"
						id="btn-bulk-delete"
						class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-red-700 hover:bg-red-800 rounded-lg shadow-sm transition"
					>
						<svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
						Delete Selected
					</button>
					<button
						type="button"
						id="btn-bulk-clear"
						class="px-2.5 py-1.5 text-xs text-gray-500 hover:text-gray-700 dark:text-gray-400"
					>
						Cancel
					</button>
				</div>
			</div>
		</div>

		<!-- Submissions Data Table -->
		<div class="bg-white border border-gray-200 rounded-xl shadow-sm dark:bg-gray-800 dark:border-gray-700 overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-xs text-left text-gray-500 dark:text-gray-400">
					<thead class="text-[11px] text-gray-700 uppercase bg-gray-50 dark:bg-gray-700/50 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700">
						<tr>
							<th class="p-3 w-4">
								<input
									type="checkbox"
									id="select-all-checkbox"
									class="w-4 h-4 text-indigo-600 bg-gray-100 border-gray-300 rounded focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600"
								/>
							</th>
							<th class="px-3 py-3 font-semibold">Submission ID</th>
							<th class="px-3 py-3 font-semibold">User</th>
							<th class="px-3 py-3 font-semibold">Username / Email</th>
							<th class="px-3 py-3 font-semibold">Title / Name</th>
							<th class="px-3 py-3 font-semibold">Status</th>
							<th class="px-3 py-3 font-semibold">Submitted Date</th>
							<th class="px-3 py-3 font-semibold">Last Updated</th>
							<th class="px-3 py-3 font-semibold text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							submissions.length === 0 ? (
								<tr>
									<td colspan="9" class="p-8 text-center text-gray-500 dark:text-gray-400">
										<div class="text-3xl mb-2">🔍</div>
										<div class="font-medium">No submissions matched the selected filters.</div>
										<p class="text-xs text-gray-400 mt-1">Try broadening your search term or clearing the status filter.</p>
										<a
											href={url('admin/projects/clickfornothing/submissions')}
											class="inline-block mt-3 px-3 py-1.5 text-xs text-indigo-600 hover:underline dark:text-indigo-400"
										>
											Clear All Filters
										</a>
									</td>
								</tr>
							) : (
								submissions.map((sub) => {
									let statusBadge = 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
									if (sub.status === 'Pending Review') statusBadge = 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 border border-amber-300';
									else if (sub.status === 'Approved') statusBadge = 'bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300 border border-sky-300';
									else if (sub.status === 'Published') statusBadge = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-300';
									else if (sub.status === 'Rejected') statusBadge = 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300 border border-rose-300';

									const shortId = sub.id.startsWith('cfn-') ? sub.id : '#' + sub.id;

									return (
										<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40 transition group" data-id={sub.id} id={`row-${sub.id}`}>
											<td class="p-3 w-4">
												<input
													type="checkbox"
													class="submission-checkbox w-4 h-4 text-indigo-600 bg-gray-100 border-gray-300 rounded focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600"
													value={sub.id}
												/>
											</td>
											<td class="px-3 py-3 font-mono font-medium text-gray-900 dark:text-white">
												{shortId}
											</td>
											<td class="px-3 py-3">
												<div class="flex items-center space-x-2">
													{sub.userAvatarUrl ? (
														<img src={sub.userAvatarUrl} alt="" class="w-6 h-6 rounded-full object-cover flex-shrink-0" />
													) : (
														<div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 dark:bg-gray-700 dark:text-indigo-300 flex items-center justify-center font-bold text-[10px] flex-shrink-0">
															{(sub.userName || 'U')[0].toUpperCase()}
														</div>
													)}
													<div class="font-medium text-gray-900 dark:text-white line-clamp-1">
														{sub.userName || 'Anonymous'}
													</div>
												</div>
											</td>
											<td class="px-3 py-3 text-gray-600 dark:text-gray-300">
												<div class="line-clamp-1">{sub.userEmail || sub.userId}</div>
											</td>
											<td class="px-3 py-3">
												<div class="font-semibold text-gray-900 dark:text-white line-clamp-1">
													{sub.title}
												</div>
												<a
													href={sub.url}
													target="_blank"
													rel="noopener noreferrer"
													class="text-[11px] text-indigo-600 hover:underline dark:text-indigo-400 inline-flex items-center line-clamp-1"
												>
													{sub.url.replace(/^https?:\/\//, '')}
													<svg class="w-2.5 h-2.5 ml-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
													</svg>
												</a>
											</td>
											<td class="px-3 py-3">
												<span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ${statusBadge}`}>
													{sub.status}
												</span>
											</td>
											<td class="px-3 py-3 text-gray-500 whitespace-nowrap">
												{new Date(sub.createdAt).toLocaleDateString()}
											</td>
											<td class="px-3 py-3 text-gray-500 whitespace-nowrap">
												{new Date(sub.updatedAt).toLocaleDateString()}
											</td>
											<td class="px-3 py-3 text-right whitespace-nowrap">
												<div class="inline-flex items-center space-x-1">
													<!-- Inspect Drawer Button -->
													<button
														type="button"
														class="btn-inspect px-2 py-1 text-[11px] font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-900/40 dark:text-indigo-300 rounded transition"
														data-submission={JSON.stringify(sub)}
													>
														Inspect
													</button>

													<!-- Quick Approve (if not Approved) -->
													{sub.status !== 'Approved' && (
														<button
															type="button"
															class="btn-quick-approve px-2 py-1 text-[11px] font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-900/40 dark:text-emerald-300 rounded transition"
															data-id={sub.id}
															title="Approve Submission"
														>
															Approve
														</button>
													)}

													<!-- Quick Publish (if not Published) -->
													{sub.status !== 'Published' && (
														<button
															type="button"
															class="btn-quick-publish px-2 py-1 text-[11px] font-medium text-purple-700 bg-purple-50 hover:bg-purple-100 dark:bg-purple-900/40 dark:text-purple-300 rounded transition"
															data-id={sub.id}
															title="Publish Live"
														>
															Publish
														</button>
													)}

													<!-- Quick Reject (if not Rejected) -->
													{sub.status !== 'Rejected' && (
														<button
															type="button"
															class="btn-quick-reject px-2 py-1 text-[11px] font-medium text-rose-700 bg-rose-50 hover:bg-rose-100 dark:bg-rose-900/40 dark:text-rose-300 rounded transition"
															data-id={sub.id}
															data-title={sub.title}
															title="Reject Submission"
														>
															Reject
														</button>
													)}

													<!-- Quick Delete -->
													<button
														type="button"
														class="btn-quick-delete px-2 py-1 text-[11px] font-medium text-red-700 bg-red-50 hover:bg-red-100 dark:bg-red-950/40 dark:text-red-400 rounded transition"
														data-id={sub.id}
														data-title={sub.title}
														title="Delete Submission Permanently"
													>
														Delete
													</button>
												</div>
											</td>
										</tr>
									);
								})
							)
						}
					</tbody>
				</table>
			</div>


			<!-- Pagination Footer -->
			<div class="p-3 bg-gray-50 border-t border-gray-200 dark:bg-gray-800 dark:border-gray-700 flex items-center justify-between">
				<div class="text-xs text-gray-500 dark:text-gray-400">
					Showing <span class="font-semibold text-gray-900 dark:text-white">{submissions.length}</span> of <span class="font-semibold text-gray-900 dark:text-white">{total}</span> submissions
				</div>
				<div class="flex items-center space-x-2">
					{page > 1 && (
						<a
							href={url(`admin/projects/clickfornothing/submissions?page=${page - 1}${status ? `&status=${status}` : ''}${search ? `&search=${search}` : ''}`)}
							class="px-2.5 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600"
						>
							← Previous
						</a>
					)}
					<span class="text-xs text-gray-600 dark:text-gray-400">
						Page {page} of {totalPages || 1}
					</span>
					{page < totalPages && (
						<a
							href={url(`admin/projects/clickfornothing/submissions?page=${page + 1}${status ? `&status=${status}` : ''}${search ? `&search=${search}` : ''}`)}
							class="px-2.5 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600"
						>
							Next →
						</a>
					)}
				</div>
			</div>
		</div>

		<!-- ========================================================================= -->
		<!-- COMPLETE SUBMISSION DETAIL & PREVIEW DRAWER (SLIDE OVER) -->
		<!-- ========================================================================= -->
		<div id="detail-drawer" class="fixed inset-0 z-50 overflow-hidden hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
			<div class="absolute inset-0 bg-gray-900/60 backdrop-blur-xs transition-opacity" id="drawer-backdrop"></div>

			<div class="fixed inset-y-0 right-0 pl-10 max-w-full flex">
				<div class="w-screen max-w-xl bg-white dark:bg-gray-800 shadow-2xl flex flex-col">
					<!-- Drawer Header -->
					<div class="p-5 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between bg-gray-50 dark:bg-gray-800/80">
						<div>
							<span id="drawer-status-badge" class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800">
								Pending Review
							</span>
							<h3 id="drawer-title" class="text-lg font-bold text-gray-900 dark:text-white mt-1">
								Submission Title
							</h3>
						</div>
						<button type="button" id="drawer-close-btn" class="p-1.5 text-gray-400 hover:text-gray-600 dark:hover:text-white rounded-lg">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>

					<!-- Drawer Body (Scrollable) -->
					<div class="flex-1 overflow-y-auto p-5 space-y-6">
						<!-- 1. Interactive Preview Section (Requested in Section 3 & 11) -->
						<div class="p-4 bg-gray-50 border border-gray-200 rounded-xl dark:bg-gray-700/40 dark:border-gray-700">
							<div class="flex items-center justify-between mb-3">
								<h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 flex items-center">
