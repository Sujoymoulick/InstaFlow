									<span class="text-gray-400 block text-[10px]">Authoritative Clerk User ID</span>
									<span id="drawer-user-id" class="font-mono text-indigo-600 dark:text-indigo-400 font-semibold">user_2bF8zX9kL3p0Qm1W</span>
