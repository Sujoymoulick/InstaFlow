						</div>

						<!-- 4. Rejection Reason Banner (if rejected) -->
						<div id="drawer-rejection-banner" class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 dark:bg-rose-950/50 dark:border-rose-900 dark:text-rose-200 text-xs">
