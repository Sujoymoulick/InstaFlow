---
import LayoutSidebar from '../../app/LayoutSidebar.astro';
import { getProjects, getProjectMetrics, VALID_PROJECT_STATUSES } from '../../services/projects.js';
import { PROJECT_REGISTRY } from '../../projects/registry.js';
import { url } from '../../lib/data.js';

export const prerender = false;

const [projects, metrics] = await Promise.all([
	getProjects(),
	getProjectMetrics(),
]);

const categories = Array.from(new Set(projects.map((p) => p.category).filter(Boolean)));
---

<LayoutSidebar>
	<div class="px-4 pt-6 pb-12">
		<!-- Breadcrumbs & Header -->
		<div class="mb-6">
			<nav class="flex mb-4" aria-label="Breadcrumb">
				<ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
					<li class="inline-flex items-center">
						<a
							href={url()}
							class="inline-flex items-center text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-white"
						>
							<svg
								class="w-5 h-5 mr-2.5"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
								></path>
							</svg>
							Home
						</a>
					</li>
					<li>
						<div class="flex items-center">
							<svg
								class="w-6 h-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"
								></path>
							</svg>
							<a
								href={url('dashboard')}
								class="ml-1 text-gray-700 hover:text-primary-600 md:ml-2 dark:text-gray-300 dark:hover:text-white"
							>
								Dashboard
							</a>
						</div>
					</li>
					<li>
						<div class="flex items-center">
							<svg
								class="w-6 h-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"
								></path>
							</svg>
							<span class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500" aria-current="page">
								Projects
							</span>
						</div>
					</li>
				</ol>
			</nav>

			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
						Personal Projects Overview
					</h1>
					<p class="text-sm font-normal text-gray-500 dark:text-gray-400">
						Track websites, SaaS products, tools, and applications directly from your InstaFlow dashboard.
					</p>
				</div>
				<div class="flex items-center space-x-3">
					<button
						id="open-add-project-btn"
						type="button"
						class="inline-flex items-center justify-center px-4 py-2.5 text-sm font-medium text-white bg-primary-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800 shadow-sm"
					>
						<svg
							class="w-4 h-4 mr-2"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						Add Project
					</button>
				</div>
			</div>
		</div>

		<!-- 6 Summary Cards -->
		<div class="grid w-full grid-cols-2 gap-4 mb-6 sm:grid-cols-3 lg:grid-cols-6">
			<!-- Total Projects -->
			<div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Total</span>
						<h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1" id="stat-total">
							{metrics.total}
						</h3>
					</div>
					<div class="p-2.5 bg-blue-50 rounded-lg text-primary-600 dark:bg-gray-700 dark:text-primary-400">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
						</svg>
					</div>
				</div>
			</div>

			<!-- Published -->
			<div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Published</span>
						<h3 class="text-2xl font-bold text-green-600 dark:text-green-400 mt-1" id="stat-published">
							{metrics.published}
						</h3>
					</div>
					<div class="p-2.5 bg-green-50 rounded-lg text-green-600 dark:bg-gray-700 dark:text-green-400">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</div>
				</div>
			</div>

			<!-- In Development -->
			<div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">In Development</span>
						<h3 class="text-2xl font-bold text-yellow-600 dark:text-yellow-400 mt-1" id="stat-development">
							{metrics.inDevelopment}
						</h3>
					</div>
					<div class="p-2.5 bg-yellow-50 rounded-lg text-yellow-600 dark:bg-gray-700 dark:text-yellow-400">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
						</svg>
					</div>
				</div>
			</div>

			<!-- Planning -->
			<div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Planning</span>
						<h3 class="text-2xl font-bold text-indigo-600 dark:text-indigo-400 mt-1" id="stat-planning">
							{metrics.planning}
						</h3>
					</div>
					<div class="p-2.5 bg-indigo-50 rounded-lg text-indigo-600 dark:bg-gray-700 dark:text-indigo-400">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
						</svg>
					</div>
				</div>
			</div>

			<!-- On Hold -->
			<div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">On Hold</span>
						<h3 class="text-2xl font-bold text-gray-700 dark:text-gray-300 mt-1" id="stat-onhold">
							{metrics.onHold}
						</h3>
					</div>
					<div class="p-2.5 bg-gray-100 rounded-lg text-gray-600 dark:bg-gray-700 dark:text-gray-400">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</div>
				</div>
			</div>

			<!-- Completed -->
			<div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Completed</span>
						<h3 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mt-1" id="stat-completed">
							{metrics.completed}
						</h3>
					</div>
					<div class="p-2.5 bg-emerald-50 rounded-lg text-emerald-600 dark:bg-gray-700 dark:text-emerald-400">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
						</svg>
					</div>
				</div>
			</div>
		</div>

		<!-- Filters & Search Toolbar -->
		<div class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-5">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<!-- Search -->
				<div class="relative w-full md:w-80">
					<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
						<svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<input
						type="text"
						id="project-search"
						class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full pl-9 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
						placeholder="Search projects, stack, category..."
					/>
				</div>

				<!-- Filters -->
				<div class="flex flex-wrap items-center gap-3">
					<!-- Status Filter -->
					<div class="flex items-center space-x-2">
						<label for="filter-status" class="text-xs font-medium text-gray-500 dark:text-gray-400">Status:</label>
						<select
							id="filter-status"
							class="bg-gray-50 border border-gray-300 text-gray-900 text-xs rounded-lg focus:ring-primary-500 focus:border-primary-500 block p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
						>
							<option value="All">All Statuses</option>
							{VALID_PROJECT_STATUSES.map((st) => (
								<option value={st}>{st}</option>
							))}
						</select>
					</div>

					<!-- Category Filter -->
					{categories.length > 0 && (
						<div class="flex items-center space-x-2">
							<label for="filter-category" class="text-xs font-medium text-gray-500 dark:text-gray-400">Category:</label>
							<select
								id="filter-category"
								class="bg-gray-50 border border-gray-300 text-gray-900 text-xs rounded-lg focus:ring-primary-500 focus:border-primary-500 block p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
							>
								<option value="All">All Categories</option>
								{categories.map((cat) => (
									<option value={cat}>{cat}</option>
								))}
							</select>
						</div>
					)}
				</div>
			</div>
		</div>

		<!-- Projects List or Empty State -->
		<div id="projects-container">
			{
				projects.length === 0 ? (
					<div class="p-8 text-center bg-white border-2 border-dashed border-gray-200 dark:border-gray-700 rounded-lg dark:bg-gray-800">
						<svg
							class="w-16 h-16 mx-auto text-gray-400 dark:text-gray-600 mb-4"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="1.5"
								d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
							></path>
						</svg>
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">No projects yet</h3>
						<p class="max-w-md mx-auto mt-1 mb-5 text-sm text-gray-500 dark:text-gray-400">
							Keep all your personal websites, SaaS products, developer tools, and micro-apps organized in one place with live status tracking.
						</p>
						<button
							type="button"
							class="open-add-project-btn-empty inline-flex items-center justify-center px-4 py-2.5 text-sm font-medium text-white bg-primary-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800"
						>
							<svg
								class="w-4 h-4 mr-2"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							Add Your First Project
						</button>
					</div>
				) : (
					<div class="bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800 overflow-hidden">
						<div class="overflow-x-auto">
							<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
								<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
									<tr>
										<th scope="col" class="px-5 py-3.5">Project</th>
										<th scope="col" class="px-4 py-3.5">Category</th>
										<th scope="col" class="px-4 py-3.5">Status</th>
										<th scope="col" class="px-4 py-3.5">Tech Stack</th>
										<th scope="col" class="px-4 py-3.5">Links</th>
										<th scope="col" class="px-4 py-3.5">Updated</th>
										<th scope="col" class="px-4 py-3.5 text-right">Actions</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
									{projects.map((project) => {
										const statusClass =
											project.status === 'Published'
												? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300 border-green-200'
												: project.status === 'In Development'
												? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300 border-yellow-200'
												: project.status === 'Testing'
												? 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300 border-purple-200'
												: project.status === 'Completed'
												? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-300 border-emerald-200'
												: project.status === 'On Hold'
												? 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300 border-gray-300'
												: project.status === 'Archived'
												? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300 border-red-200'
												: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-300 border-indigo-200';

										const techArray = Array.isArray(project.technologies) ? project.technologies : [];
										const regMatch = PROJECT_REGISTRY.find(
											(r) =>
												r.slug === project.slug ||
												r.name.toLowerCase() === project.name.toLowerCase() ||
												project.name.toLowerCase().includes('send virtual gift') ||
												project.name.toLowerCase().includes('sendvirtualgift') ||
												(project.liveUrl && project.liveUrl.includes('sendvirtualgift.com'))
										);

										return (
											<tr
												class="project-row hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"
												data-name={project.name.toLowerCase()}
												data-category={project.category.toLowerCase()}
												data-status={project.status}
												data-tech={techArray.join(' ').toLowerCase()}
												data-desc={(project.description || '').toLowerCase()}
											>
												<td class="px-5 py-4 font-medium text-gray-900 dark:text-white">
													<div class="flex items-center space-x-3.5">
														{project.logoUrl ? (
															<img
																src={project.logoUrl}
																alt={project.name}
																class="w-10 h-10 rounded-lg object-cover border border-gray-200 dark:border-gray-700 flex-shrink-0"
																loading="lazy"
															/>
														) : (
															<div class="w-10 h-10 rounded-lg bg-primary-100 text-primary-700 dark:bg-primary-900 dark:text-primary-300 flex items-center justify-center font-bold text-base flex-shrink-0 border border-primary-200 dark:border-primary-800">
																{project.name.charAt(0).toUpperCase()}
															</div>
														)}
														<div class="min-w-0 flex-1">
															<div class="flex items-center space-x-2">
																{regMatch ? (
																	<a
																		href={url(regMatch.routePrefix + '/overview')}
																		class="font-semibold text-gray-900 hover:text-primary-600 dark:text-white dark:hover:text-primary-400 transition-colors truncate"
																	>
																		{project.name}
																	</a>
																) : (
																	<span class="font-semibold text-gray-900 dark:text-white truncate">
																		{project.name}
																	</span>
																)}
																{regMatch && (
																	<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-primary-100 text-primary-800 dark:bg-primary-950 dark:text-primary-300 border border-primary-200 dark:border-primary-800 flex-shrink-0">
																		Admin Connected
																	</span>
																)}
															</div>
															{project.description && (
																<p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-1 mt-0.5">
																	{project.description}
																</p>
															)}
														</div>
													</div>
												</td>
												<td class="px-4 py-4 whitespace-nowrap">
													<span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-1 rounded dark:bg-gray-700 dark:text-gray-300">
														{project.category}
													</span>
												</td>
												<td class="px-4 py-4 whitespace-nowrap">
													<span
														class={`text-xs font-medium px-2.5 py-1 rounded-full border ${statusClass}`}
													>
														{project.status}
													</span>
												</td>
												<td class="px-4 py-4 max-w-xs">
													<div class="flex flex-wrap gap-1">
														{techArray.length > 0 ? (
															techArray.map((tech) => (
																<span class="inline-block text-[11px] font-medium bg-blue-50 text-blue-700 dark:bg-gray-700 dark:text-blue-300 px-2 py-0.5 rounded">
																	{tech}
																</span>
															))
														) : (
															<span class="text-xs text-gray-400 italic">—</span>
														)}
													</div>
												</td>
												<td class="px-4 py-4 whitespace-nowrap">
													<div class="flex items-center space-x-2">
														{regMatch && (
															<a
																href={url(regMatch.routePrefix + '/overview')}
																class="inline-flex items-center text-xs font-semibold text-white bg-primary-700 hover:bg-primary-800 dark:bg-primary-600 dark:hover:bg-primary-700 px-2.5 py-1 rounded shadow-sm transition-colors"
																title="Open Central Admin Hub (14 Modules)"
															>
																<svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
																	<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
																</svg>
																Admin Hub
															</a>
														)}
														{project.liveUrl && (
															<a
																href={project.liveUrl}
																target="_blank"
																rel="noopener noreferrer"
																class="inline-flex items-center text-xs font-medium text-green-600 hover:text-green-700 dark:text-green-400 dark:hover:text-green-300 bg-green-50 dark:bg-green-950/40 px-2 py-1 rounded border border-green-200 dark:border-green-800"
																title="Visit Live Website"
															>
																<svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
																	<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
																</svg>
																Live
															</a>
														)}
														{project.githubUrl && (
															<a
																href={project.githubUrl}
																target="_blank"
																rel="noopener noreferrer"
																class="inline-flex items-center text-xs font-medium text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded"
																title="View GitHub Repository"
															>
																<svg class="w-3.5 h-3.5 mr-1" fill="currentColor" viewBox="0 0 24 24">
																	<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
																</svg>
																Code
															</a>
														)}
														{!project.liveUrl && !project.githubUrl && !regMatch && (
															<span class="text-xs text-gray-400 italic">—</span>
														)}
													</div>
												</td>
												<td class="px-4 py-4 whitespace-nowrap text-xs text-gray-500 dark:text-gray-400">
													<div>{new Date(project.updatedAt).toLocaleDateString()}</div>
													<div class="text-[10px] text-gray-400">Created: {new Date(project.createdAt).toLocaleDateString()}</div>
												</td>
												<td class="px-4 py-4 whitespace-nowrap text-right text-xs font-medium space-x-2">
													{regMatch && (
														<a
															href={url(regMatch.routePrefix + '/overview')}
															class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:underline font-semibold"
														>
															Admin
														</a>
													)}
													<button
														type="button"
														class="edit-project-btn text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:underline"
														data-project={JSON.stringify(project)}
													>
														Edit
													</button>
													<button
														type="button"
														class="delete-project-btn text-red-600 hover:text-red-700 dark:text-red-500 dark:hover:underline"
														data-id={project.id}
														data-name={project.name}
													>
														Delete
													</button>
												</td>
											</tr>
										);
									})}
								</tbody>
							</table>
						</div>
					</div>
				)
			}
		</div>

		<!-- Project Modal (Add / Edit) -->
		<div
			id="project-modal"
			tabindex="-1"
			aria-hidden="true"
			class="fixed inset-0 z-50 flex items-center justify-center hidden p-4 bg-gray-900/50 backdrop-blur-sm overflow-y-auto"
		>
			<div class="relative w-full max-w-2xl bg-white rounded-lg shadow-xl dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
				<!-- Modal header -->
				<div class="flex items-center justify-between p-4 border-b rounded-t dark:border-gray-700">
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white" id="modal-title">
						Add New Project
					</h3>
					<button
						type="button"
						id="close-modal-btn"
						class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center dark:hover:bg-gray-700 dark:hover:text-white"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
							<path
								fill-rule="evenodd"
								d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
								clip-rule="evenodd"
							></path>
						</svg>
					</button>
				</div>

				<!-- Modal body -->
				<form id="project-form" class="p-6 space-y-4">
					<input type="hidden" id="form-project-id" name="id" value="" />

					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<!-- Project Name -->
						<div>
							<label for="form-name" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
								Project Name <span class="text-red-500">*</span>
							</label>
							<input
								type="text"
								id="form-name"
								name="name"
								required
								class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
								placeholder="e.g. InstaFlow Analytics"
							/>
						</div>

						<!-- Slug -->
						<div>
							<label for="form-slug" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
								Slug <span class="text-xs text-gray-400 font-normal lowercase">(auto-generated if empty)</span>
							</label>
							<input
								type="text"
								id="form-slug"
								name="slug"
								class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
								placeholder="e.g. instaflow-analytics"
							/>
						</div>
					</div>

					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<!-- Category -->
						<div>
							<label for="form-category" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
								Category
							</label>
							<input
								type="text"
								id="form-category"
								name="category"
								list="category-suggestions"
								class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
								placeholder="e.g. SaaS, Web App, Tool"
								value="SaaS"
							/>
							<datalist id="category-suggestions">
								<option value="SaaS"></option>
								<option value="Web App"></option>
								<option value="Developer Tool"></option>
								<option value="Mobile App"></option>
								<option value="API / Backend"></option>
								<option value="Website"></option>
								<option value="E-commerce"></option>
								<option value="Open Source"></option>
							</datalist>
						</div>

						<!-- Status -->
						<div>
							<label for="form-status" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
								Status
							</label>
							<select
								id="form-status"
								name="status"
								class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
							>
								{VALID_PROJECT_STATUSES.map((status) => (
									<option value={status}>{status}</option>
								))}
							</select>
						</div>
					</div>

					<!-- Description -->
					<div>
						<label for="form-description" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
							Description
						</label>
						<textarea
							id="form-description"
							name="description"
							rows="2"
							class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
							placeholder="Brief description of the product or application..."
						></textarea>
					</div>

					<!-- Technologies Used -->
					<div>
						<label for="form-technologies" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
							Technologies Used <span class="text-xs text-gray-400 font-normal lowercase">(comma-separated)</span>
						</label>
						<input
							type="text"
							id="form-technologies"
							name="technologies"
							class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
							placeholder="e.g. Astro, TypeScript, Tailwind, Neon Postgres"
						/>
					</div>

					<!-- URLs -->
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<!-- Live URL -->
						<div>
							<label for="form-live-url" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
								Live Website URL
							</label>
							<input
								type="url"
								id="form-live-url"
								name="liveUrl"
								class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
								placeholder="https://instaflow.app"
							/>
						</div>

						<!-- GitHub URL -->
						<div>
							<label for="form-github-url" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
								GitHub URL <span class="text-xs text-gray-400 font-normal lowercase">(optional)</span>
							</label>
							<input
								type="url"
								id="form-github-url"
								name="githubUrl"
								class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
								placeholder="https://github.com/org/repo"
							/>
						</div>
					</div>

					<!-- Logo URL -->
					<div>
						<label for="form-logo-url" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
							Logo or Thumbnail URL
						</label>
						<input
							type="url"
							id="form-logo-url"
							name="logoUrl"
							class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
							placeholder="https://example.com/logo.png"
						/>
					</div>

					<!-- Error alert in modal -->
					<div id="modal-error-alert" class="hidden p-3 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-700 dark:text-red-400 border border-red-200 dark:border-red-800">
					</div>

					<!-- Modal footer -->
					<div class="flex items-center justify-end space-x-3 pt-3 border-t dark:border-gray-700">
						<button
							type="button"
							id="cancel-modal-btn"
							class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 dark:hover:bg-gray-700"
						>
							Cancel
						</button>
						<button
							type="submit"
							id="submit-modal-btn"
							class="inline-flex items-center px-5 py-2 text-sm font-medium text-white bg-primary-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700"
						>
							<span id="submit-btn-text">Save Project</span>
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</LayoutSidebar>

<script>
	// DOM Elements
	const modal = document.getElementById('project-modal') as HTMLElement;
	const modalTitle = document.getElementById('modal-title') as HTMLElement;
	const form = document.getElementById('project-form') as HTMLFormElement;
	const modalErrorAlert = document.getElementById('modal-error-alert') as HTMLElement;
	const submitBtn = document.getElementById('submit-modal-btn') as HTMLButtonElement;
	const submitBtnText = document.getElementById('submit-btn-text') as HTMLElement;

	const idInput = document.getElementById('form-project-id') as HTMLInputElement;
	const nameInput = document.getElementById('form-name') as HTMLInputElement;
	const slugInput = document.getElementById('form-slug') as HTMLInputElement;
	const categoryInput = document.getElementById('form-category') as HTMLInputElement;
	const statusSelect = document.getElementById('form-status') as HTMLSelectElement;
	const descInput = document.getElementById('form-description') as HTMLTextAreaElement;
	const techInput = document.getElementById('form-technologies') as HTMLInputElement;
	const liveUrlInput = document.getElementById('form-live-url') as HTMLInputElement;
	const githubUrlInput = document.getElementById('form-github-url') as HTMLInputElement;
	const logoUrlInput = document.getElementById('form-logo-url') as HTMLInputElement;

	function openModal(isEdit = false, projectData: any = null) {
		modalErrorAlert.classList.add('hidden');
		modalErrorAlert.textContent = '';

		if (isEdit && projectData) {
			modalTitle.textContent = 'Edit Project';
			submitBtnText.textContent = 'Update Project';
			idInput.value = projectData.id || '';
			nameInput.value = projectData.name || '';
			slugInput.value = projectData.slug || '';
			categoryInput.value = projectData.category || 'General';
			statusSelect.value = projectData.status || 'Planning';
			descInput.value = projectData.description || '';
			techInput.value = Array.isArray(projectData.technologies)
				? projectData.technologies.join(', ')
				: '';
			liveUrlInput.value = projectData.liveUrl || '';
			githubUrlInput.value = projectData.githubUrl || '';
			logoUrlInput.value = projectData.logoUrl || '';
		} else {
			modalTitle.textContent = 'Add New Project';
			submitBtnText.textContent = 'Save Project';
			form.reset();
			idInput.value = '';
			categoryInput.value = 'SaaS';
			statusSelect.value = 'Planning';
		}

		modal.classList.remove('hidden');
	}

	function closeModal() {
		modal.classList.add('hidden');
		form.reset();
		idInput.value = '';
	}

	// Open Add Modal triggers
	document.getElementById('open-add-project-btn')?.addEventListener('click', () => openModal(false));
	document.querySelector('.open-add-project-btn-empty')?.addEventListener('click', () => openModal(false));

	// Check if URL has ?action=new
	if (new URLSearchParams(window.location.search).get('action') === 'new') {
		openModal(false);
	}

	// Close Modal triggers
	document.getElementById('close-modal-btn')?.addEventListener('click', closeModal);
	document.getElementById('cancel-modal-btn')?.addEventListener('click', closeModal);
	modal?.addEventListener('click', (e) => {
		if (e.target === modal) closeModal();
	});

	// Edit buttons
	document.querySelectorAll('.edit-project-btn').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLElement;
			const dataRaw = target.getAttribute('data-project');
			if (dataRaw) {
				try {
					const project = JSON.parse(dataRaw);
					openModal(true, project);
				} catch (err) {
					console.error('Failed to parse project data', err);
				}
			}
		});
	});

	// Delete buttons
	document.querySelectorAll('.delete-project-btn').forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			const target = e.currentTarget as HTMLElement;
			const id = target.getAttribute('data-id');
			const name = target.getAttribute('data-name');
			if (!id) return;

			if (!confirm(`Are you sure you want to delete the project "${name}"? This action cannot be undone.`)) {
				return;
			}

			target.classList.add('opacity-50');
			try {
				const res = await fetch(`/api/projects/${id}`, {
					method: 'DELETE',
				});
				if (res.ok) {
					window.location.reload();
				} else {
					const data = await res.json();
					alert(data.error || 'Failed to delete project');
				}
			} catch (err: any) {
				alert(err.message || 'Network error');
			} finally {
				target.classList.remove('opacity-50');
			}
		});
	});

	// Submit Form (Add or Edit)
	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		modalErrorAlert.classList.add('hidden');
		modalErrorAlert.textContent = '';

		const id = idInput.value;
		const isEdit = Boolean(id);

		const payload = {
			name: nameInput.value.trim(),
			slug: slugInput.value.trim() || undefined,
			category: categoryInput.value.trim() || 'General',
			status: statusSelect.value,
			description: descInput.value.trim() || null,
			technologies: techInput.value
				.split(',')
				.map((t) => t.trim())
				.filter(Boolean),
			liveUrl: liveUrlInput.value.trim() || null,
			githubUrl: githubUrlInput.value.trim() || null,
			logoUrl: logoUrlInput.value.trim() || null,
		};

		if (!payload.name) {
			modalErrorAlert.textContent = 'Project name is required.';
			modalErrorAlert.classList.remove('hidden');
			return;
		}

		submitBtn.disabled = true;
		submitBtnText.textContent = isEdit ? 'Updating...' : 'Saving...';

		try {
			const url = isEdit ? `/api/projects/${id}` : '/api/projects';
			const method = isEdit ? 'PUT' : 'POST';

			const res = await fetch(url, {
				method,
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});

			const data = await res.json();

			if (!res.ok) {
				throw new Error(data.error || 'Failed to save project');
			}

			closeModal();
			window.location.reload();
		} catch (err: any) {
			modalErrorAlert.textContent = err.message || 'An error occurred';
			modalErrorAlert.classList.remove('hidden');
		} finally {
			submitBtn.disabled = false;
			submitBtnText.textContent = isEdit ? 'Update Project' : 'Save Project';
		}
	});

	// Client-side Search and Filter
	const searchInput = document.getElementById('project-search') as HTMLInputElement;
	const statusFilter = document.getElementById('filter-status') as HTMLSelectElement;
	const categoryFilter = document.getElementById('filter-category') as HTMLSelectElement;
	const rows = document.querySelectorAll('.project-row');

	function applyFilters() {
		const searchVal = searchInput?.value.toLowerCase().trim() || '';
		const statusVal = statusFilter?.value || 'All';
		const categoryVal = categoryFilter?.value || 'All';

		rows.forEach((row) => {
			const rowElem = row as HTMLElement;
			const name = rowElem.getAttribute('data-name') || '';
			const cat = rowElem.getAttribute('data-category') || '';
			const status = rowElem.getAttribute('data-status') || '';
			const tech = rowElem.getAttribute('data-tech') || '';
			const desc = rowElem.getAttribute('data-desc') || '';

			const matchesSearch =
				!searchVal ||
				name.includes(searchVal) ||
				cat.includes(searchVal) ||
				tech.includes(searchVal) ||
				desc.includes(searchVal);

			const matchesStatus = statusVal === 'All' || status === statusVal;
			const matchesCategory = categoryVal === 'All' || cat === categoryVal.toLowerCase();

			if (matchesSearch && matchesStatus && matchesCategory) {
				rowElem.style.display = '';
			} else {
				rowElem.style.display = 'none';
			}
		});
	}

	searchInput?.addEventListener('input', applyFilters);
	statusFilter?.addEventListener('change', applyFilters);
	categoryFilter?.addEventListener('change', applyFilters);
</script>
