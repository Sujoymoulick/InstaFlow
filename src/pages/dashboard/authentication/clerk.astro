---
import LayoutSidebar from '../../../app/LayoutSidebar.astro';
import { url } from '../../../lib/data.js';
import { fetchClerkData, getClerkApps, type ClerkUser, type ClerkMetrics } from '../../../services/clerk.js';

export const prerender = false;

// 1. Fetch available Clerk apps
const apps = await getClerkApps();

// 2. Determine selected app from query param or default (supports 'all')
const selectedAppId = Astro.url.searchParams.get('appId') || 'all';
const isAllProjects = selectedAppId === 'all';
const currentApp = isAllProjects ? null : (apps.find((a) => a.id === selectedAppId) || apps[0]);

let users: ClerkUser[] = [];
let totalCount = 0;
let metrics: ClerkMetrics = {
	totalUsers: 0,
	activeUsers7d: 0,
	oauthUsers: 0,
	verifiedEmails: 0,
	bannedUsers: 0,
	totalProjects: apps.length,
};
let fetchError = '';

const hasLiveEnvKey = Boolean(process.env.CLERK_SECRET_KEY && process.env.CLERK_SECRET_KEY.startsWith('sk_live_'));
const isPlaceholderSet = Boolean(process.env.CLERK_SECRET_KEY && (process.env.CLERK_SECRET_KEY.includes('your_') || process.env.CLERK_SECRET_KEY.includes('placeholder')));
const currentAppIsLive = currentApp ? (currentApp.secretKey?.startsWith('sk_live_') || currentApp.publishableKey?.startsWith('pk_live_')) : hasLiveEnvKey;

try {
	if (isAllProjects) {
		const data = await fetchClerkData('', { fetchAll: true });
		users = data.users;
		totalCount = data.totalCount;
		metrics = data.metrics;
	} else if (currentApp && currentApp.secretKey) {
		const data = await fetchClerkData(currentApp);
		users = data.users;
		totalCount = data.totalCount;
		metrics = data.metrics;
	} else {
		fetchError = 'No Clerk secret key configured for this app.';
	}
} catch (err: any) {
	console.error('[Clerk Page] Failed to fetch data:', err);
	fetchError = err.message || 'Failed to connect to Clerk API';
}
---

<LayoutSidebar title="Clerk Authentication Dashboard - InstaFlow">
	<div class="px-4 pt-6 pb-12">
		<!-- Breadcrumbs & Page Header -->
		<div class="mb-6">
			<nav class="flex mb-4" aria-label="Breadcrumb">
				<ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
					<li class="inline-flex items-center">
						<a
							href={url()}
							class="inline-flex items-center text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-white"
						>
							<svg
								class="w-5 h-5 mr-2.5"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
								></path>
							</svg>
							Home
						</a>
					</li>
					<li>
						<div class="flex items-center">
							<svg
								class="w-6 h-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"
								></path>
							</svg>
							<a
								href={url('dashboard')}
								class="ml-1 text-gray-700 hover:text-primary-600 md:ml-2 dark:text-gray-300 dark:hover:text-white"
							>
								Dashboard
							</a>
						</div>
					</li>
					<li>
						<div class="flex items-center">
							<svg
								class="w-6 h-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"
								></path>
							</svg>
							<span class="ml-1 text-gray-700 md:ml-2 dark:text-gray-300">
								Authentication
							</span>
						</div>
					</li>
					<li>
						<div class="flex items-center">
							<svg
								class="w-6 h-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"
								></path>
							</svg>
							<span class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500" aria-current="page">
								Clerk
							</span>
						</div>
					</li>
				</ol>
			</nav>

			<!-- Title & App Switcher -->
			<div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
				<div>
					<div class="flex items-center space-x-3">
						<div class="p-2.5 bg-indigo-100 rounded-xl text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-400">
							<svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
							</svg>
						</div>
						<div>
							<h1 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white flex items-center gap-2">
								Clerk Authentication
								<span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-300">
									Production Live
								</span>
							</h1>
							<p class="text-sm font-normal text-gray-500 dark:text-gray-400">
								Manage user accounts, OAuth logins, and live user counts across all your Clerk projects.
							</p>
						</div>
					</div>
				</div>

				<!-- Actions & App Selector -->
				<div class="flex flex-wrap items-center gap-3">
					<!-- App Select Dropdown -->
					<div class="flex items-center space-x-2">
						<label for="app-select" class="text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase">
							Scope:
						</label>
						<select
							id="app-select"
							class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white font-medium shadow-sm"
						>
							<option value="all" selected={isAllProjects}>
								⚡ All Projects ({apps.length} Connected)
							</option>
							{apps.map((app) => (
								<option value={app.id} selected={app.id === selectedAppId}>
									{app.name}
								</option>
							))}
						</select>
					</div>

					<!-- Refresh Button -->
					<button
						id="refresh-data-btn"
						type="button"
						class="inline-flex items-center px-3.5 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 dark:hover:bg-gray-700 shadow-sm"
						title="Refresh User Data"
					>
						<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
						Refresh
					</button>

					<!-- Add App Button -->
					<button
						id="open-add-app-btn"
						type="button"
						class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-primary-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800 shadow-sm"
					>
						<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						Connect Project
					</button>
				</div>
			</div>
		</div>

		<!-- Current Scope Banner -->
		<div class="mb-6 p-4 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white rounded-xl shadow-md border border-indigo-900/50 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
			<div class="space-y-1">
				<div class="flex items-center gap-2 flex-wrap">
					<span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
					<h2 class="text-lg font-bold text-white tracking-wide">
						{isAllProjects ? `All Projects (${apps.length} Active Clerk Environments)` : currentApp?.name}
					</h2>
					{currentAppIsLive ? (
						<span class="text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 px-2.5 py-0.5 rounded-full font-semibold uppercase tracking-wide">
							Live Production
						</span>
					) : (
						<span class="text-xs bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2.5 py-0.5 rounded-full font-semibold uppercase tracking-wide">
							Test / Dev Mode
						</span>
					)}
					{currentApp?.instanceUrl && (
						<span class="text-xs bg-indigo-800/80 text-indigo-200 px-2.5 py-0.5 rounded-md font-mono">
							{currentApp.instanceUrl.replace('https://', '')}
						</span>
					)}
				</div>
				<div class="text-xs text-indigo-200/90 flex items-center gap-2 flex-wrap">
					{isAllProjects ? (
						<span>Including: {apps.map((a) => a.name).join(' • ')}</span>
					) : (
						<>
							<span class="font-mono">Key: {currentApp?.publishableKey ? `${currentApp.publishableKey.substring(0, 16)}...` : 'Not Set'}</span>
							<span>•</span>
							<span>Status: <span class="text-emerald-300 font-semibold">{currentAppIsLive ? 'Production Live' : 'Active (Test Keys)'}</span></span>
						</>
					)}
				</div>
			</div>

			<div class="flex items-center space-x-2">
				<a
					href="https://dashboard.clerk.com"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-700 px-3 py-1.5 rounded-lg transition"
				>
					<svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
					</svg>
					Clerk Dashboard
				</a>
			</div>
		</div>

		<!-- Production Readiness Guidance Banner -->
		{!hasLiveEnvKey && (
			<div class="mb-6 p-4 rounded-xl border border-blue-200 bg-blue-50/70 dark:bg-gray-800 dark:border-blue-900/60 text-blue-900 dark:text-blue-200 flex items-start gap-3">
				<div class="p-2 bg-blue-100 dark:bg-blue-950/80 rounded-lg text-blue-600 dark:text-blue-400 mt-0.5 flex-shrink-0">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
				</div>
				<div class="flex-1 text-xs leading-relaxed">
					<span class="font-bold text-sm text-gray-900 dark:text-white block mb-0.5">
						Ready for Clerk Live Production Keys:
					</span>
					Placeholders are ready in your <code class="font-mono bg-blue-100 dark:bg-gray-700 px-1 py-0.5 rounded text-indigo-700 dark:text-indigo-300">.env</code> and <code class="font-mono bg-blue-100 dark:bg-gray-700 px-1 py-0.5 rounded text-indigo-700 dark:text-indigo-300">.env.example</code> files. When you paste your real live keys (<code class="font-mono text-emerald-700 dark:text-emerald-400 font-bold">sk_live_...</code> and <code class="font-mono text-emerald-700 dark:text-emerald-400 font-bold">pk_live_...</code>), this dashboard will immediately stream live production user counts and active sessions.
				</div>
			</div>
		)}

		<!-- Error Message if fetch failed -->
		{fetchError && (
			<div class="p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400 border border-red-200 dark:border-red-800 flex items-center justify-between">
				<div class="flex items-center">
					<svg class="w-5 h-5 mr-2 text-red-600" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
					</svg>
					<span><strong>API Error:</strong> {fetchError}</span>
				</div>
			</div>
		)}

		<!-- Metric Cards -->
		<div class="grid w-full grid-cols-2 gap-4 mb-6 sm:grid-cols-2 lg:grid-cols-5">
			<!-- Total Users -->
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">Total Users</span>
						<h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1" id="stat-total-users">
							{metrics.totalUsers}
						</h3>
					</div>
					<div class="p-2.5 bg-blue-50 rounded-lg text-primary-600 dark:bg-gray-700 dark:text-primary-400">
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
							<path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
						</svg>
					</div>
				</div>
			</div>

			<!-- Active Users (7 Days) -->
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">Active (7d)</span>
						<h3 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mt-1" id="stat-active-users">
							{metrics.activeUsers7d}
						</h3>
					</div>
					<div class="p-2.5 bg-emerald-50 rounded-lg text-emerald-600 dark:bg-gray-700 dark:text-emerald-400">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
					</div>
				</div>
			</div>

			<!-- OAuth Social Logins -->
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">OAuth / Google</span>
						<h3 class="text-2xl font-bold text-indigo-600 dark:text-indigo-400 mt-1" id="stat-oauth-users">
							{metrics.oauthUsers}
						</h3>
					</div>
					<div class="p-2.5 bg-indigo-50 rounded-lg text-indigo-600 dark:bg-gray-700 dark:text-indigo-400">
						<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
						</svg>
					</div>
				</div>
			</div>

			<!-- Verified Emails -->
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">Verified Emails</span>
						<h3 class="text-2xl font-bold text-blue-600 dark:text-blue-400 mt-1" id="stat-verified-emails">
							{metrics.verifiedEmails}
						</h3>
					</div>
					<div class="p-2.5 bg-blue-50 rounded-lg text-blue-600 dark:bg-gray-700 dark:text-blue-400">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
						</svg>
					</div>
				</div>
			</div>

			<!-- Connected Apps -->
			<div class="p-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<div class="flex items-center justify-between">
					<div>
						<span class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">Clerk Projects</span>
						<h3 class="text-2xl font-bold text-purple-600 dark:text-purple-400 mt-1">
							{apps.length}
						</h3>
					</div>
					<div class="p-2.5 bg-purple-50 rounded-lg text-purple-600 dark:bg-gray-700 dark:text-purple-400">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
						</svg>
					</div>
				</div>
			</div>
		</div>

		<!-- Search & Filter Toolbar -->
		<div class="p-4 mb-4 bg-white border border-gray-200 rounded-xl shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-5">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<!-- Search Input -->
				<div class="relative w-full md:w-80">
					<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
						<svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<input
						type="text"
						id="user-search"
						class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full pl-9 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
						placeholder="Search by name, email, or user ID..."
					/>
				</div>

				<!-- Filter Badges / Selectors -->
				<div class="flex flex-wrap items-center gap-3">
					<div class="flex items-center space-x-2">
						<label for="filter-provider" class="text-xs font-semibold text-gray-500 dark:text-gray-400">Auth Provider:</label>
						<select
							id="filter-provider"
							class="bg-gray-50 border border-gray-300 text-gray-900 text-xs rounded-lg focus:ring-primary-500 focus:border-primary-500 block p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white font-medium"
						>
							<option value="All">All Providers</option>
							<option value="google">Google OAuth</option>
							<option value="email">Email / Password</option>
						</select>
					</div>

					<div class="flex items-center space-x-2">
						<label for="filter-status" class="text-xs font-semibold text-gray-500 dark:text-gray-400">Status:</label>
						<select
							id="filter-status"
							class="bg-gray-50 border border-gray-300 text-gray-900 text-xs rounded-lg focus:ring-primary-500 focus:border-primary-500 block p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white font-medium"
						>
							<option value="All">All Users</option>
							<option value="verified">Verified Email</option>
							<option value="unverified">Unverified</option>
						</select>
					</div>
				</div>
			</div>
		</div>

		<!-- Users Table or Empty State -->
		<div id="users-table-container">
			{users.length === 0 ? (
				<div class="p-12 text-center bg-white border-2 border-dashed border-gray-200 dark:border-gray-700 rounded-xl dark:bg-gray-800">
					<svg class="w-16 h-16 mx-auto text-gray-400 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
					</svg>
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white">No users found</h3>
					<p class="max-w-md mx-auto mt-1 text-sm text-gray-500 dark:text-gray-400">
						No registered users found in the selected Clerk application. Check your API credentials or sign up a test account.
					</p>
				</div>
			) : (
				<div class="bg-white border border-gray-200 rounded-xl shadow-sm dark:border-gray-700 dark:bg-gray-800 overflow-hidden">
					<div class="overflow-x-auto">
						<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
							<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-300">
								<tr>
									<th scope="col" class="px-5 py-3.5">User</th>
									<th scope="col" class="px-4 py-3.5">Project</th>
									<th scope="col" class="px-4 py-3.5">Primary Email</th>
									<th scope="col" class="px-4 py-3.5">Auth Provider</th>
									<th scope="col" class="px-4 py-3.5">User ID</th>
									<th scope="col" class="px-4 py-3.5">Registered</th>
									<th scope="col" class="px-4 py-3.5">Last Active</th>
									<th scope="col" class="px-4 py-3.5 text-right">Actions</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-200 dark:divide-gray-700" id="users-tbody">
								{users.map((user) => {
									const fullName = [user.firstName, user.lastName].filter(Boolean).join(' ') || 'Anonymous User';
									const primaryOAuth = user.externalAccounts[0];
									const createdDate = new Date(user.createdAt).toLocaleDateString(undefined, {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									});
									const lastActiveStr = user.lastActiveAt
										? new Date(user.lastActiveAt).toLocaleDateString(undefined, {
												month: 'short',
												day: 'numeric',
												hour: '2-digit',
												minute: '2-digit',
										  })
										: 'Never';

									return (
										<tr
											class="user-row hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"
											data-name={fullName.toLowerCase()}
											data-email={(user.primaryEmail || '').toLowerCase()}
											data-id={user.id.toLowerCase()}
											data-provider={primaryOAuth ? primaryOAuth.provider.toLowerCase() : 'email'}
											data-verified={user.primaryEmailVerified ? 'verified' : 'unverified'}
										>
											<!-- User Profile -->
											<td class="px-5 py-4 font-medium text-gray-900 dark:text-white">
												<div class="flex items-center space-x-3.5">
													{user.imageUrl ? (
														<img
															src={user.imageUrl}
															alt={fullName}
															class="w-10 h-10 rounded-full object-cover border border-gray-200 dark:border-gray-700 flex-shrink-0"
															loading="lazy"
														/>
													) : (
														<div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 dark:bg-indigo-900 dark:text-indigo-300 flex items-center justify-center font-bold text-sm flex-shrink-0 border border-indigo-200 dark:border-indigo-800">
															{fullName.charAt(0).toUpperCase()}
														</div>
													)}
													<div class="min-w-0 flex-1">
														<div class="font-semibold text-gray-900 dark:text-white truncate">
															{fullName}
														</div>
														{user.username && (
															<span class="text-xs text-gray-500 dark:text-gray-400">
																@{user.username}
															</span>
														)}
													</div>
												</div>
											</td>

											<!-- Project Badge -->
											<td class="px-4 py-4 whitespace-nowrap">
												<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-purple-50 text-purple-700 dark:bg-gray-700 dark:text-purple-300 border border-purple-200 dark:border-gray-600">
													{user.projectName || currentApp?.name || 'Clerk Project'}
												</span>
											</td>

											<!-- Email & Verification Badge -->
											<td class="px-4 py-4 whitespace-nowrap">
												<div class="flex items-center space-x-2">
													<span class="font-medium text-gray-800 dark:text-gray-200">
														{user.primaryEmail || 'No email provided'}
													</span>
													{user.primaryEmailVerified ? (
														<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300" title="Verified Email">
															<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
																<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
															</svg>
															Verified
														</span>
													) : (
														<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300" title="Unverified Email">
															Pending
														</span>
													)}
												</div>
											</td>

											<!-- Auth Provider -->
											<td class="px-4 py-4 whitespace-nowrap">
												{primaryOAuth ? (
													<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-700 dark:bg-gray-700 dark:text-blue-300 border border-blue-200 dark:border-gray-600">
														<svg class="w-3.5 h-3.5 mr-1.5" viewBox="0 0 24 24" fill="currentColor">
															<path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
														</svg>
														Google
													</span>
												) : (
													<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300">
														<svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
														</svg>
														Email / Password
													</span>
												)}
											</td>

											<!-- User ID -->
											<td class="px-4 py-4 whitespace-nowrap font-mono text-xs text-gray-500 dark:text-gray-400">
												<div class="flex items-center space-x-1.5">
													<span>{user.id}</span>
													<button
														type="button"
														class="copy-id-btn text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1"
														data-id={user.id}
														title="Copy User ID"
													>
														<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
														</svg>
													</button>
												</div>
											</td>

											<!-- Registered Date -->
											<td class="px-4 py-4 whitespace-nowrap text-xs text-gray-500 dark:text-gray-400">
												{createdDate}
											</td>

											<!-- Last Active -->
											<td class="px-4 py-4 whitespace-nowrap text-xs text-gray-500 dark:text-gray-400">
												{lastActiveStr}
											</td>

											<!-- Actions -->
											<td class="px-4 py-4 whitespace-nowrap text-right text-xs font-medium">
												<button
													type="button"
													class="view-user-btn text-primary-600 hover:text-primary-700 dark:text-primary-400 font-semibold px-2 py-1 rounded hover:bg-primary-50 dark:hover:bg-gray-700 transition"
													data-user={JSON.stringify(user)}
												>
													View Details
												</button>
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				</div>
			)}
		</div>

		<!-- User Details Modal -->
		<div
			id="user-details-modal"
			tabindex="-1"
			aria-hidden="true"
			class="fixed inset-0 z-50 flex items-center justify-center hidden p-4 bg-gray-900/60 backdrop-blur-sm overflow-y-auto"
		>
			<div class="relative w-full max-w-2xl bg-white rounded-xl shadow-2xl dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
				<!-- Modal Header -->
				<div class="flex items-center justify-between p-4 border-b rounded-t dark:border-gray-700">
					<div class="flex items-center space-x-3">
						<img id="modal-user-avatar" class="w-10 h-10 rounded-full border border-gray-300" src="" alt="Avatar" />
						<div>
							<h3 class="text-base font-bold text-gray-900 dark:text-white" id="modal-user-name">
								User Details
							</h3>
							<p class="text-xs text-gray-500 dark:text-gray-400 font-mono" id="modal-user-id">
								user_...
							</p>
						</div>
					</div>
					<button
						type="button"
						id="close-user-modal-btn"
						class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 inline-flex items-center dark:hover:bg-gray-700 dark:hover:text-white"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
						</svg>
					</button>
				</div>

				<!-- Modal Body -->
				<div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
					<!-- Primary Info Grid -->
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div class="p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
							<span class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase">Email Address</span>
							<p class="text-sm font-medium text-gray-900 dark:text-white mt-1" id="modal-user-email">—</p>
						</div>
						<div class="p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
							<span class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase">Verification Status</span>
							<p class="text-sm font-medium text-emerald-600 dark:text-emerald-400 mt-1" id="modal-user-verification">—</p>
						</div>
						<div class="p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
							<span class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase">Created At</span>
							<p class="text-sm font-medium text-gray-900 dark:text-white mt-1" id="modal-user-created">—</p>
						</div>
						<div class="p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
							<span class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase">Last Active</span>
							<p class="text-sm font-medium text-gray-900 dark:text-white mt-1" id="modal-user-active">—</p>
						</div>
					</div>

					<!-- OAuth Accounts -->
					<div>
						<h4 class="text-xs font-bold uppercase text-gray-600 dark:text-gray-400 mb-2">Connected OAuth Accounts</h4>
						<div id="modal-oauth-list" class="space-y-2">
							<!-- Populated dynamically -->
						</div>
					</div>

					<!-- Raw Payload JSON -->
					<div>
						<h4 class="text-xs font-bold uppercase text-gray-600 dark:text-gray-400 mb-2">Clerk User Payload</h4>
						<pre id="modal-user-raw-json" class="p-3 bg-gray-900 text-gray-200 text-xs font-mono rounded-lg overflow-x-auto max-h-48 scrollbar"></pre>
					</div>
				</div>
			</div>
		</div>

		<!-- Connect New Clerk App Modal -->
		<div
			id="add-app-modal"
			tabindex="-1"
			aria-hidden="true"
			class="fixed inset-0 z-50 flex items-center justify-center hidden p-4 bg-gray-900/60 backdrop-blur-sm overflow-y-auto"
		>
			<div class="relative w-full max-w-lg bg-white rounded-xl shadow-2xl dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
				<div class="flex items-center justify-between p-4 border-b rounded-t dark:border-gray-700">
					<h3 class="text-lg font-bold text-gray-900 dark:text-white">
						Connect Clerk Project
					</h3>
					<button
						type="button"
						id="close-add-app-modal-btn"
						class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 inline-flex items-center dark:hover:bg-gray-700 dark:hover:text-white"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
						</svg>
					</button>
				</div>

				<form id="add-app-form" class="p-6 space-y-4">
					<div>
						<label for="app-name" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
							Project / Application Name <span class="text-red-500">*</span>
						</label>
						<input
							type="text"
							id="app-name"
							name="name"
							required
							class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
							placeholder="e.g. SEND VIRTUAL GIFT or FreePDFLY"
						/>
					</div>

					<div>
						<label for="app-publishable-key" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
							Publishable Key <span class="text-red-500">*</span>
						</label>
						<input
							type="text"
							id="app-publishable-key"
							name="publishableKey"
							required
							class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white font-mono"
							placeholder="pk_test_... or pk_live_..."
						/>
					</div>

					<div>
						<label for="app-secret-key" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
							Secret Key <span class="text-red-500">*</span>
						</label>
						<input
							type="password"
							id="app-secret-key"
							name="secretKey"
							required
							class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white font-mono"
							placeholder="sk_test_... or sk_live_..."
						/>
						<p class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">
							Encrypted with AES-256-GCM before storage.
						</p>
					</div>

					<div>
						<label for="app-instance-url" class="block mb-1 text-xs font-semibold uppercase text-gray-700 dark:text-gray-300">
							Clerk Domain / Instance URL <span class="text-xs text-gray-400 lowercase">(optional)</span>
						</label>
						<input
							type="text"
							id="app-instance-url"
							name="instanceUrl"
							class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
							placeholder="https://example.clerk.accounts.dev"
						/>
					</div>

					<div id="add-app-error" class="hidden p-3 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-700 dark:text-red-400 border border-red-200"></div>

					<div class="flex items-center justify-end space-x-3 pt-3 border-t dark:border-gray-700">
						<button
							type="button"
							id="cancel-add-app-btn"
							class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600"
						>
							Cancel
						</button>
						<button
							type="submit"
							id="save-app-btn"
							class="inline-flex items-center px-5 py-2 text-sm font-medium text-white bg-primary-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700"
						>
							Save Project
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</LayoutSidebar>

<script>
	// 1. App Switcher
	const appSelect = document.getElementById('app-select') as HTMLSelectElement;
	appSelect?.addEventListener('change', () => {
		const newAppId = appSelect.value;
		const url = new URL(window.location.href);
		url.searchParams.set('appId', newAppId);
		window.location.href = url.toString();
	});

	// 2. Refresh Button
	document.getElementById('refresh-data-btn')?.addEventListener('click', () => {
		window.location.reload();
	});

	// 3. Search & Filter
	const searchInput = document.getElementById('user-search') as HTMLInputElement;
	const providerFilter = document.getElementById('filter-provider') as HTMLSelectElement;
	const statusFilter = document.getElementById('filter-status') as HTMLSelectElement;

	function filterRows() {
		const q = (searchInput?.value || '').toLowerCase().trim();
		const prov = providerFilter?.value || 'All';
		const stat = statusFilter?.value || 'All';

		const rows = document.querySelectorAll('.user-row');
		rows.forEach((r) => {
			const row = r as HTMLElement;
			const name = row.dataset.name || '';
			const email = row.dataset.email || '';
			const id = row.dataset.id || '';
			const provider = row.dataset.provider || '';
			const verified = row.dataset.verified || '';

			const matchesQuery = !q || name.includes(q) || email.includes(q) || id.includes(q);
			const matchesProvider = prov === 'All' || provider === prov;
			const matchesStatus = stat === 'All' || verified === stat;

			if (matchesQuery && matchesProvider && matchesStatus) {
				row.style.display = '';
			} else {
				row.style.display = 'none';
			}
		});
	}

	searchInput?.addEventListener('input', filterRows);
	providerFilter?.addEventListener('change', filterRows);
	statusFilter?.addEventListener('change', filterRows);

	// 4. Copy User ID
	document.querySelectorAll('.copy-id-btn').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLElement;
			const id = target.getAttribute('data-id');
			if (id) {
				navigator.clipboard.writeText(id);
				target.classList.add('text-green-500');
				setTimeout(() => target.classList.remove('text-green-500'), 1500);
			}
		});
	});

	// 5. User Details Modal
	const userModal = document.getElementById('user-details-modal') as HTMLElement;
	const closeUserModalBtn = document.getElementById('close-user-modal-btn');

	function openUserModal(user: any) {
		const avatar = document.getElementById('modal-user-avatar') as HTMLImageElement;
		const name = document.getElementById('modal-user-name') as HTMLElement;
		const idEl = document.getElementById('modal-user-id') as HTMLElement;
		const emailEl = document.getElementById('modal-user-email') as HTMLElement;
		const verifEl = document.getElementById('modal-user-verification') as HTMLElement;
		const createdEl = document.getElementById('modal-user-created') as HTMLElement;
		const activeEl = document.getElementById('modal-user-active') as HTMLElement;
		const oauthList = document.getElementById('modal-oauth-list') as HTMLElement;
		const rawJson = document.getElementById('modal-user-raw-json') as HTMLElement;

		if (avatar) avatar.src = user.imageUrl || 'https://via.placeholder.com/40';
		if (name) name.textContent = [user.firstName, user.lastName].filter(Boolean).join(' ') || 'Anonymous User';
		if (idEl) idEl.textContent = user.id;
		if (emailEl) emailEl.textContent = user.primaryEmail || 'None';
		if (verifEl) {
			verifEl.textContent = user.primaryEmailVerified ? 'Verified ✓' : 'Unverified ✗';
			verifEl.className = user.primaryEmailVerified ? 'text-sm font-medium text-emerald-600 dark:text-emerald-400 mt-1' : 'text-sm font-medium text-yellow-600 dark:text-yellow-400 mt-1';
		}
		if (createdEl) createdEl.textContent = new Date(user.createdAt).toLocaleString();
		if (activeEl) activeEl.textContent = user.lastActiveAt ? new Date(user.lastActiveAt).toLocaleString() : 'Never';

		if (oauthList) {
			oauthList.innerHTML = '';
			if (user.externalAccounts && user.externalAccounts.length > 0) {
				user.externalAccounts.forEach((ea: any) => {
					const div = document.createElement('div');
					div.className = 'flex items-center justify-between p-2.5 bg-gray-50 dark:bg-gray-700/50 rounded-lg text-xs';
					div.innerHTML = `<span class="font-semibold capitalize text-gray-800 dark:text-gray-200">${ea.provider}</span><span class="text-gray-500 font-mono">${ea.emailAddress}</span>`;
					oauthList.appendChild(div);
				});
			} else {
				oauthList.innerHTML = '<p class="text-xs text-gray-400 italic">No linked external OAuth accounts</p>';
			}
		}

		if (rawJson) rawJson.textContent = JSON.stringify(user, null, 2);

		userModal?.classList.remove('hidden');
	}

	document.querySelectorAll('.view-user-btn').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const raw = (e.currentTarget as HTMLElement).getAttribute('data-user');
			if (raw) {
				try {
					const user = JSON.parse(raw);
					openUserModal(user);
				} catch (err) {
					console.error(err);
				}
			}
		});
	});

	closeUserModalBtn?.addEventListener('click', () => userModal?.classList.add('hidden'));
	userModal?.addEventListener('click', (e) => {
		if (e.target === userModal) userModal.classList.add('hidden');
	});

	// 6. Connect App Modal
	const addAppModal = document.getElementById('add-app-modal') as HTMLElement;
	const openAddAppBtn = document.getElementById('open-add-app-btn');
	const closeAddAppBtn = document.getElementById('close-add-app-modal-btn');
	const cancelAddAppBtn = document.getElementById('cancel-add-app-btn');
	const addAppForm = document.getElementById('add-app-form') as HTMLFormElement;
	const addAppError = document.getElementById('add-app-error') as HTMLElement;

	openAddAppBtn?.addEventListener('click', () => {
		addAppError.classList.add('hidden');
		addAppForm.reset();
		addAppModal?.classList.remove('hidden');
	});

	const closeAddModal = () => addAppModal?.classList.add('hidden');
	closeAddAppBtn?.addEventListener('click', closeAddModal);
	cancelAddAppBtn?.addEventListener('click', closeAddModal);

	addAppForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const formData = new FormData(addAppForm);
		const payload = {
			name: formData.get('name'),
			publishableKey: formData.get('publishableKey'),
			secretKey: formData.get('secretKey'),
			instanceUrl: formData.get('instanceUrl'),
		};

		try {
			const res = await fetch('/api/clerk/apps', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});

			const data = await res.json();
			if (res.ok) {
				window.location.reload();
			} else {
				addAppError.textContent = data.error || 'Failed to save project.';
				addAppError.classList.remove('hidden');
			}
		} catch (err: any) {
			addAppError.textContent = err.message || 'Network error.';
			addAppError.classList.remove('hidden');
		}
	});
</script>
