---
import LayoutSidebar from '../app/LayoutSidebar.astro';
import { getDb, schema } from '../db/index.js';
import { desc, eq } from 'drizzle-orm';
import { url } from '../lib/data.js';

export const prerender = false;

const db = getDb();
let threads: schema.MessageLog[] = [];
let dbError: string | null = null;

if (db) {
	try {
		threads = await db
			.select()
			.from(schema.messageLogs)
			.orderBy(desc(schema.messageLogs.createdAt))
			.limit(50);
	} catch (e: any) {
		dbError = e.message;
	}
}
---

<LayoutSidebar>
	<div class="px-4 pt-6">
		<!-- Breadcrumbs -->
		<nav class="flex mb-4" aria-label="Breadcrumb">
			<ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
				<li class="inline-flex items-center">
					<a
						href={url()}
						class="inline-flex items-center text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-white"
					>
						<svg
							class="w-5 h-5 mr-2.5"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
							></path></svg
						>
						Home
					</a>
				</li>
				<li>
					<div class="flex items-center">
						<svg
							class="w-6 h-6 text-gray-400"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
								clip-rule="evenodd"></path></svg
						>
						<span class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500" aria-current="page"
							>Inbox</span
						>
					</div>
				</li>
			</ol>
		</nav>

		<div class="mb-6">
			<h1 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
				Instagram Automation Inbox
			</h1>
			<p class="text-sm font-normal text-gray-500 dark:text-gray-400">
				Monitor conversations, incoming inquiries, and automated DM responses.
			</p>
		</div>

		<!-- Threads Container -->
		{
			threads.length === 0 ? (
				<div class="p-12 text-center bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
					<svg
						class="w-16 h-16 mx-auto text-gray-400 dark:text-gray-500 mb-4"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="1.5"
							d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
						></path>
					</svg>
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
						Your automated inbox is clear
					</h3>
					<p class="text-sm text-gray-500 dark:text-gray-400 max-w-md mx-auto mt-1 mb-6">
						Incoming messages and comments matching your active automation rules will be recorded
						here along with their automated replies.
					</p>
					<a
						href={url('automations')}
						class="text-white bg-primary-700 hover:bg-primary-800 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-primary-600 dark:hover:bg-primary-700"
					>
						View Active Rules
					</a>
				</div>
			) : (
				<div class="space-y-4">
					{threads.map((item) => (
						<div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-5">
							<div class="flex items-center justify-between border-b pb-3 mb-3 dark:border-gray-700">
								<div class="flex items-center space-x-3">
									<div class="w-10 h-10 rounded-full bg-gradient-to-tr from-yellow-400 via-pink-500 to-purple-600 flex items-center justify-center text-white font-bold text-xs">
										IG
									</div>
									<div>
										<div class="flex items-center space-x-2">
											<span class="font-semibold text-gray-900 dark:text-white text-sm">
												User {item.senderId.substring(0, 10)}...
											</span>
											<span class="bg-gray-100 text-gray-800 text-xs px-2 py-0.5 rounded dark:bg-gray-700 dark:text-gray-300 font-mono">
												{item.triggerType}
											</span>
										</div>
										<p class="text-xs text-gray-500 dark:text-gray-400">
											Rule: <span class="font-medium text-gray-700 dark:text-gray-300">{item.ruleName || 'Auto-Reply'}</span>
											{item.matchedKeyword && (
												<span> &bull; Keyword: <code>{item.matchedKeyword}</code></span>
											)}
										</p>
									</div>
								</div>
								<div class="text-right">
									{item.status === 'sent' && (
										<span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full dark:bg-green-900 dark:text-green-300">
											Sent
										</span>
									)}
									{item.status === 'failed' && (
										<span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded-full dark:bg-red-900 dark:text-red-300">
											Failed
										</span>
									)}
									{item.status === 'skipped' && (
										<span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded-full dark:bg-yellow-900 dark:text-yellow-300">
											Skipped
										</span>
									)}
									<p class="text-xs text-gray-400 mt-1">
										{new Date(item.createdAt).toLocaleString()}
									</p>
								</div>
							</div>

							<!-- Interaction Bubbles -->
							<div class="space-y-2 text-xs">
								<!-- Incoming -->
								<div class="flex items-start space-x-2">
									<span class="font-medium text-gray-500 dark:text-gray-400 w-16 flex-shrink-0">
										Incoming:
									</span>
									<div class="p-2.5 rounded-lg bg-gray-50 dark:bg-gray-700/60 text-gray-800 dark:text-gray-200 flex-1">
										{item.incomingText || '(No text content)'}
									</div>
								</div>

								<!-- Auto Reply -->
								{item.sentReplyText && (
									<div class="flex items-start space-x-2">
										<span class="font-medium text-primary-600 dark:text-primary-400 w-16 flex-shrink-0">
											Auto-DM:
										</span>
										<div class="p-2.5 rounded-lg bg-blue-50 dark:bg-blue-900/30 text-gray-900 dark:text-gray-100 flex-1 border border-blue-100 dark:border-blue-800">
											<p class="whitespace-pre-wrap">{item.sentReplyText}</p>
											{item.sentReplyUrl && (
												<a
													href={item.sentReplyUrl}
													target="_blank"
													rel="noreferrer"
													class="text-primary-600 hover:underline text-xs mt-1 block truncate font-medium dark:text-primary-400"
												>
													{item.sentReplyUrl}
												</a>
											)}
										</div>
									</div>
								)}

								<!-- Error if failed -->
								{item.errorDetails && (
									<div class="flex items-start space-x-2">
										<span class="font-medium text-red-500 w-16 flex-shrink-0">
											Error:
										</span>
										<div class="p-2 rounded bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400 flex-1 text-xs">
											{item.errorDetails}
										</div>
									</div>
								)}
							</div>
						</div>
					))}
				</div>
			)
		}
	</div>
</LayoutSidebar>
