---
import LayoutSidebar from '../app/LayoutSidebar.astro';

export const prerender = false;
---

<LayoutSidebar>
	<div class="px-2 pt-2">
		<!-- SEO Suite Root Mount Container -->
		<div id="instaflow-seo-suite-root"></div>
	</div>
</LayoutSidebar>

<script>
	import { mountSeoSuite } from '../../seo/index.js';
	import '../../seo/styles/seo-suite.css';

	function initSeoSuite() {
		const container = document.getElementById('instaflow-seo-suite-root');
		if (container && !container.hasChildNodes()) {
			mountSeoSuite(container, {
				proxyUrl: '/api/seo',
				theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
				locale: 'en',
				defaultFeature: 'dashboard'
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initSeoSuite);
	} else {
		initSeoSuite();
	}
	document.addEventListener('astro:page-load', initSeoSuite);
</script>
