---
import LayoutStacked from '../../app/LayoutStacked.astro';
import FormForgotPassword from '../../modules/FormForgotPassword.astro';
import { isAllowedEmail, ALLOWED_ADMIN_EMAIL } from '../../lib/auth.js';

export const prerender = false;

let errorMessage = '';
let successMessage = '';
let emailValue = '';

if (Astro.request.method === 'POST') {
	try {
		const formData = await Astro.request.formData();
		emailValue = ((formData.get('email') as string) || '').trim();

		if (!emailValue) {
			errorMessage = 'Please enter your email address.';
		} else if (!isAllowedEmail(emailValue)) {
			errorMessage = `Access denied. Only ${ALLOWED_ADMIN_EMAIL} is registered on this portal.`;
		} else {
			successMessage = `Password recovery instructions have been sent to ${ALLOWED_ADMIN_EMAIL}.`;
		}
	} catch (err: any) {
		errorMessage = err?.message || 'An error occurred during password reset.';
	}
}
---

<LayoutStacked title="Forgot Password | InstaFlow">
	<div class="min-h-screen align-middle flex items-center justify-center pb-[12vh]">
		<FormForgotPassword
			errorMessage={errorMessage}
			successMessage={successMessage}
			emailValue={emailValue}
		/>
	</div>
</LayoutStacked>
